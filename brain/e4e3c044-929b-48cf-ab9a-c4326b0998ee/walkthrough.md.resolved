    },
  });

  // Bulk selection handlers
  const handleSelectRequest = (id: string) => {
    const newSelected = new Set(selectedRequests);
    if (newSelected.has(id)) {
      newSelected.delete(id);
    } else {
      newSelected.add(id);
    }
    setSelectedRequests(newSelected);
  };

  const handleSelectAll = () => {
    if (
      selectedRequests.size === filteredRequests.length &&
      filteredRequests.length > 0
    ) {
      setSelectedRequests(new Set());
    } else {
      setSelectedRequests(new Set(filteredRequests.map((req) => req.id)));
    }
  };

  // Bulk actions
  const bulkApprove = useMutation({
    mutationFn: async (ids: string[]) => {
      return Promise.all(
        ids.map((id) =>
          api.post(`/leave-requests/${id}/om-approve`, { comments: "" }),
        ),
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
      const count = selectedRequests.size;
      setSelectedRequests(new Set());
      toast({ title: "Success", description: `${count} request(s) approved` });
    },
    onError: (error: unknown) => {
      const err = error as { response?: { data?: { message?: string } } };
      toast({
        variant: "destructive",
        title: "Error",
        description:
          err.response?.data?.message || "Failed to approve requests",
      });
    },
  });

  const bulkReject = useMutation({
    mutationFn: async ({ ids, reason }: { ids: string[]; reason: string }) => {
      return Promise.all(
        ids.map((id) => api.post(`/leave-requests/${id}/reject`, { reason })),
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
      const count = selectedRequests.size;
      setSelectedRequests(new Set());
      toast({ title: "Success", description: `${count} request(s) rejected` });
    },
    onError: (error: unknown) => {
      const err = error as { response?: { data?: { message?: string } } };
      toast({
        variant: "destructive",
        title: "Error",
        description: err.response?.data?.message || "Failed to reject requests",
      });
    },
  });

  // Fetch employees for the employee filter dropdown
  const { data: employeesData } = useQuery({
    queryKey: ["employees"],
    queryFn: async ({ signal }) => {
      const response = await api.get("/employees", { signal });
      return response.data.data.employees || [];
    },
    // Note: query runs for all users — managers need it for employee filtering,
    // all users need it for handover Line Manager / CC dropdowns.
  });

  // Reuse employees query data for Line Manager / CC dropdowns (avoid duplicate API call)
  const allEmployeesData = employeesData;

  interface DeptEmployee {
    id: string;
    department: string;
    position: string;
    user?: { id: string; name: string; role?: string };
    name?: string;
  }

  const departmentColleagues: DeptEmployee[] = (allEmployeesData || []).filter(
    (emp: DeptEmployee) =>
      emp.department?.toUpperCase() ===
        user?.employee?.department?.toUpperCase() && emp.user?.id !== user?.id,
  );

  const handoverOptions: DeptEmployee[] = departmentColleagues;

  const lineManagerOptions = (allEmployeesData || [])
    .filter((emp: DeptEmployee) => {
      const role = emp.user?.role;
      if (!role) return false;

      // For OM and HOD Projects, their line managers are GM or CTO
      if (user?.role === "OPERATIONS_MANAGER" || user?.role === "HOD_PROJECTS") {
        return role === "GENERAL_MANAGER" || role === "CTO";
      }

      // Default: report to OM or HOD Projects
      return (LINE_MANAGER_ROLES as readonly string[]).includes(role);
    })
    .map((emp: DeptEmployee) => ({
      value: emp.user?.name || emp.name || emp.id,
      label: emp.user?.name || emp.name || emp.id,
    }));

  const { data: paginatedData, isLoading } = useQuery({
    queryKey: [
      "leaveRequests",
      currentPage,
      itemsPerPage,
      user?.role,
      statusFilter,
      searchQuery,
      leaveTypeFilter,
      dateFrom,
      dateTo,
      employeeFilter,
    ],
    queryFn: async ({ signal }) => {
      // Determine the correct endpoint based on user role
      let endpoint = "/leave-requests/my-leaves";

      if (
        ["OPERATIONS_MANAGER", "GENERAL_MANAGER", "ADMINISTRATOR"].includes(
          user?.role || "",
        )
      ) {
        endpoint = "/leave-requests";
      } else if (user?.role === "HOD_PROJECTS") {
        endpoint = "/leave-requests/department-leaves";
      }

      const response = await api.get(endpoint, {
        params: {
          page: currentPage,
          limit: itemsPerPage,
          status: statusFilter === "all" ? undefined : statusFilter,
          search: searchQuery || undefined,
          type: leaveTypeFilter === "all" ? undefined : leaveTypeFilter,
          startDate: dateFrom || undefined,
          endDate: dateTo || undefined,
          employeeId: employeeFilter === "all" ? undefined : employeeFilter,
        },
        signal, // Pass signal for automatic cancellation
      });
      return response.data;
    },
    enabled: !!user, // Only run query when user is available
  });

  const requests: LeaveRequest[] = useMemo(
    () =>
      paginatedData?.data?.leaveRequests?.map(
        (req: Record<string, unknown>) => ({
          id: req.id as string,
          requestNumber: req.requestNumber as number,
          employeeId: req.employeeId as string,
          employeeName: (req.employee as { user: { name: string } }).user
            .name as string,
          employeePosition: (req.employee as { position: string })
            .position as string,
          employeeDepartment: (req.employee as { department: string })
            .department as string,
          employeeAvatar: `https://api.dicebear.com/7.x/initials/svg?seed=${(req.employee as { user: { name: string } }).user.name}&backgroundColor=08033F`,
          leaveType: req.leaveType as LeaveType,
          startDate: req.startDate as string,
          endDate: req.endDate as string,
          days: (() => {
            const ws = (req.employee as Record<string, unknown>)?.workSchedule as string || "MON_FRI";
            const start = (req.startDate as string).split("T")[0];
            const end = (req.endDate as string).split("T")[0];
            if (req.isScattered && req.scatteredDates) {
              // scatteredDates may arrive as a JSON string from the API
              let datesArr: string[] = [];
              if (typeof req.scatteredDates === "string") {
                try { datesArr = JSON.parse(req.scatteredDates as string); } catch { datesArr = []; }
              } else {
                datesArr = req.scatteredDates as string[];
              }
              return calculateLeaveDays(start, end, ws, datesArr.map(d => d.split('T')[0]));
            }
            return calculateLeaveDays(start, end, ws);
          })(),
          reason: req.description as string,
          status: req.status as LeaveRequest["status"],
          submittedDate: req.createdAt as string,

          // Scattered leave
          isScattered: (req.isScattered as boolean) || false,
          scatteredDates: (() => {
            if (!req.scatteredDates) return [];
            if (typeof req.scatteredDates === "string") {
              try { return JSON.parse(req.scatteredDates as string) as string[]; } catch { return []; }
            }
            return req.scatteredDates as string[];
          })(),

          // Approval details
          omApprover: req.omApprover as
            | { name: string; email: string }
            | undefined,
          omApprovalDate: req.omApprovalDate as string,
          omApprovalComments: req.omApprovalComments as string,
          gmApprover: req.gmApprover as
            | { name: string; email: string }
            | undefined,
          gmApprovalDate: req.gmApprovalDate as string,
          gmApprovalComments: req.gmApprovalComments as string,
          rejectedBy: req.rejectedBy as string,
          rejectedAt: req.rejectedAt as string,
          leaveBalances: (() => {
            const emp = req.employee as any;
            if (!emp?.leaveBalances) return undefined;
            try {
              return typeof emp.leaveBalances === "string"
                ? JSON.parse(emp.leaveBalances)
                : emp.leaveBalances;
            } catch (e) {
              console.error("Error parsing leave balances:", e);
              return undefined;
            }
          })(),
          rejectionReason: req.rejectionReason as string,

          contactWhileOnLeave: req.contactWhileOnLeave as string,
          handoverLineManager: req.handoverLineManager as string,
          handoverCC: req.handoverCC as string,
          handoverDepartment: req.handoverDepartment as string,
          handoverWorkStatus: req.handoverWorkStatus as string,
          handoverActions: req.handoverActions as string,
          handoverRelationships: req.handoverRelationships as string,
          
          approverSignatureDate: req.approverSignatureDate as string,
        }),
      ) || [],
    [paginatedData],
  );

  const openProcessDialog = (
    request: LeaveRequest,
    action: "approved" | "rejected",
  ) => {
    setProcessingRequest(request);
    setProcessAction(action);
    setRejectionReason("");
    setIsProcessDialogOpen(true);
  };

  const handleProcessRequest = (e: React.FormEvent) => {
    e.preventDefault();
    if (!processingRequest) return;

    if (processAction === "rejected") {
      reject.mutate({
        id: processingRequest.id,
        reason: rejectionReason,
      });
      setIsProcessDialogOpen(false);
      setProcessingRequest(null);
      setRejectionReason("");
    } else if (processAction === "approved") {
      // Determine which mutation to call based on user role and request status
      const role = user?.role;
      const status = processingRequest.status;

      if (status === "PENDING_HOD_PROJECTS" && role === "HOD_PROJECTS") {
        hodApprove.mutate(processingRequest.id);
      } else if (status === "PENDING_OM" && role === "OPERATIONS_MANAGER") {
        omApprove.mutate(processingRequest.id);
      } else if (status === "PENDING_GM" && (role === "GENERAL_MANAGER" || (role === "CTO" && gmStatus?.isAway))) {
        gmApprove.mutate(processingRequest.id);
      } else if (status === "PENDING_ADMIN" && role === "ADMINISTRATOR") {
        adminApprove.mutate(processingRequest.id);
      }

      setIsProcessDialogOpen(false);
      setProcessingRequest(null);
      setRejectionReason("");
    }
  };

  const imageToDataUrl = async (src?: string): Promise<string | undefined> => {
    if (!src) return undefined;
    if (src.startsWith('data:')) return src;

    try {
      const response = await fetch(src);
      if (!response.ok) return undefined;
      const blob = await response.blob();
      return await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => {
          if (typeof reader.result === 'string') resolve(reader.result);
          else reject(new Error('Could not convert image to data URL'));
        };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    } catch (error) {
      console.warn('Failed to load signature image from URL:', src, error);
      return undefined;
    }
  };

  const handleDownloadPDF = async () => {
    if (!selectedRequest) return;

    console.log('[DEBUG] handleDownloadPDF called', { requestId: selectedRequest.id });

    try {
      // Fetch role signatures if available, but continue even if the endpoint is unavailable
      const roleSignatures: { [key: string]: string } = {};
      try {
        const roleSignaturesResponse = await api.get("/role-signatures");
        roleSignaturesResponse.data.data.signatures.forEach((sig: { role: string; signature: string }) => {
          roleSignatures[sig.role] = sig.signature;
        });
      } catch (signatureError) {
        console.warn("Unable to load role signatures for PDF generation:", signatureError);
      }

      const defaultRoleSignatures = {
        OPERATIONS_MANAGER: "/joram_OMsignature.png",
        HOD_PROJECTS: "/joshua_HODProjectssignature.png",
        GENERAL_MANAGER: "/willis_GMsignature.png",
        ADMINISTRATOR: undefined, // Always blank in PDF for manual CEO signature
      };

      const operationsSignature = await imageToDataUrl(
        roleSignatures.OPERATIONS_MANAGER || defaultRoleSignatures.OPERATIONS_MANAGER,
      );
      const hodSignature = await imageToDataUrl(
        roleSignatures.HOD_PROJECTS || defaultRoleSignatures.HOD_PROJECTS,
      );
      const gmSignature = await imageToDataUrl(
        roleSignatures.GENERAL_MANAGER || defaultRoleSignatures.GENERAL_MANAGER,
      );
      const adminSignature = await imageToDataUrl(
        roleSignatures.ADMINISTRATOR || defaultRoleSignatures.ADMINISTRATOR,
      );

      const filename = generateLeaveRequestPdf({
        id: selectedRequest.id,
        employeeName: selectedRequest.employeeName,
        employeePosition: selectedRequest.employeePosition,
        employeeDepartment: selectedRequest.employeeDepartment,
        leaveType: selectedRequest.leaveType,
        startDate: selectedRequest.startDate,
        endDate: selectedRequest.endDate,
        days: selectedRequest.days,
        reason: selectedRequest.reason,
        submittedDate: selectedRequest.submittedDate,
        status: selectedRequest.status,
        isScattered: selectedRequest.isScattered,
        scatteredDates: selectedRequest.scatteredDates,
        contactWhileOnLeave: selectedRequest.contactWhileOnLeave,
        handoverLineManager: selectedRequest.handoverLineManager,
        handoverCC: selectedRequest.handoverCC,
        handoverDepartment: selectedRequest.handoverDepartment,
        handoverWorkStatus: selectedRequest.handoverWorkStatus,
        handoverActions: selectedRequest.handoverActions,
        handoverRelationships: selectedRequest.handoverRelationships,
        omApprover: selectedRequest.omApprover,
        omApprovalDate: selectedRequest.omApprovalDate,
        gmApprover: selectedRequest.gmApprover,
        gmApprovalDate: selectedRequest.gmApprovalDate,
        rejectionReason: selectedRequest.rejectionReason,
        approverName: selectedRequest.approverName,
        approverSignatureDate: selectedRequest.approverSignatureDate,
        leaveBalances: selectedRequest.leaveBalances,
        roleSignatures: {
          OPERATIONS_MANAGER: operationsSignature,
          HOD_PROJECTS: hodSignature,
          GENERAL_MANAGER: gmSignature,
          ADMINISTRATOR: adminSignature,
        },
      });

      toast({
        title: "Success",
        description: `Corporate PDF generated: ${filename} ✓`,
      });
    } catch (error) {
      console.error("PDF generation error:", error);
      toast({
        variant: "destructive",
        title: "Error",
        description: "Failed to generate PDF",
      });
    }
  };

  // CSV Export Functions
  const formatDate = (dateString: string) => {
    return new Date(dateString).toLocaleDateString("en-CA"); // YYYY-MM-DD format
  };

  const formatStatus = (status: string) => {
    const statusMap: Record<string, string> = {
      PENDING_OM: "Pending OM Approval",
      PENDING_GM: "Pending General Manager Approval",
      APPROVED: "Approved",
      REJECTED_OM: "Rejected by OM",
      REJECTED_GM: "Rejected by General Manager",
    };
    return statusMap[status] || status;
  };

  const escapeCSV = (value: string | undefined | null): string => {
    if (value === undefined || value === null) return "";
    const str = String(value);
    // If the value contains comma, newline, or double quote, wrap in quotes and escape quotes
    if (str.includes(",") || str.includes("\n") || str.includes('"')) {
      return `"${str.replace(/"/g, '""')}"`;
    }
    return str;
  };

  const generateCSV = (requestsToExport: LeaveRequest[]): string => {
    const headers = [
      "Employee Name",
      "Position",
      "Leave Type",
      "Start Date",
      "End Date",
      "Is Scattered",
      "Scattered Dates",
      "Days",
      "Status",
      "Submitted Date",
      "OM Approval Date",
      "GM Approval Date",
      "Rejection Reason",
      "Reason/Description",
    ];

    const rows = requestsToExport.map((req) => [
      escapeCSV(req.employeeName),
      escapeCSV(req.employeePosition),
      escapeCSV(req.leaveType),
      formatDate(req.startDate),
      formatDate(req.endDate),
      req.isScattered ? "Yes" : "No",
      req.isScattered && req.scatteredDates
        ? escapeCSV(req.scatteredDates.join(", "))
        : "",
      String(req.days),
      formatStatus(req.status),
      formatDate(req.submittedDate),
      req.omApprovalDate ? formatDate(req.omApprovalDate) : "",
      req.gmApprovalDate ? formatDate(req.gmApprovalDate) : "",
      escapeCSV(req.rejectionReason),
      escapeCSV(req.reason),
    ]);

    return [headers.join(","), ...rows.map((row) => row.join(","))].join("\n");
  };

  const downloadCSV = (csvContent: string, filename: string) => {
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    const url = URL.createObjectURL(blob);
    link.setAttribute("href", url);
    link.setAttribute("download", filename);
    link.style.visibility = "hidden";
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  };

  const handleExportAll = () => {
    if (filteredRequests.length === 0) {
      toast({
        variant: "destructive",
        title: "No Data",
        description: "No leave requests to export",
      });
      return;
    }
    const csv = generateCSV(filteredRequests);
    const timestamp = new Date().toISOString().split("T")[0];
    downloadCSV(csv, `leave-requests-${timestamp}.csv`);
    toast({
      title: "Success",
      description: `Exported ${filteredRequests.length} leave request(s)`,
    });
  };

  const handleExportSelected = () => {
    const selectedList = filteredRequests.filter((req) =>
      selectedRequests.has(req.id),
    );
    if (selectedList.length === 0) {
      toast({
        variant: "destructive",
        title: "No Selection",
        description: "No requests selected for export",
      });
      return;
    }
    const csv = generateCSV(selectedList);
    const timestamp = new Date().toISOString().split("T")[0];
    downloadCSV(csv, `leave-requests-selected-${timestamp}.csv`);
    toast({
      title: "Success",
      description: `Exported ${selectedList.length} selected request(s)`,
    });
  };
  // Using requests directly as filtering is now done on the server
  const filteredRequests = requests;

  return (
    <DashboardLayout>
      <div className="space-y-6">
        <div className="flex flex-col gap-4">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h1 className="text-2xl sm:text-3xl font-bold">Leave Requests</h1>
              <p className="text-muted-foreground text-sm sm:text-base">
                Manage employee leave applications
              </p>
            </div>
            <div className="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
              <Button
                onClick={() => setIsReservationModalOpen(true)}
                className="gradient-primary w-full sm:w-auto"
              >
                <CalendarRange className="mr-2 h-4 w-4" /> Reserve Dates
              </Button>
              <Button
                onClick={() => {
                  setEditingRequest(null);
                  setStartDate("");
                  setEndDate("");
                  setDescription("");
                  setContactWhileOnLeave("");
                  setHandoverLineManager("");
                  setHandoverCC("");
                  setHandoverDepartment(user?.employee?.department || "");
                  setHandoverWorkStatus("");
                  setHandoverActions("");
                  setHandoverRelationships("");
                  setEmployeeSignature("");
                  setIsNewRequestOpen(true);
                }}
                className="gradient-primary w-full sm:w-auto"
              >
                <Plus className="mr-2 h-4 w-4" /> New Request
              </Button>
            </div>
          </div>
          <div className="flex flex-wrap items-center gap-2 sm:gap-3">
            <Filter className="h-5 w-5 text-muted-foreground hidden sm:block" />
            <Select value={statusFilter} onValueChange={setStatusFilter}>
              <SelectTrigger className="w-full sm:w-40 glass border-border/50">
                <SelectValue placeholder="Filter by status" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All Requests</SelectItem>
                <SelectItem value="PENDING_HOD_PROJECTS">Pending HOD</SelectItem>
                <SelectItem value="PENDING_OM">Pending OM</SelectItem>
                <SelectItem value="PENDING_GM">Pending GM</SelectItem>
                <SelectItem value="APPROVED">Approved</SelectItem>
                <SelectItem value="REJECTED_HOD">Rejected (HOD)</SelectItem>
                <SelectItem value="REJECTED_OM">Rejected (OM)</SelectItem>
                <SelectItem value="REJECTED_GM">Rejected (GM)</SelectItem>
              </SelectContent>
            </Select>
            {user?.role !== "EMPLOYEE" && (
              <Button
                onClick={handleExportAll}
                variant="outline"
                className="gap-2 border-border/50 w-full sm:w-auto"
              >
                <FileSpreadsheet className="h-4 w-4" />
                Export All
              </Button>
            )}
          </div>
        </div>

        {/* Year Leave Summary for Employees */}
        {user?.role === "EMPLOYEE" && (
          <motion.div
            initial={{ y: 20, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
          >
            <Card className="glass border-border/50 p-6">
              <h3 className="text-lg font-semibold mb-4">
                My Leave Summary - {new Date().getFullYear()}
              </h3>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {(() => {
                  const currentYear = new Date().getFullYear();
                  const yearLeaves = requests.filter((req: LeaveRequest) => {
                    const startYear = new Date(req.startDate).getFullYear();
                    return (
                      startYear === currentYear &&
                      (req.status === "APPROVED" ||
                        req.status === "PENDING_GM" ||
                        req.status === "PENDING_OM")
                    );
                  });

                  // Group by leave type
                  const leaveByType = yearLeaves.reduce(
                    (
                      acc: Record<
                        string,
                        {
                          count: number;
                          days: number;
                          requests: LeaveRequest[];
                        }
                      >,
                      req: LeaveRequest,
                    ) => {
                      if (!acc[req.leaveType]) {
                        acc[req.leaveType] = {
                          count: 0,
                          days: 0,
                          requests: [],
                        };
                      }
                      acc[req.leaveType].count += 1;
                      acc[req.leaveType].days += req.days;
                      acc[req.leaveType].requests.push(req);
                      return acc;
                    },
                    {},
                  );

                  const totalDays: number = Object.values(leaveByType).reduce(
                    (sum: number, type) => sum + type.days,
                    0,
                  );

                  return (
                    <>
                      <div className="p-4 rounded-xl bg-primary/5 border border-primary/20">
                        <p className="text-sm text-muted-foreground mb-1">
                          Total Leaves Taken
                        </p>
                        <p className="text-3xl font-bold text-primary">
                          {totalDays}
                        </p>
                        <p className="text-xs text-muted-foreground mt-1">
                          days this year
                        </p>
                      </div>

                      {Object.entries(leaveByType).map(([type, data]) => (
                        <div
                          key={type}
                          className="p-4 rounded-xl bg-background/50 border border-border/50"
                        >
                          <p className="text-sm text-muted-foreground mb-1 capitalize">
                            {type.toLowerCase().replace("_", " ")}
                          </p>
                          <p className="text-2xl font-bold">{data.days}</p>
                          <p className="text-xs text-muted-foreground mt-1">
                            {data.count} request{data.count === 1 ? "" : "s"}
                          </p>
                        </div>
                      ))}

                      {Object.keys(leaveByType).length === 0 && (
                        <div className="col-span-full text-center py-8 text-muted-foreground">
                          <p>No leaves taken in {currentYear} yet</p>
                        </div>
                      )}
                    </>
                  );
                })()}
              </div>
            </Card>
          </motion.div>
        )}

        {/* Advanced Filters Card */}
        <motion.div
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
        >
          <Card className="glass border-border/50 p-4">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
              <div className="relative">
                <Input
                  placeholder="Search by employee name..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="pl-3"
                />
              </div>

              <Select
                value={leaveTypeFilter}
                onValueChange={setLeaveTypeFilter}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Leave Type" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">All Types</SelectItem>
                  <SelectItem value="ANNUAL">Annual Leave</SelectItem>
                  <SelectItem value="SICK">Sick Leave</SelectItem>
                  <SelectItem value="MATERNITY">Maternity Leave</SelectItem>
                  <SelectItem value="PATERNITY">Paternity Leave</SelectItem>
                </SelectContent>
              </Select>

              <div className="space-y-1">
                <Label className="text-xs text-muted-foreground">
                  From Date
                </Label>
                <Input
                  type="date"
                  value={dateFrom}
                  onChange={(e) => setDateFrom(e.target.value)}
                />
              </div>

              <div className="space-y-1">
                <Label className="text-xs text-muted-foreground">To Date</Label>
                <Input
                  type="date"
                  value={dateTo}
                  onChange={(e) => setDateTo(e.target.value)}
                />
              </div>

              {user?.role !== "EMPLOYEE" && employeesData && (
                <Select
                  value={employeeFilter}
                  onValueChange={setEmployeeFilter}
                >
                  <SelectTrigger>
                    <SelectValue placeholder="All Employees" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">All Employees</SelectItem>
                    {employeesData.map(
                      (emp: {
                        id: string;
                        user?: { name: string };
                        name?: string;
                      }) => (
                        <SelectItem key={emp.id} value={emp.id}>
                          {emp.user?.name || emp.name}
                        </SelectItem>
                      ),
                    )}
                  </SelectContent>
                </Select>
              )}

              <Button
                variant="outline"
                onClick={() => {
                  setSearchQuery("");
                  setLeaveTypeFilter("all");
                  setDateFrom("");
                  setDateTo("");
                  setStatusFilter("all");
                  setEmployeeFilter("all");
                }}
                className="h-full"
              >
                Clear Filters
              </Button>
            </div>

            {/* Active Filters Display */}
            {(searchQuery ||
              leaveTypeFilter !== "all" ||
              dateFrom ||
              dateTo ||
              statusFilter !== "all" ||
              employeeFilter !== "all") && (
              <div className="mt-3 flex flex-wrap gap-2">
                <span className="text-xs text-muted-foreground">
                  Active filters:
                </span>
                {statusFilter !== "all" && (
                  <Badge variant="secondary" className="text-xs">
                    Status: {statusFilter}
                  </Badge>
                )}
                {searchQuery && (
                  <Badge variant="secondary" className="text-xs">
                    Search: {searchQuery}
                  </Badge>
                )}
                {leaveTypeFilter !== "all" && (
                  <Badge variant="secondary" className="text-xs">
                    Type: {leaveTypeFilter}
                  </Badge>
                )}
                {employeeFilter !== "all" && (
                  <Badge variant="secondary" className="text-xs">
                    Employee:{" "}
                    {employeesData?.find(
                      (e: { id: string; user?: { name: string } }) =>
                        e.id === employeeFilter,
                    )?.user?.name || "Selected"}
                  </Badge>
                )}
                {dateFrom && (
                  <Badge variant="secondary" className="text-xs">
                    From: {new Date(dateFrom).toLocaleDateString()}
                  </Badge>
                )}
                {dateTo && (
                  <Badge variant="secondary" className="text-xs">
                    To: {new Date(dateTo).toLocaleDateString()}
                  </Badge>
                )}
              </div>
            )}
          </Card>
        </motion.div>

        {/* Bulk Actions Toolbar */}
        {selectedRequests.size > 0 && (
          <motion.div
            initial={{ y: -20, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
          >
            <Card className="glass border-border/50 p-4 bg-primary/5">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-4">
                  <span className="text-sm font-medium">
                    {selectedRequests.size} request(s) selected
                  </span>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => setSelectedRequests(new Set())}
                  >
                    Clear Selection
                  </Button>
                </div>
                <div className="flex items-center gap-2">
                  {user?.role === "OPERATIONS_MANAGER" && (
                    <Button
                      size="sm"
                      className="gradient-primary text-white"
                      onClick={() =>
                        bulkApprove.mutate(Array.from(selectedRequests))
                      }
                      disabled={bulkApprove.isPending || bulkReject.isPending}
                    >
                      <CheckCircle className="h-4 w-4 mr-1" />
                      {bulkApprove.isPending
                        ? "Approving..."
                        : "Approve Selected"}
                    </Button>
                  )}
                  {(user?.role === "OPERATIONS_MANAGER" ||
                    user?.role === "GENERAL_MANAGER") && (
                    <Button
                      size="sm"
                      variant="destructive"
                      onClick={() => setIsBulkRejectOpen(true)}
                      disabled={bulkApprove.isPending || bulkReject.isPending}
                    >
                      <XCircle className="h-4 w-4 mr-1" />
                      {bulkReject.isPending
                        ? "Rejecting..."
                        : "Reject Selected"}
                    </Button>
                  )}
                  <Button
                    size="sm"
                    variant="outline"
                    onClick={handleExportSelected}
                    className="gap-1 border-border/50"
                  >
                    <FileSpreadsheet className="h-4 w-4" />
                    Export Selected
                  </Button>
                </div>
              </div>
            </Card>
          </motion.div>
        )}

        <motion.div
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
        >
          <Card className="glass border-border/50 overflow-hidden">
            {/* Desktop Table View */}
            <div className="hidden md:block overflow-x-auto">
              <table className="w-full">
                <thead className="bg-muted/30 border-b border-border/50">
                  <tr>
                    <th className="text-left p-4 font-semibold w-12">
                      <input
                        type="checkbox"
                        checked={
                          selectedRequests.size === filteredRequests.length &&
                          filteredRequests.length > 0
                        }
                        onChange={handleSelectAll}
                        className="w-4 h-4 rounded border-border"
                      />
                    </th>
                    <th className="text-left p-4 font-semibold">Employee</th>
                    <th className="text-left p-4 font-semibold">Type</th>
                    <th className="text-left p-4 font-semibold">Duration</th>
                    <th className="text-left p-4 font-semibold">Days</th>
                    <th className="text-left p-4 font-semibold">Status</th>
                    <th className="text-left p-4 font-semibold">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {isLoading ? (
                    Array.from({ length: 5 }).map((_, i) => (
                      <motion.tr
                        key={i}
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 1 }}
                        className="border-b border-border/10 h-24"
                      >
                        <td className="p-4" colSpan={7}>
                          <div className="flex items-center gap-4 animate-pulse">
                            <div className="w-12 h-12 rounded-2xl bg-muted/40" />
                            <div className="space-y-2">
                              <div className="h-4 w-32 bg-muted/40 rounded" />
                              <div className="h-3 w-24 bg-muted/40 rounded" />
                            </div>
                          </div>
                        </td>
                      </motion.tr>
                    ))
                  ) : (
                    filteredRequests.map((request: LeaveRequest, index: number) => (
                      <motion.tr
                        key={request.id}
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 1 }}
                        transition={{ delay: index * 0.05 }}
                        className="border-b border-border/30 hover:bg-accent/30 transition-colors group cursor-pointer"
                      >
                        <td className="p-4">
                          <input
                            type="checkbox"
                            checked={selectedRequests.has(request.id)}
                            onChange={() => handleSelectRequest(request.id)}
                            className="w-4 h-4 rounded border-border"
                            onClick={(e) => e.stopPropagation()}
                          />
                        </td>
                        <td className="p-4">
                          <div className="flex items-center gap-3">
                            <Avatar className="w-10 h-10 border border-primary/10">
                              <AvatarImage
                                src={request.employeeAvatar}
                                alt={request.employeeName}
                              />
                              <AvatarFallback className="bg-[#111111] text-white font-bold text-xs uppercase">
                                {getInitials(request.employeeName)}
                              </AvatarFallback>
                            </Avatar>
                            <div>
                              <p className="font-medium">
                                {request.employeeName}
                              </p>
                              <p className="text-xs text-muted-foreground">
                                {request.employeePosition}
                              </p>
                            </div>
                          </div>
                        </td>
                        <td className="p-4">
                          <Badge variant="outline" className="capitalize">
                            {request.leaveType}
                          </Badge>
                        </td>
                        <td className="p-4">
                          <p className="text-sm">
                            {new Date(request.startDate).toLocaleDateString()}
                          </p>
                          <p className="text-xs text-muted-foreground">
                            to {new Date(request.endDate).toLocaleDateString()}
                          </p>
                        </td>
                        <td className="p-4">
                          <span className="font-medium">
                            {request.days} days
                          </span>
                          {request.isScattered && (
                            <span className="ml-1 text-xs text-primary font-normal">
                              (Scattered)
                            </span>
                          )}
                        </td>
                        <td className="p-4">
                          <StatusBadge status={request.status} />
                        </td>
                        <td className="p-4">
                          <div className="flex items-center gap-2">
                            <Button
                              size="sm"
                              variant="outline"
                              className="h-9 px-3 border-border/50 hover:bg-accent/50 transition-all duration-200"
                              onClick={() => setSelectedRequest(request)}
                            >
                              <Eye className="h-4 w-4 mr-1" />
                              <span className="text-xs">View</span>
                            </Button>

                            {request.status === "PENDING_HOD_PROJECTS" &&
                              user?.role === "HOD_PROJECTS" && (
                                <button
                                  className="h-9 px-3 rounded-md bg-green-600 hover:bg-green-700 text-white shadow-md transition-all duration-200 flex items-center gap-1"
                                  onClick={() => hodApprove.mutate(request.id)}
                                  disabled={
                                    hodApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4" />
                                  <span className="text-xs font-medium">
                                    {hodApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}
                                  </span>

                                </button>
                              )}

                            {request.status === "PENDING_OM" &&
                              user?.id === request.employeeId && (
                                <Button
                                  size="sm"
                                  variant="outline"
                                  className="h-9 px-3 border-border/50 hover:bg-accent/50 transition-all duration-200"
                                  onClick={() => handleEditClick(request)}
                                >
                                  <span className="text-xs">Edit</span>
                                </Button>
                              )}

                            {request.status === "PENDING_OM" &&
                              user?.role === "OPERATIONS_MANAGER" && (
                                <Button
                                  size="sm"
                                  className="h-9 px-3 gradient-success text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                  onClick={() => omApprove.mutate(request.id)}
                                  disabled={
                                    omApprove.isPending ||
                                    gmApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4 mr-1" />
                                  <span className="text-xs font-medium">
                                    {omApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}

                                  </span>
                                </Button>
                              )}

                            {request.status === "PENDING_GM" &&
                              user?.role === "GENERAL_MANAGER" && (
                                <Button
                                  size="sm"
                                  className="h-9 px-3 gradient-success text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                  onClick={() => gmApprove.mutate(request.id)}
                                  disabled={
                                    omApprove.isPending ||
                                    gmApprove.isPending ||
                                    adminApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4 mr-1" />
                                  <span className="text-xs font-medium">
                                    {gmApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}
                                  </span>

                                </Button>
                              )}

                            {request.status === "PENDING_ADMIN" &&
                              (user?.role === "ADMINISTRATOR" ||
                                user?.role === "ADMINISTRATOR") && (
                                <Button
                                  size="sm"
                                  className="h-9 px-3 gradient-success text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                  onClick={() => adminApprove.mutate(request.id)}
                                  disabled={
                                    omApprove.isPending ||
                                    gmApprove.isPending ||
                                    adminApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4 mr-1" />
                                  <span className="text-xs font-medium">
                                    {adminApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}
                                  </span>

                                </Button>
                              )}

                            {((request.status === "PENDING_HOD_PROJECTS" &&
                              user?.role === "HOD_PROJECTS") ||
                              (request.status === "PENDING_OM" &&
                              user?.role === "OPERATIONS_MANAGER") ||
                              (request.status === "PENDING_GM" &&
                                user?.role === "GENERAL_MANAGER") ||
                              (request.status === "PENDING_ADMIN" &&
                                (user?.role === "ADMINISTRATOR" ||
                                  user?.role === "ADMINISTRATOR"))) && (
                              <Button
                                size="sm"
                                className="h-9 px-3 gradient-destructive text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                onClick={() =>
                                  openProcessDialog(request, "rejected")
                                }
                                disabled={
                                  omApprove.isPending ||
                                  gmApprove.isPending ||
                                  adminApprove.isPending ||
                                  reject.isPending
                                }
                              >
                                <XCircle className="h-4 w-4 mr-1" />
                                <span className="text-xs font-medium">
                                  {reject.isPending ? "Rejecting..." : "Reject"}
                                </span>
                              </Button>
                            )}
                          </div>
                        </td>
                      </motion.tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>

            {/* Mobile Card View */}
            <div className="md:hidden divide-y divide-border/30">
              {isLoading ? (
                Array.from({ length: 4 }).map((_, i) => (
                  <div key={i} className="p-4 space-y-4 animate-pulse">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-full bg-muted/40" />
                      <div className="space-y-2 flex-1">
                        <div className="h-4 w-1/2 bg-muted/40 rounded" />
                        <div className="h-3 w-1/3 bg-muted/40 rounded" />
                      </div>
                      <div className="w-16 h-6 rounded-full bg-muted/40" />
                    </div>
                    <div className="grid grid-cols-2 gap-4">
                      <div className="h-10 bg-muted/40 rounded-xl" />
                      <div className="h-10 bg-muted/40 rounded-xl" />
                    </div>
                  </div>
                ))
              ) : filteredRequests.length === 0 ? (
                <div className="p-12 text-center text-muted-foreground">
                  <p className="text-sm font-medium">No requests found</p>
                </div>
              ) : (
                filteredRequests.map((request: LeaveRequest, index: number) => (
                <motion.div
                  key={request.id}
                  initial={{ opacity: 0, x: -10 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: index * 0.05 }}
                  className="p-4 space-y-4 hover:bg-accent/10 transition-colors"
                >
                  <div className="flex items-start justify-between">
                    <div className="flex items-center gap-3">
                      <input
                        type="checkbox"
                        checked={selectedRequests.has(request.id)}
                        onChange={() => handleSelectRequest(request.id)}
                        className="w-4 h-4 rounded border-border"
                      />
                      <Avatar className="w-10 h-10 border border-primary/10">
                        <AvatarImage
                          src={request.employeeAvatar}
                          alt={request.employeeName}
                        />
                        <AvatarFallback className="bg-[#111111] text-white font-bold text-xs uppercase">
                          {getInitials(request.employeeName)}
                        </AvatarFallback>
                      </Avatar>
                      <div>
                        <p className="font-bold text-sm">{request.employeeName}</p>
                        <p className="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                          {request.employeePosition}
                        </p>
                      </div>
                    </div>
                    <StatusBadge status={request.status} />
                  </div>

                  <div className="grid grid-cols-2 gap-4 py-2">
                    <div className="space-y-1">
                      <p className="text-[10px] text-muted-foreground uppercase font-black tracking-widest">
                        Leave Type
                      </p>
                      <Badge
                        variant="outline"
                        className="capitalize text-[11px] font-bold border-primary/20 bg-primary/5"
                      >
                        {request.leaveType?.replace("_", " ")}
                      </Badge>
                    </div>
                    <div className="space-y-1">
                      <p className="text-[10px] text-muted-foreground uppercase font-black tracking-widest">
                        Duration
                      </p>
                      <p className="text-xs font-bold">
                        {request.days} Days{" "}
                        {request.isScattered && (
                          <span className="text-primary font-black">(S)</span>
                        )}
                      </p>
                    </div>
                    <div className="col-span-2 space-y-1">
                      <p className="text-[10px] text-muted-foreground uppercase font-black tracking-widest">
                        Timeline
                      </p>
                      <div className="flex items-center gap-2 text-xs font-bold">
                        <span>{new Date(request.startDate).toLocaleDateString()}</span>
                        <span className="text-muted-foreground">→</span>
                        <span>{new Date(request.endDate).toLocaleDateString()}</span>
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center gap-2 pt-2 overflow-x-auto pb-1 scrollbar-none">
                    <Button
                      size="sm"
                      variant="outline"
                      className="h-9 px-3 border-border/50 bg-background shadow-sm shrink-0"
                      onClick={() => setSelectedRequest(request)}
                    >
                      <Eye className="h-4 w-4 mr-1.5" />
                      View
                    </Button>

                    {request.status === "PENDING_HOD_PROJECTS" && user?.role === "HOD_PROJECTS" && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={hodApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        Approve
                      </Button>
                    )}

                    {request.status === "PENDING_OM" && user?.role === "OPERATIONS_MANAGER" && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={omApprove.isPending || gmApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        Approve
                      </Button>
                    )}

                    {request.status === "PENDING_GM" && 
                      (user?.role === "GENERAL_MANAGER" || (user?.role === "CTO" && gmStatus?.isAway)) && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={omApprove.isPending || gmApprove.isPending || adminApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        {user?.role === "CTO" ? "Endorse (for GM)" : "Approve"}
                      </Button>
                    )}

                    {request.status === "PENDING_ADMIN" && (user?.role === "ADMINISTRATOR" || user?.role === "ADMINISTRATOR") && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={omApprove.isPending || gmApprove.isPending || adminApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        Approve
                      </Button>
                    )}

                    {((request.status === "PENDING_OM" && user?.role === "OPERATIONS_MANAGER") ||
                      (request.status === "PENDING_GM" && (user?.role === "GENERAL_MANAGER" || (user?.role === "CTO" && gmStatus?.isAway))) ||
                      (request.status === "PENDING_ADMIN" && (user?.role === "ADMINISTRATOR" || user?.role === "ADMINISTRATOR"))) && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-destructive text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "rejected")}
                        disabled={omApprove.isPending || gmApprove.isPending || adminApprove.isPending || reject.isPending}
                      >
                        <XCircle className="h-4 w-4 mr-1.5" />
                        Reject
                      </Button>
                    )}
                  </div>
                </motion.div>
              )))}

              {filteredRequests.length === 0 && (
                <div className="p-12 text-center text-muted-foreground">
                  <p className="text-sm font-medium">No requests found</p>
                </div>
              )}
            </div>
          </Card>

          {/* Pagination Controls */}
          {paginatedData && paginatedData.totalPages > 1 && (
            <div className="flex items-center justify-between mt-6">
              <div className="flex items-center gap-4">
                <p className="text-sm text-muted-foreground">
                  Showing{" "}
                  <span className="font-medium">
                    {(currentPage - 1) * itemsPerPage + 1}
                  </span>{" "}
                  to{" "}
                  <span className="font-medium">
                    {Math.min(currentPage * itemsPerPage, paginatedData.total)}
                  </span>{" "}
                  of <span className="font-medium">{paginatedData.total}</span>{" "}
                  requests
                </p>
                <Select
                  value={itemsPerPage.toString()}
                  onValueChange={(value) => {
                    setItemsPerPage(Number(value));
                    setCurrentPage(1);
                  }}
                >
                  <SelectTrigger className="w-32">
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="10">10 per page</SelectItem>
                    <SelectItem value="20">20 per page</SelectItem>
                    <SelectItem value="50">50 per page</SelectItem>
                    <SelectItem value="100">100 per page</SelectItem>
                  </SelectContent>
                </Select>
              </div>

              <div className="flex items-center gap-2">
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() =>
                    setCurrentPage((prev) => Math.max(1, prev - 1))
                  }
                  disabled={!paginatedData.hasPrevPage || isLoading}
                >
                  Previous
                </Button>
                <div className="flex items-center gap-1">
                  {Array.from(
                    { length: Math.min(5, paginatedData.totalPages) },
                    (_, i) => {
                      let pageNum;
                      if (paginatedData.totalPages <= 5) {
                        pageNum = i + 1;
                      } else if (currentPage <= 3) {
                        pageNum = i + 1;
                      } else if (currentPage >= paginatedData.totalPages - 2) {
                        pageNum = paginatedData.totalPages - 4 + i;
                      } else {
                        pageNum = currentPage - 2 + i;
                      }
                      return (
                        <Button
                          key={pageNum}
                          variant={
                            currentPage === pageNum ? "default" : "outline"
                          }
                          size="sm"
                          onClick={() => setCurrentPage(pageNum)}
                          className="w-10"
                        >
                          {pageNum}
                        </Button>
                      );
                    },
                  )}
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() =>
                    setCurrentPage((prev) =>
                      Math.min(paginatedData.totalPages, prev + 1),
                    )
                  }
                  disabled={!paginatedData.hasNextPage || isLoading}
                >
                  Next
                </Button>
              </div>
            </div>
          )}
        </motion.div>
      </div>

      {/* View Details Dialog */}
      <Dialog
        open={!!selectedRequest}
        onOpenChange={() => setSelectedRequest(null)}
      >
        <DialogContent className="glass border-border/50 max-h-[85vh] overflow-y-auto max-w-3xl">
          <DialogHeader className="flex flex-row items-center justify-between">
            <div>
              <DialogTitle>Leave Request Details</DialogTitle>
              <DialogDescription>
                Request ID: {selectedRequest?.id}
              </DialogDescription>
            </div>
            {selectedRequest && (
              <Button
                onClick={handleDownloadPDF}
                variant="outline"
                size="sm"
                className="gap-2"
              >
                <Download className="h-4 w-4" />
                Download PDF
              </Button>
            )}
          </DialogHeader>
          {selectedRequest && (
            <div
              ref={detailsRef}
              style={{
                backgroundColor: "#FFFFFF",
                fontFamily: '"Times New Roman", Times, serif',
                color: "#1a1a2e",
                width: "100%",
                padding: "0",
              }}
            >
              {/* ═══ HEADER ═══ */}
              <div
                style={{
                  padding: "32px 32px 16px 32px",
                  background: "#ffffff",
                  borderBottom: "3px solid #000000",
                  textAlign: "center"
                }}
              >
                {/* ═══ QUADRANT HEADER (Monochrome) ═══ */}
                <div style={{ display: "flex", flexDirection: "column", gap: "12px" }}>
                  {/* Top Quadrant: Logo & Title/Ref */}
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                    <div style={{ textAlign: "left" }}>
                      <img
                        src="/company-logo.jpg"
                        alt="Logo"
                        loading="lazy"
                        style={{ height: "32px", width: "auto" }}
                      />
                    </div>
                    <div style={{ textAlign: "right" }}>
                      <p style={{ color: "#000", fontSize: "22px", fontWeight: "900", margin: 0, textTransform: "uppercase", letterSpacing: "0.5px" }}>
                        LEAVE APPLICATION FORM
                      </p>
                      <p style={{ color: "#666", fontSize: "11px", fontWeight: "500", margin: "2px 0 0 0" }}>
                        {`No: ADC-LVE-${new Date(selectedRequest.submittedDate).toISOString().substring(0,7).replace('-', '')}-A${selectedRequest.requestNumber ? String(selectedRequest.requestNumber).padStart(2, '0') : '01'} | Date: ${new Date(selectedRequest.submittedDate).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}`}
                      </p>
                    </div>
                  </div>

                  {/* Bottom Quadrant: Company Details */}
                  <div style={{ textAlign: "left", marginTop: "4px" }}>
                    <p style={{ color: "#111", fontSize: "14px", fontWeight: "bold", margin: 0 }}>
                      AlanDick East Africa Ltd.
                    </p>
                    <p style={{ color: "#666", fontSize: "11px", margin: "2px 0 0 0" }}>
                      P.O Box 12907, Muthithi Rd, Nairobi, Kenya.
                    </p>
                    <p style={{ color: "#666", fontSize: "11px", margin: 0 }}>
                      Tel: 254 722 570 112 | Email: admin@alandick.co.ke
                    </p>
                  </div>

                  {/* Thick Black Separator Line */}
                  <div style={{ height: "3px", backgroundColor: "#000", width: "100%", marginTop: "4px" }} />
                </div>
              </div>

              {/* ═══ BODY CONTENT ═══ */}
              <div style={{ padding: "32px" }}>
                {/* 1. EMPLOYEE DETAILS */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>1. Employee Details</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", padding: "20px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                    <div>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "4px", fontWeight: "600" }}>Full Name of Applicant</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.employeeName?.toUpperCase()}</p>
                    </div>
                    <div>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "4px", fontWeight: "600" }}>Position / Designation</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.employeePosition?.toUpperCase()}</p>
                    </div>
                  </div>
                </div>

                {/* 2. LEAVE BALANCE SUMMARY */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>2. Leave Balance Summary</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "12px" }}>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Annual Leave Balance</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.leaveBalances?.annual ?? '-'} DAYS</p>
                    </div>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Sick Leave Balance</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.leaveBalances?.sick ?? '-'} DAYS</p>
                    </div>
                  </div>
                </div>

                {/* 3. LEAVE DETAILS */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>3. Leave Details</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "1.2fr 1.5fr 0.8fr", gap: "12px" }}>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Category</p>
                      <p style={{ fontSize: "16px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.leaveType.replace(/_/g, ' ')}</p>
                    </div>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Period</p>
                      <p style={{ fontSize: "16px", fontWeight: "800", color: "#111", margin: 0 }}>{fmtDate(selectedRequest.startDate)} — {fmtDate(selectedRequest.endDate)}</p>
                    </div>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Days</p>
                      <p style={{ fontSize: "16px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.days} {selectedRequest.days === 1 ? 'DAY' : 'DAYS'}</p>
                    </div>
                  </div>
                </div>

                {/* 3. REASON */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>4. Declaration of Reason</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ padding: "20px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                    <p style={{ fontSize: "16px", color: "#111", fontStyle: "italic", margin: 0, lineHeight: "1.6" }}>"{selectedRequest.reason}"</p>
                  </div>
                </div>

                {/* 4. CONTACT & HANDOVER */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>5. Contact &amp; Handover</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: "12px" }}>
                    {[
                      { l: "Contact", v: selectedRequest.contactWhileOnLeave },
                      { l: "Line Manager", v: selectedRequest.handoverLineManager },
                      { l: "Handover To", v: selectedRequest.handoverCC },
                      { l: "Department", v: selectedRequest.handoverDepartment },
                    ].map((f, i) => (
                      <div key={i} style={{ padding: "12px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                        <p style={{ fontSize: "9px", color: "#666", textTransform: "uppercase", marginBottom: "4px", fontWeight: "600" }}>{f.l}</p>
                        <p style={{ fontSize: "13px", fontWeight: "700", color: "#111", margin: 0 }}>{f.v || "—"}</p>
                      </div>
                    ))}
                  </div>
                </div>

                {/* 5. HANDOVER REPORT DETAILS */}
                {(selectedRequest.handoverWorkStatus || selectedRequest.handoverActions || selectedRequest.handoverRelationships) && (
                  <div style={{ marginBottom: "28px" }}>
                    <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>6. Handover Report Details</p>
                    <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                    <div style={{ display: "flex", flexDirection: "column", gap: "10px" }}>
                      {[
                        { l: "Background & Work Status", v: selectedRequest.handoverWorkStatus },
                        { l: "Required Actions / Follow Up", v: selectedRequest.handoverActions },
                        { l: "Contact while on leave", v: selectedRequest.handoverRelationships },
                      ].filter(h => h.v).map((h, i) => (
                        <div key={i} style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                          <p style={{ fontSize: "10px", fontWeight: "800", color: "#666", textTransform: "uppercase", marginBottom: "6px" }}>{h.l}</p>
                          <p style={{ fontSize: "15px", color: "#111", lineHeight: "1.6", margin: 0 }}>{h.v}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 6. AUTHORIZATION */}
                <div style={{ marginBottom: "16px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>7. Authorization Signatures</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  
                  <div style={{ border: "1px solid #e5e7eb" }}>
                    {[
                      { role: selectedRequest.employeeDepartment?.toUpperCase() === 'PROJECTS' ? '1. HOD PROJECTS' : '1. OM', name: selectedRequest.omApprover?.name || (selectedRequest.employeeDepartment?.toUpperCase() === 'PROJECTS' ? 'HOD Projects' : 'Operations Manager'), date: selectedRequest.omApprovalDate, sig: selectedRequest.omApprover?.signature },
                      { role: "2. GM", name: selectedRequest.gmApprover?.name || "General Manager", date: selectedRequest.gmApprovalDate, sig: selectedRequest.gmApprover?.signature },
                      { role: "3. Admin", name: selectedRequest.approverName || "Administrator", date: selectedRequest.approverSignatureDate, sig: selectedRequest.approverSignature }
                    ].map((row, i, arr) => (
                      <div key={i} style={{ display: "flex", borderBottom: i < arr.length - 1 ? "1px solid #e5e7eb" : "none" }}>
                        <div style={{ width: "100px", padding: "16px", backgroundColor: "#fcfcfc", fontWeight: "900", fontSize: "13px", borderRight: "1px solid #e5e7eb", display: "flex", alignItems: "center", justifyContent: "center" }}>
                          {row.role}
                        </div>
                        <div style={{ flex: 1, padding: "16px", borderRight: "1px solid #e5e7eb" }}>
                          <p style={{ fontSize: "9px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Signature / Approval</p>
                          <div style={{ minHeight: "36px", display: "flex", alignItems: "center" }}>
                            {(() => {
                              const signatureSrc = row.sig || (row.date ? (() => {
                                if (row.role.includes('HOD PROJECTS')) return '/joshua_HODProjectssignature.png';
                                if (row.role.includes('OM')) return '/joram_OMsignature.png';
                                if (row.role.includes('GM')) return '/willis_GMsignature.png';
                                if (row.role.includes('Admin')) return '/mercy_signature.png';
                                return null;
                              })() : null);

                              if (signatureSrc) {
                                return <img src={signatureSrc} alt="Sig" style={{ maxHeight: "36px", width: "auto" }} />;
                              }
                              return (
                                <p style={{ fontSize: "16px", fontWeight: "800", color: row.date ? "#111" : "#ccc", fontStyle: "italic", margin: 0 }}>
                                  {row.date ? row.name : "—"}
                                </p>
                              );
                            })()}
                          </div>
                        </div>
                        <div style={{ width: "160px", padding: "16px" }}>
                          <p style={{ fontSize: "9px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Date</p>
                          <p style={{ fontSize: "15px", fontWeight: "800", color: row.date ? "#111" : "#ccc", margin: 0 }}>{row.date ? fmtDate(row.date) : "—"}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* ═══ FOOTER ═══ */}
              <div
                style={{
                  padding: "20px 32px",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  borderTop: "3px solid #000000",
                  marginTop: "auto"
                }}
              >
                <p style={{ fontSize: "10px", fontWeight: "700", color: "#111", margin: 0, letterSpacing: "1px", textTransform: "uppercase" }}>Official Document</p>
                <p style={{ fontSize: "10px", color: "#111", fontWeight: "600", margin: 0 }}>AlanDick &amp; Company (EA) Ltd • Leave Management System</p>
                <p style={{ fontSize: "10px", color: "#111", fontWeight: "700", margin: 0 }}>{new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}</p>
              </div>
            </div>
          )}
        </DialogContent>
      </Dialog>

      {/* Process Request Dialog */}
      <Dialog open={isProcessDialogOpen} onOpenChange={setIsProcessDialogOpen}>
        <DialogContent className="glass border-border/50">
          <DialogHeader>
            <DialogTitle>Process Leave Request</DialogTitle>
            <DialogDescription>
              {processAction === "approved" ? "Approve" : "Reject"} request for{" "}
              {processingRequest?.employeeName}
            </DialogDescription>
          </DialogHeader>

          <form onSubmit={handleProcessRequest} className="space-y-4">
            <div className="space-y-2">
              <Label>{processAction === "approved" ? "Comments" : "Reason for Refusal"}</Label>
              <Textarea
                value={rejectionReason}
                onChange={(e) => setRejectionReason(e.target.value)}
                placeholder={processAction === "approved" ? "Add any approval comments..." : "Please state the reason for refusal..."}
                required={processAction === "rejected"}
              />
            </div>

            <DialogFooter>
              <Button
                type="button"
                variant="ghost"
                onClick={() => setIsProcessDialogOpen(false)}
              >
                Cancel
              </Button>
              <Button
                type="submit"
                className={
                  processAction === "approved"
                    ? "bg-green-600 hover:bg-green-700"
                    : "bg-red-600 hover:bg-red-700"
                }
                disabled={reject.isPending}
              >
                {(() => {
                  if (reject.isPending) return "Processing...";
                  return `Confirm ${processAction === "approved" ? "Approval" : "Rejection"}`;
                })()}
              </Button>
            </DialogFooter>
          </form>
        </DialogContent>
      </Dialog>

      {/* New Request Dialog */}
      <Dialog open={isNewRequestOpen} onOpenChange={setIsNewRequestOpen}>
        <DialogContent className="glass border-border/50 max-h-[90vh] p-0 overflow-hidden flex flex-col w-[95vw] sm:max-w-2xl">
          <div className="p-6 pb-2">
            <DialogHeader>
              <DialogTitle>
                {editingRequest ? "Edit Leave Request" : "New Leave Request"}
              </DialogTitle>
              <DialogDescription>
                {editingRequest
                  ? "Update your leave request details"
                  : "Submit a new leave request for approval"}
              </DialogDescription>
            </DialogHeader>
          </div>

          {reservationId && !editingRequest && (
            <div className="mx-6 mt-2 p-3 bg-green-500/10 border border-green-500/20 rounded-lg flex items-center gap-3 text-green-600">
              <div className="bg-green-500 text-white rounded-full p-1">
                <CheckCircle className="h-3 w-3" />
              </div>
              <div className="text-xs">
                <p className="font-bold">Pre-Approved Period</p>
                <p className="opacity-80">This slot was already cleared by Management via Reservation. Finalizing now...</p>
              </div>
            </div>
          )}

          <form onSubmit={handleCreateRequest} className="flex flex-col flex-1 overflow-hidden">
            <div className="flex-1 overflow-y-auto p-6 pt-2 space-y-6">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className="space-y-2 flex flex-col">
                  <Label>Start Date</Label>
                  <Popover>
                    <PopoverTrigger asChild>
                      <Button
                        variant={"outline"}
                        className={cn(
                          "w-full justify-start text-left font-normal border-border/50",
                          !startDate && "text-muted-foreground"
                        )}
                      >
                        <CalendarIcon className="mr-2 h-4 w-4" />
                        {startDate ? format(new Date(startDate + "T00:00:00"), "PPP") : <span>Pick a date</span>}
                      </Button>
                    </PopoverTrigger>
                    <PopoverContent className="w-auto p-0" align="start">
                      <Calendar
                        mode="single"
                        selected={startDate ? new Date(startDate + "T00:00:00") : undefined}
                        onSelect={(d) => {
                          if (d) {
                            const dateStr = format(d, "yyyy-MM-dd");
                            setStartDate(dateStr);
                            if (endDate && new Date(dateStr + "T00:00:00") > new Date(endDate + "T00:00:00")) {
                              setEndDate(dateStr);
                            }
                          } else {
                            setStartDate("");
                          }
                        }}
                        workSchedule={user?.employee?.workSchedule || "MON_FRI"}
                        initialFocus
                        disabled={[{ before: new Date(new Date().setHours(0,0,0,0)) }]}
                      />
                    </PopoverContent>
                  </Popover>
                </div>
                <div className="space-y-2 flex flex-col">
                  <Label>End Date</Label>
                  <Popover>
                    <PopoverTrigger asChild>
                      <Button
                        variant={"outline"}
                        className={cn(
                          "w-full justify-start text-left font-normal border-border/50",
                          !endDate && "text-muted-foreground"
                        )}
                        disabled={!startDate}
                      >
                        <CalendarIcon className="mr-2 h-4 w-4" />
                        {endDate ? format(new Date(endDate + "T00:00:00"), "PPP") : <span>Pick a date</span>}
                      </Button>
                    </PopoverTrigger>
                    <PopoverContent className="w-auto p-0" align="start">
                      <Calendar
                        mode="single"
                        selected={endDate ? new Date(endDate + "T00:00:00") : undefined}
                        onSelect={(d) => {
                          if (d) {
                            setEndDate(format(d, "yyyy-MM-dd"));
                          } else {
                            setEndDate("");
                          }
                        }}
                        workSchedule={user?.employee?.workSchedule || "MON_FRI"}
                        initialFocus
                        disabled={[
                          { before: startDate ? new Date(startDate + "T00:00:00") : new Date(new Date().setHours(0,0,0,0)) }
                        ]}
                      />
                    </PopoverContent>
                  </Popover>
                </div>
              </div>

              {startDate && endDate && (
                <div className="bg-muted/30 p-3 rounded-md text-sm">
                  <span className="font-semibold">Duration: </span>
                  {(() => {
                    const ws = user?.employee?.workSchedule || "MON_FRI";
                    const days = isScattered && scatteredDates.length > 0
                        ? calculateLeaveDays(startDate, endDate, ws, scatteredDates)
                        : calculateLeaveDays(startDate, endDate, ws);
                    return `${days} day${days === 1 ? "" : "s"}`;
                  })()}
                  {user?.employee?.workSchedule === "MON_SAT" && (
                    <span className="text-xs text-muted-foreground ml-2">
                      (Saturdays count as ½ day)
                    </span>
                  )}
                </div>
              )}

              {/* Scattered Date Picker */}
              {isScattered && startDate && endDate && (
                <div className="space-y-3 p-4 border border-border/50 rounded-lg bg-muted/10">
                  <Label className="text-sm font-medium">Select Scattered Leave Dates</Label>
                  <p className="text-xs text-muted-foreground mb-4">Click dates within your selected range to toggle them.</p>
                  
                  <div className="flex justify-center bg-background rounded-xl p-4 shadow-sm border border-border/50">
                    <Calendar
                      mode="multiple"
                      selected={scatteredDates.map(d => new Date(d + "T00:00:00"))}
                      onSelect={(dates) => {
                        if (!dates) setScatteredDates([]);
                        else setScatteredDates(dates.map(d => format(d, "yyyy-MM-dd")));
                      }}
                      workSchedule={user?.employee?.workSchedule || "MON_FRI"}
                      className="rounded-md"
                      disabled={[
                        { before: new Date(startDate + "T00:00:00") },
                        { after: new Date(endDate + "T00:00:00") }
                      ]}
                      defaultMonth={new Date(startDate + "T00:00:00")}
                    />
                  </div>
                </div>
              )}

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
                <div className="space-y-2">
                  <Label>Leave Type</Label>
                  <Select value={leaveType} onValueChange={(value) => setLeaveType(value as LeaveType)}>
                    <SelectTrigger className="bg-background/50"><SelectValue /></SelectTrigger>
                    <SelectContent>
                      <SelectItem value="ANNUAL">Annual Leave</SelectItem>
                      <SelectItem value="SICK">Sick Leave</SelectItem>
                      <SelectItem value="MATERNITY">Maternity Leave</SelectItem>
                      <SelectItem value="PATERNITY">Paternity Leave</SelectItem>
                    </SelectContent>
                  </Select>
                  {user?.employee?.leaveBalances && (leaveType === "ANNUAL" || leaveType === "SICK") && (
                    <div className="text-xs text-muted-foreground mt-1 px-1">
                      Available: <span className="font-semibold text-foreground">{user.employee.leaveBalances[leaveType.toLowerCase() as keyof typeof user.employee.leaveBalances]} days</span>
                    </div>
                  )}
                  {leaveType === "MATERNITY" && user?.employee?.gender !== "FEMALE" && (
                    <div className="text-[10px] text-red-500 font-medium mt-1 flex items-center gap-1 px-1">
                      <XCircle className="h-3 w-3" />
                      Maternity leave is only for female employees
                    </div>
                  )}
                  {leaveType === "PATERNITY" && user?.employee?.gender !== "MALE" && (
                    <div className="text-[10px] text-red-500 font-medium mt-1 flex items-center gap-1 px-1">
                      <XCircle className="h-3 w-3" />
                      Paternity leave is only for male employees
                    </div>
                  )}
                </div>
                <div className="space-y-2">
                  <Label>Contact Address (While on leave)</Label>
                  <Input value={contactWhileOnLeave} onChange={(e) => setContactWhileOnLeave(e.target.value)} placeholder="Telephone / Address" className="bg-background/50" />
                </div>
              </div>

              <div className="flex items-center justify-between p-4 rounded-xl border border-primary/10 bg-primary/5">
                <div className="space-y-0.5">
                  <Label className="text-sm font-semibold">Scattered Leave Days</Label>
                  <p className="text-xs text-muted-foreground">Select non-contiguous dates</p>
                </div>
                <button type="button" role="switch" aria-checked={isScattered} onClick={() => { setIsScattered(!isScattered); if (!isScattered) setScatteredDates([]); }}
                  className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${isScattered ? "bg-primary" : "bg-muted"}`}>
                  <span className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${isScattered ? "translate-x-6" : "translate-x-1"}`} />
                </button>
              </div>

              <div className="space-y-4 pt-4 border-t border-border/50">
                <div className="flex items-center gap-2">
                  <div className="h-8 w-1 bg-primary rounded-full" />
                  <h4 className="font-bold text-sm tracking-tight uppercase text-muted-foreground">Handover Process</h4>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div className="space-y-2">
                    <Label>Line Manager</Label>
                    <Select value={handoverLineManager} onValueChange={setHandoverLineManager}>
                      <SelectTrigger className="bg-background/50"><SelectValue placeholder="Select manager" /></SelectTrigger>
                      <SelectContent>
                        {lineManagerOptions.map((option) => (
                          <SelectItem key={option.value} value={option.value}>{option.label}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </div>
                  <div className="space-y-2">
                    <Label>CC (Handed over to)</Label>
                    <Select value={handoverCC} onValueChange={setHandoverCC}>
                      <SelectTrigger className="bg-background/50"><SelectValue placeholder="Colleague" /></SelectTrigger>
                      <SelectContent>
                        {handoverOptions.map((emp: DeptEmployee) => (
                          <SelectItem key={emp.id} value={emp.user?.name || emp.name || emp.id}>{emp.user?.name || emp.name}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </div>
                  <div className="space-y-2">
                    <Label>Department</Label>
                    <Input value={handoverDepartment} readOnly className="bg-muted/50" />
                  </div>
                </div>
                <div className="grid grid-cols-1 gap-4">
                  <Textarea value={handoverWorkStatus} onChange={(e) => setHandoverWorkStatus(e.target.value)} placeholder="Work status..." className="h-20 bg-background/50 resize-none" />
                  <Textarea value={handoverActions} onChange={(e) => setHandoverActions(e.target.value)} placeholder="Required actions..." className="h-20 bg-background/50 resize-none" />
                  <Textarea value={handoverRelationships} onChange={(e) => setHandoverRelationships(e.target.value)} placeholder="Key contacts..." className="h-20 bg-background/50 resize-none" />
                </div>
              </div>

              <div className="space-y-2 pt-4 border-t border-border/50">
                <Label className="font-semibold">Description / Reason</Label>
                <Textarea value={description} onChange={(e) => setDescription(e.target.value)} placeholder="Reason for leave..." className="h-24 bg-background/50" required />
              </div>
            </div>

            <div className="p-4 sm:p-6 border-t border-border/50 bg-muted/30 flex items-center justify-between gap-4">
              <div className="hidden sm:block">
                {(() => {
                  if (!startDate || !endDate) return null;
                  const ws = user?.employee?.workSchedule || "MON_FRI";
                  const days = isScattered ? calculateLeaveDays(startDate, endDate, ws, scatteredDates) : calculateLeaveDays(startDate, endDate, ws);
                  if (days <= 0) return null;
                  const balanceKey = leaveType.toLowerCase() as keyof typeof user.employee.leaveBalances;
                  const balance = user?.employee?.leaveBalances?.[balanceKey] || 0;
                  const isOver = (leaveType === "ANNUAL" || leaveType === "SICK") && days > balance;
                  return (
                    <div className={cn("text-xs font-medium px-3 py-1.5 rounded-full border", 
                      isOver ? "bg-destructive/10 text-destructive border-destructive/20" : "bg-primary/10 text-primary border-primary/20")}>
                      {isOver ? <span className="flex items-center gap-1.5"><XCircle className="h-3.5 w-3.5" />Balance exceeded</span> : <span>Total: {days} days</span>}
                    </div>
                  );
                })()}
              </div>
              <DialogFooter className="flex-1 sm:flex-initial">
                <Button type="button" variant="ghost" onClick={() => setIsNewRequestOpen(false)}>Cancel</Button>
                <Button type="submit" className="gradient-primary min-w-[140px]" disabled={isSubmitting || (() => {
                  if (!startDate || !endDate) return true;
                  const ws = user?.employee?.workSchedule || "MON_FRI";
                  const days = isScattered ? calculateLeaveDays(startDate, endDate, ws, scatteredDates) : calculateLeaveDays(startDate, endDate, ws);
                  if (days <= 0) return true;
                  if (leaveType === "MATERNITY" && user?.employee?.gender !== "FEMALE") return true;
                  if (leaveType === "PATERNITY" && user?.employee?.gender !== "MALE") return true;
                  if (leaveType !== "ANNUAL" && leaveType !== "SICK") return false;
                  if (!user?.employee?.leaveBalances) return true;
                  const balanceKey = leaveType.toLowerCase() as keyof typeof user.employee.leaveBalances;
                  return days > (user.employee.leaveBalances[balanceKey] || 0);
                })()}>
                  {isSubmitting ? "Submitting..." : (editingRequest ? "Update Request" : "Submit Request")}
                </Button>
              </DialogFooter>
            </div>
          </form>
        </DialogContent>
      </Dialog>

      {/* Bulk Reject Confirmation Dialog */}
      <AlertDialog open={isBulkRejectOpen} onOpenChange={setIsBulkRejectOpen}>
        <AlertDialogContent className="glass border-border/50">
          <AlertDialogHeader>
            <AlertDialogTitle>Reject Selected Requests</AlertDialogTitle>
            <AlertDialogDescription>
              Are you sure you want to reject {selectedRequests.size} selected
              request(s)? This action cannot be undone.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <div className="py-4">
            <Label htmlFor="bulkRejectReason">Rejection Reason</Label>
            <Textarea
              id="bulkRejectReason"
              placeholder="Enter reason for rejection..."
              value={bulkRejectReason}
              onChange={(e) => setBulkRejectReason(e.target.value)}
              className="mt-2"
            />
          </div>
          <AlertDialogFooter>
            <AlertDialogCancel onClick={() => setBulkRejectReason("")}>
              Cancel
            </AlertDialogCancel>
            <AlertDialogAction
              className="bg-destructive text-destructive-foreground hover:bg-destructive/90"
              onClick={() => {
                if (bulkRejectReason.trim()) {
                  bulkReject.mutate({
                    ids: Array.from(selectedRequests),
                    reason: bulkRejectReason,
                  });
                  setBulkRejectReason("");
                  setIsBulkRejectOpen(false);
                } else {
                  toast({
                    variant: "destructive",
                    title: "Error",
                    description: "Please provide a rejection reason",
                  });
                }
              }}
              disabled={bulkReject.isPending}
            >
              {bulkReject.isPending ? "Rejecting..." : "Reject All"}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      <ReservationModal
        isOpen={isReservationModalOpen}
        onClose={() => setIsReservationModalOpen(false)}
      />
    </DashboardLayout>
  );
};

export default Requests;
===
import { useState, useEffect, useRef, useMemo } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { useSearchParams } from "react-router-dom";
import { DashboardLayout } from "@/components/layout/DashboardLayout";
import { LeaveRequest, LeaveType } from "@/types/leave";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { StatusBadge } from "@/components/StatusBadge";
import { ApprovalTimeline } from "@/components/ApprovalTimeline";
import { cn } from "@/lib/utils";
import {
  CheckCircle,
  XCircle,
  Eye,
  Filter,
  Plus,
  Download,
  FileSpreadsheet,
  CalendarRange,
} from "lucide-react";
import { motion } from "framer-motion";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { generateLeaveRequestPdf } from "@/lib/corporatePdf";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from "@/components/ui/alert-dialog";
import api from "@/lib/api";
import { useToast } from "@/components/ui/use-toast";
import { useAuth } from "@/contexts/AuthContext";
import {
  calculateLeaveDays,
  isSunday,
  isSaturday,
  isKenyanPublicHoliday,
  getKenyanPublicHolidayDetails,
} from "@/lib/holidays";
import { ReservationModal } from "@/components/ReservationModal";
import { format } from "date-fns";
import { Calendar as CalendarIcon } from "lucide-react";
import { Calendar } from "@/components/ui/calendar";
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";

const LINE_MANAGER_ROLES = ["OPERATIONS_MANAGER", "HOD_PROJECTS"] as const;

const Requests = () => {
  const { user } = useAuth();
  const { toast } = useToast();
  const queryClient = useQueryClient();
  const [searchParams] = useSearchParams();
  const [statusFilter, setStatusFilter] = useState<string>(
    searchParams.get("status") || "all"
  );
  const [searchQuery, setSearchQuery] = useState("");
  const [leaveTypeFilter, setLeaveTypeFilter] = useState<string>("all");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");
  const [selectedRequests, setSelectedRequests] = useState<Set<string>>(
    new Set(),
  );
  const [selectedRequest, setSelectedRequest] = useState<LeaveRequest | null>(
    null,
  );
  const [isNewRequestOpen, setIsNewRequestOpen] = useState(false);
  const [isReservationModalOpen, setIsReservationModalOpen] = useState(false);
  const [editingRequest, setEditingRequest] = useState<LeaveRequest | null>(
    null,
  );
  const [isProcessDialogOpen, setIsProcessDialogOpen] = useState(false);
  const [processingRequest, setProcessingRequest] =
    useState<LeaveRequest | null>(null);
  const [processAction, setProcessAction] = useState<"approved" | "rejected">(
    "approved",
  );
  const [rejectionReason, setRejectionReason] = useState("");
  const [currentPage, setCurrentPage] = useState(1);

  // Check if General Manager is away (Manual toggle or on leave)
  const { data: gmStatus } = useQuery({
    queryKey: ["gmStatus"],
    queryFn: async () => {
      const response = await api.get("/auth/gm-status");
      return response.data.data as { isAway: boolean; gmName: string };
    },
    // Only fetch for CTO or Admin who might need this info
    enabled: !!user && (user.role === "CTO" || user.role === "ADMINISTRATOR" || user.role === "GENERAL_MANAGER"),
  });
  const [itemsPerPage, setItemsPerPage] = useState(20);
  const [employeeFilter, setEmployeeFilter] = useState<string>("all");
  const [isBulkRejectOpen, setIsBulkRejectOpen] = useState(false);
  const [bulkRejectReason, setBulkRejectReason] = useState("");
  const detailsRef = useRef<HTMLDivElement>(null);

  const getInitials = (name: string) => {
    return name
      .split(" ")
      .map((n) => n[0])
      .join("")
      .toUpperCase()
      .slice(0, 2);
  };

  const fmtDate = (d: string | null | undefined): string => {
    if (!d) return "—";
    return new Date(d).toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  };

  // Read URL parameters on mount
  useEffect(() => {
    const status = searchParams.get("status");
    if (status) {
      setStatusFilter(status);
    }

    // Auto-open new request dialog when ?new=true is present
    const openNew = searchParams.get("new");
    if (openNew === "true") {
      setEditingRequest(null);
      setStartDate(searchParams.get("startDate") || "");
      setEndDate(searchParams.get("endDate") || "");
      if (searchParams.get("rtype")) {
        setLeaveType(searchParams.get("rtype") as LeaveType);
      }
      setDescription("");
      setContactWhileOnLeave("");
      setHandoverLineManager("");
      setHandoverCC("");
      setHandoverDepartment(user?.employee?.department || "");
      setHandoverWorkStatus("");
      setHandoverActions("");
      setHandoverRelationships("");
      setEmployeeSignature("");
      setIsScattered(false);
      setScatteredDates([]);
      setReservationId(searchParams.get("reservationId") || "");
      setIsNewRequestOpen(true);
      
      const newParams = new URLSearchParams(searchParams);
      newParams.delete("new");
      globalThis.history.replaceState(
        {},
        "",
        `${globalThis.location.pathname}${newParams.toString() ? "?" + newParams.toString() : ""}`,
      );
    }
  }, [searchParams, user?.employee?.department]);

  // New Request Form State
  const [startDate, setStartDate] = useState("");
  const [endDate, setEndDate] = useState("");
  const [leaveType, setLeaveType] = useState<LeaveType>("ANNUAL");
  const [description, setDescription] = useState("");

  // New Fields State
  const [contactWhileOnLeave, setContactWhileOnLeave] = useState("");
  const [handoverLineManager, setHandoverLineManager] = useState("");
  const [handoverCC, setHandoverCC] = useState("");
  const [handoverDepartment, setHandoverDepartment] = useState("");
  const [handoverWorkStatus, setHandoverWorkStatus] = useState("");
  const [handoverActions, setHandoverActions] = useState("");
  const [handoverRelationships, setHandoverRelationships] = useState("");
  const [employeeSignature, setEmployeeSignature] = useState("");
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Scattered leave state
  const [isScattered, setIsScattered] = useState(false);
  const [scatteredDates, setScatteredDates] = useState<string[]>([]);
  const [reservationId, setReservationId] = useState("");

  // Removed employee selector – employees create requests for themselves
  const handleCreateRequest = async (e?: React.FormEvent) => {
    if (e) e.preventDefault();
    setIsSubmitting(true);
    try {
      const payload = {
        startDate: new Date(startDate).toISOString(),
        endDate: new Date(endDate).toISOString(),
        leaveType,
        description,
        isScattered,
        scatteredDates: isScattered ? scatteredDates : undefined,
        contactWhileOnLeave,
        handoverLineManager,
        handoverCC,
        handoverDepartment,
        handoverNotes: "",
        handoverWorkStatus,
        handoverActions,
        handoverRelationships,
        employeeSignature,
        reservationId: reservationId || undefined,
      };

      if (editingRequest) {
        await api.put(`/leave-requests/${editingRequest.id}`, payload);
        toast({
          title: "Success",
          description: "Leave request updated successfully",
        });
      } else {
        const res = await api.post("/leave-requests", payload);
        
        // Auto-convert associated reservation (handled by backend now or locally)
        const resId = reservationId;
        if (resId && res.data?.data?.leaveRequest?.id) {
          try {
            await api.post(`/reservations/${resId}/convert`, { 
              leaveRequestId: res.data.data.leaveRequest.id 
            });
            const newParams = new URLSearchParams(searchParams);
            newParams.delete("reservationId");
            globalThis.history.replaceState({}, "", `${globalThis.location.pathname}${newParams.toString() ? "?" + newParams.toString() : ""}`);
          } catch(e) {
            console.error("Failed to convert reservation flag automatically.");
          }
        }

        toast({
          title: "Success",
          description: "Leave request submitted successfully",
        });
      }

      setIsNewRequestOpen(false);
      setEditingRequest(null);
      // Reset form
      setStartDate("");
      setEndDate("");
      setDescription("");
      setContactWhileOnLeave("");
      setHandoverLineManager("");
      setHandoverCC("");
      setHandoverDepartment(user?.employee?.department || "");
      setHandoverWorkStatus("");
      setHandoverActions("");
      setHandoverRelationships("");
      setEmployeeSignature("");
      setIsScattered(false);
      setScatteredDates([]);

      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
    } catch (error: unknown) {
      const err = error as { response?: { data?: { message?: string } } };
      toast({
        variant: "destructive",
        title: "Error",
        description:
          err.response?.data?.message ||
          `Failed to ${editingRequest ? "update" : "submit"} request`,
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleEditClick = (request: LeaveRequest) => {
    setEditingRequest(request);
    setStartDate(request.startDate);
    setEndDate(request.endDate);
    setLeaveType(request.leaveType);
    setDescription(request.reason || "");
    setContactWhileOnLeave(request.contactWhileOnLeave || "");
    setHandoverLineManager(request.handoverLineManager || "");
    setHandoverCC(request.handoverCC || "");
    setHandoverDepartment(request.handoverDepartment || "");
    setHandoverWorkStatus(request.handoverWorkStatus || "");
    setHandoverActions(request.handoverActions || "");
    setHandoverRelationships(request.handoverRelationships || "");
    setEmployeeSignature(request.employeeSignature || "");
    setIsScattered(request.isScattered || false);
    setScatteredDates(request.scatteredDates || []);
    setIsNewRequestOpen(true);
  };

  // Approval mutations
  const hodApprove = useMutation({
    mutationFn: (id: string) =>
      api.post(`/leave-requests/${id}/hod-approve`, { comments: "" }),
    onMutate: async (id) => {
      await queryClient.cancelQueries({
        queryKey: ["leaveRequests", currentPage, itemsPerPage],
      });
      const previousData = queryClient.getQueryData([
        "leaveRequests",
        currentPage,
        itemsPerPage,
      ]);

      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        (
          old:
            | { success: boolean; data: { leaveRequests: LeaveRequest[] } }
            | undefined,
        ) => {
          if (!old) return old;
          return {
            ...old,
            data: {
              ...old.data,
              leaveRequests: old.data.leaveRequests.map((req: LeaveRequest) =>
                req.id === id
                  ? {
                      ...req,
                      status: "PENDING_GM",
                      omApprovalDate: new Date().toISOString(),
                    }
                  : req,
              ),
            },
          };
        },
      );

      return { previousData };
    },
    onError: (err: unknown, variables, context) => {
      const error = err as { response?: { data?: { message?: string } } };
      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        context?.previousData,
      );
      toast({
        variant: "destructive",
        title: "Error",
        description: error.response?.data?.message || "Failed to approve",
      });
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
    },
    onSuccess: () => {
      toast({
        title: "Success",
        description: "Request approved (HOD Projects)",
      });
    },
  });

  const omApprove = useMutation({
    mutationFn: (id: string) =>
      api.post(`/leave-requests/${id}/om-approve`, { comments: "" }),
    onMutate: async (id) => {
      await queryClient.cancelQueries({
        queryKey: ["leaveRequests", currentPage, itemsPerPage],
      });
      const previousData = queryClient.getQueryData([
        "leaveRequests",
        currentPage,
        itemsPerPage,
      ]);

      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        (
          old:
            | { success: boolean; data: { leaveRequests: LeaveRequest[] } }
            | undefined,
        ) => {
          if (!old) return old;
          return {
            ...old,
            data: {
              ...old.data,
              leaveRequests: old.data.leaveRequests.map((req: LeaveRequest) =>
                req.id === id
                  ? {
                      ...req,
                      status: "PENDING_GM",
                      omApprovalDate: new Date().toISOString(),
                    }
                  : req,
              ),
            },
          };
        },
      );

      return { previousData };
    },
    onError: (err: unknown, variables, context) => {
      const error = err as { response?: { data?: { message?: string } } };
      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        context?.previousData,
      );
      toast({
        variant: "destructive",
        title: "Error",
        description: error.response?.data?.message || "Failed to approve",
      });
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
    },
    onSuccess: () => {
      toast({
        title: "Success",
        description: "Request approved (Operations Manager)",
      });
    },
  });

  const gmApprove = useMutation({
    mutationFn: (id: string) =>
      api.post(`/leave-requests/${id}/gm-approve`, { comments: "" }),
    onMutate: async (id) => {
      await queryClient.cancelQueries({
        queryKey: ["leaveRequests", currentPage, itemsPerPage],
      });
      const previousData = queryClient.getQueryData([
        "leaveRequests",
        currentPage,
        itemsPerPage,
      ]);

      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        (
          old:
            | { success: boolean; data: { leaveRequests: LeaveRequest[] } }
            | undefined,
        ) => {
          if (!old) return old;
          return {
            ...old,
            data: {
              ...old.data,
              leaveRequests: old.data.leaveRequests.map((req: LeaveRequest) =>
                req.id === id
                  ? {
                      ...req,
                      status: "PENDING_ADMIN",
                      gmApprovalDate: new Date().toISOString(),
                    }
                  : req,
              ),
            },
          };
        },
      );

      return { previousData };
    },
    onError: (err: unknown, variables, context) => {
      const error = err as { response?: { data?: { message?: string } } };
      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        context?.previousData,
      );
      toast({
        variant: "destructive",
        title: "Error",
        description: error.response?.data?.message || "Failed to approve",
      });
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
    },
    onSuccess: () => {
      toast({
        title: "Success",
        description: "Request approved (GM) and pending Admin confirmation",
      });
    },
  });

  const adminApprove = useMutation({
    mutationFn: (id: string) =>
      api.post(`/leave-requests/${id}/admin-approve`, {}),
    onMutate: async (id) => {
      await queryClient.cancelQueries({
        queryKey: ["leaveRequests", currentPage, itemsPerPage],
      });
      const previousData = queryClient.getQueryData([
        "leaveRequests",
        currentPage,
        itemsPerPage,
      ]);

      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        (
          old:
            | { success: boolean; data: { leaveRequests: LeaveRequest[] } }
            | undefined,
        ) => {
          if (!old) return old;
          return {
            ...old,
            data: {
              ...old.data,
              leaveRequests: old.data.leaveRequests.map((req: LeaveRequest) =>
                req.id === id
                  ? {
                      ...req,
                      status: "APPROVED",
                      approverSignatureDate: new Date().toISOString(),
                    }
                  : req,
              ),
            },
          };
        },
      );

      return { previousData };
    },
    onError: (err: unknown, variables, context) => {
      const error = err as { response?: { data?: { message?: string } } };
      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        context?.previousData,
      );
      toast({
        variant: "destructive",
        title: "Error",
        description: error.response?.data?.message || "Failed to approve",
      });
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
      queryClient.invalidateQueries({ queryKey: ["stats"] });
    },
    onSuccess: () => {
      toast({
        title: "Success",
        description: "Request finally approved",
      });
    },
  });

  const reject = useMutation({
    mutationFn: ({ id, reason }: { id: string; reason: string }) =>
      api.post(`/leave-requests/${id}/reject`, { reason }),
    onMutate: async ({ id, reason }) => {
      await queryClient.cancelQueries({
        queryKey: ["leaveRequests", currentPage, itemsPerPage],
      });
      const previousData = queryClient.getQueryData([
        "leaveRequests",
        currentPage,
        itemsPerPage,
      ]);

      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        (
          old:
            | { success: boolean; data: { leaveRequests: LeaveRequest[] } }
            | undefined,
        ) => {
          if (!old) return old;
          return {
            ...old,
            data: {
              ...old.data,
              leaveRequests: old.data.leaveRequests.map((req: LeaveRequest) => {
                if (req.id === id) {
                  let newStatus: LeaveRequest["status"] = "REJECTED_OM";
                  if (req.status === "PENDING_GM") newStatus = "REJECTED_GM";
                  if (req.status === "PENDING_ADMIN") newStatus = "REJECTED_ADMIN";
                  return {
                    ...req,
                    status: newStatus,
                    rejectionReason: reason,
                    rejectedAt: new Date().toISOString(),
                  };
                }
                return req;
              }),
            },
          };
        },
      );

      return { previousData };
    },
    onError: (err: unknown, variables, context) => {
      const error = err as { response?: { data?: { message?: string } } };
      queryClient.setQueryData(
        ["leaveRequests", currentPage, itemsPerPage],
        context?.previousData,
      );
      toast({
        variant: "destructive",
        title: "Error",
        description: error.response?.data?.message || "Failed to reject",
      });
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
    },
    onSuccess: () => {
      toast({ title: "Success", description: "Request rejected" });
    },
  });

  // Bulk selection handlers
  const handleSelectRequest = (id: string) => {
    const newSelected = new Set(selectedRequests);
    if (newSelected.has(id)) {
      newSelected.delete(id);
    } else {
      newSelected.add(id);
    }
    setSelectedRequests(newSelected);
  };

  const handleSelectAll = () => {
    if (
      selectedRequests.size === filteredRequests.length &&
      filteredRequests.length > 0
    ) {
      setSelectedRequests(new Set());
    } else {
      setSelectedRequests(new Set(filteredRequests.map((req) => req.id)));
    }
  };

  // Bulk actions
  const bulkApprove = useMutation({
    mutationFn: async (ids: string[]) => {
      return Promise.all(
        ids.map((id) =>
          api.post(`/leave-requests/${id}/om-approve`, { comments: "" }),
        ),
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
      const count = selectedRequests.size;
      setSelectedRequests(new Set());
      toast({ title: "Success", description: `${count} request(s) approved` });
    },
    onError: (error: unknown) => {
      const err = error as { response?: { data?: { message?: string } } };
      toast({
        variant: "destructive",
        title: "Error",
        description:
          err.response?.data?.message || "Failed to approve requests",
      });
    },
  });

  const bulkReject = useMutation({
    mutationFn: async ({ ids, reason }: { ids: string[]; reason: string }) => {
      return Promise.all(
        ids.map((id) => api.post(`/leave-requests/${id}/reject`, { reason })),
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["leaveRequests"] });
      const count = selectedRequests.size;
      setSelectedRequests(new Set());
      toast({ title: "Success", description: `${count} request(s) rejected` });
    },
    onError: (error: unknown) => {
      const err = error as { response?: { data?: { message?: string } } };
      toast({
        variant: "destructive",
        title: "Error",
        description: err.response?.data?.message || "Failed to reject requests",
      });
    },
  });

  // Fetch employees for the employee filter dropdown
  const { data: employeesData } = useQuery({
    queryKey: ["employees"],
    queryFn: async ({ signal }) => {
      const response = await api.get("/employees", { signal });
      return response.data.data.employees || [];
    },
    // Note: query runs for all users — managers need it for employee filtering,
    // all users need it for handover Line Manager / CC dropdowns.
  });

  // Reuse employees query data for Line Manager / CC dropdowns (avoid duplicate API call)
  const allEmployeesData = employeesData;

  interface DeptEmployee {
    id: string;
    department: string;
    position: string;
    user?: { id: string; name: string; role?: string };
    name?: string;
  }

  const departmentColleagues: DeptEmployee[] = (allEmployeesData || []).filter(
    (emp: DeptEmployee) =>
      emp.department?.toUpperCase() ===
        user?.employee?.department?.toUpperCase() && emp.user?.id !== user?.id,
  );

  const handoverOptions: DeptEmployee[] = departmentColleagues;

  const lineManagerOptions = (allEmployeesData || [])
    .filter((emp: DeptEmployee) => {
      const role = emp.user?.role;
      if (!role) return false;

      // For OM and HOD Projects, their line managers are GM or CTO
      if (user?.role === "OPERATIONS_MANAGER" || user?.role === "HOD_PROJECTS") {
        return role === "GENERAL_MANAGER" || role === "CTO";
      }

      // Administrators follow the same flow as regular employees — report to OM or HOD Projects
      // Default: report to OM or HOD Projects
      return (LINE_MANAGER_ROLES as readonly string[]).includes(role);
    })
    .map((emp: DeptEmployee) => ({
      value: emp.user?.name || emp.name || emp.id,
      label: emp.user?.name || emp.name || emp.id,
    }));

  const { data: paginatedData, isLoading } = useQuery({
    queryKey: [
      "leaveRequests",
      currentPage,
      itemsPerPage,
      user?.role,
      statusFilter,
      searchQuery,
      leaveTypeFilter,
      dateFrom,
      dateTo,
      employeeFilter,
    ],
    queryFn: async ({ signal }) => {
      // Determine the correct endpoint based on user role
      let endpoint = "/leave-requests/my-leaves";

      if (
        ["OPERATIONS_MANAGER", "GENERAL_MANAGER", "ADMINISTRATOR"].includes(
          user?.role || "",
        )
      ) {
        endpoint = "/leave-requests";
      } else if (user?.role === "HOD_PROJECTS") {
        endpoint = "/leave-requests/department-leaves";
      }

      const response = await api.get(endpoint, {
        params: {
          page: currentPage,
          limit: itemsPerPage,
          status: statusFilter === "all" ? undefined : statusFilter,
          search: searchQuery || undefined,
          type: leaveTypeFilter === "all" ? undefined : leaveTypeFilter,
          startDate: dateFrom || undefined,
          endDate: dateTo || undefined,
          employeeId: employeeFilter === "all" ? undefined : employeeFilter,
        },
        signal, // Pass signal for automatic cancellation
      });
      return response.data;
    },
    enabled: !!user, // Only run query when user is available
  });

  const requests: LeaveRequest[] = useMemo(
    () =>
      paginatedData?.data?.leaveRequests?.map(
        (req: Record<string, unknown>) => ({
          id: req.id as string,
          requestNumber: req.requestNumber as number,
          employeeId: req.employeeId as string,
          employeeName: (req.employee as { user: { name: string } }).user
            .name as string,
          employeePosition: (req.employee as { position: string })
            .position as string,
          employeeDepartment: (req.employee as { department: string })
            .department as string,
          employeeAvatar: `https://api.dicebear.com/7.x/initials/svg?seed=${(req.employee as { user: { name: string } }).user.name}&backgroundColor=08033F`,
          leaveType: req.leaveType as LeaveType,
          startDate: req.startDate as string,
          endDate: req.endDate as string,
          days: (() => {
            const ws = (req.employee as Record<string, unknown>)?.workSchedule as string || "MON_FRI";
            const start = (req.startDate as string).split("T")[0];
            const end = (req.endDate as string).split("T")[0];
            if (req.isScattered && req.scatteredDates) {
              // scatteredDates may arrive as a JSON string from the API
              let datesArr: string[] = [];
              if (typeof req.scatteredDates === "string") {
                try { datesArr = JSON.parse(req.scatteredDates as string); } catch { datesArr = []; }
              } else {
                datesArr = req.scatteredDates as string[];
              }
              return calculateLeaveDays(start, end, ws, datesArr.map(d => d.split('T')[0]));
            }
            return calculateLeaveDays(start, end, ws);
          })(),
          reason: req.description as string,
          status: req.status as LeaveRequest["status"],
          submittedDate: req.createdAt as string,

          // Scattered leave
          isScattered: (req.isScattered as boolean) || false,
          scatteredDates: (() => {
            if (!req.scatteredDates) return [];
            if (typeof req.scatteredDates === "string") {
              try { return JSON.parse(req.scatteredDates as string) as string[]; } catch { return []; }
            }
            return req.scatteredDates as string[];
          })(),

          // Approval details
          omApprover: req.omApprover as
            | { name: string; email: string }
            | undefined,
          omApprovalDate: req.omApprovalDate as string,
          omApprovalComments: req.omApprovalComments as string,
          gmApprover: req.gmApprover as
            | { name: string; email: string }
            | undefined,
          gmApprovalDate: req.gmApprovalDate as string,
          gmApprovalComments: req.gmApprovalComments as string,
          rejectedBy: req.rejectedBy as string,
          rejectedAt: req.rejectedAt as string,
          leaveBalances: (() => {
            const emp = req.employee as any;
            if (!emp?.leaveBalances) return undefined;
            try {
              return typeof emp.leaveBalances === "string"
                ? JSON.parse(emp.leaveBalances)
                : emp.leaveBalances;
            } catch (e) {
              console.error("Error parsing leave balances:", e);
              return undefined;
            }
          })(),
          rejectionReason: req.rejectionReason as string,

          contactWhileOnLeave: req.contactWhileOnLeave as string,
          handoverLineManager: req.handoverLineManager as string,
          handoverCC: req.handoverCC as string,
          handoverDepartment: req.handoverDepartment as string,
          handoverWorkStatus: req.handoverWorkStatus as string,
          handoverActions: req.handoverActions as string,
          handoverRelationships: req.handoverRelationships as string,
          
          approverSignatureDate: req.approverSignatureDate as string,
        }),
      ) || [],
    [paginatedData],
  );

  const openProcessDialog = (
    request: LeaveRequest,
    action: "approved" | "rejected",
  ) => {
    setProcessingRequest(request);
    setProcessAction(action);
    setRejectionReason("");
    setIsProcessDialogOpen(true);
  };

  const handleProcessRequest = (e: React.FormEvent) => {
    e.preventDefault();
    if (!processingRequest) return;

    if (processAction === "rejected") {
      reject.mutate({
        id: processingRequest.id,
        reason: rejectionReason,
      });
      setIsProcessDialogOpen(false);
      setProcessingRequest(null);
      setRejectionReason("");
    } else if (processAction === "approved") {
      // Determine which mutation to call based on user role and request status
      const role = user?.role;
      const status = processingRequest.status;

      if (status === "PENDING_HOD_PROJECTS" && role === "HOD_PROJECTS") {
        hodApprove.mutate(processingRequest.id);
      } else if (status === "PENDING_OM" && role === "OPERATIONS_MANAGER") {
        omApprove.mutate(processingRequest.id);
      } else if (status === "PENDING_GM" && (role === "GENERAL_MANAGER" || (role === "CTO" && gmStatus?.isAway))) {
        gmApprove.mutate(processingRequest.id);
      } else if (status === "PENDING_ADMIN" && role === "ADMINISTRATOR") {
        adminApprove.mutate(processingRequest.id);
      }

      setIsProcessDialogOpen(false);
      setProcessingRequest(null);
      setRejectionReason("");
    }
  };

  const imageToDataUrl = async (src?: string): Promise<string | undefined> => {
    if (!src) return undefined;
    if (src.startsWith('data:')) return src;

    try {
      const response = await fetch(src);
      if (!response.ok) return undefined;
      const blob = await response.blob();
      return await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => {
          if (typeof reader.result === 'string') resolve(reader.result);
          else reject(new Error('Could not convert image to data URL'));
        };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    } catch (error) {
      console.warn('Failed to load signature image from URL:', src, error);
      return undefined;
    }
  };

  const handleDownloadPDF = async () => {
    if (!selectedRequest) return;

    console.log('[DEBUG] handleDownloadPDF called', { requestId: selectedRequest.id });

    try {
      // Fetch role signatures if available, but continue even if the endpoint is unavailable
      const roleSignatures: { [key: string]: string } = {};
      try {
        const roleSignaturesResponse = await api.get("/role-signatures");
        roleSignaturesResponse.data.data.signatures.forEach((sig: { role: string; signature: string }) => {
          roleSignatures[sig.role] = sig.signature;
        });
      } catch (signatureError) {
        console.warn("Unable to load role signatures for PDF generation:", signatureError);
      }

      const defaultRoleSignatures = {
        OPERATIONS_MANAGER: "/joram_OMsignature.png",
        HOD_PROJECTS: "/joshua_HODProjectssignature.png",
        GENERAL_MANAGER: "/willis_GMsignature.png",
        ADMINISTRATOR: undefined, // Always blank in PDF for manual CEO signature
      };

      const operationsSignature = await imageToDataUrl(
        roleSignatures.OPERATIONS_MANAGER || defaultRoleSignatures.OPERATIONS_MANAGER,
      );
      const hodSignature = await imageToDataUrl(
        roleSignatures.HOD_PROJECTS || defaultRoleSignatures.HOD_PROJECTS,
      );
      const gmSignature = await imageToDataUrl(
        roleSignatures.GENERAL_MANAGER || defaultRoleSignatures.GENERAL_MANAGER,
      );
      const adminSignature = await imageToDataUrl(
        roleSignatures.ADMINISTRATOR || defaultRoleSignatures.ADMINISTRATOR,
      );

      const filename = generateLeaveRequestPdf({
        id: selectedRequest.id,
        employeeName: selectedRequest.employeeName,
        employeePosition: selectedRequest.employeePosition,
        employeeDepartment: selectedRequest.employeeDepartment,
        leaveType: selectedRequest.leaveType,
        startDate: selectedRequest.startDate,
        endDate: selectedRequest.endDate,
        days: selectedRequest.days,
        reason: selectedRequest.reason,
        submittedDate: selectedRequest.submittedDate,
        status: selectedRequest.status,
        isScattered: selectedRequest.isScattered,
        scatteredDates: selectedRequest.scatteredDates,
        contactWhileOnLeave: selectedRequest.contactWhileOnLeave,
        handoverLineManager: selectedRequest.handoverLineManager,
        handoverCC: selectedRequest.handoverCC,
        handoverDepartment: selectedRequest.handoverDepartment,
        handoverWorkStatus: selectedRequest.handoverWorkStatus,
        handoverActions: selectedRequest.handoverActions,
        handoverRelationships: selectedRequest.handoverRelationships,
        omApprover: selectedRequest.omApprover,
        omApprovalDate: selectedRequest.omApprovalDate,
        gmApprover: selectedRequest.gmApprover,
        gmApprovalDate: selectedRequest.gmApprovalDate,
        rejectionReason: selectedRequest.rejectionReason,
        approverName: selectedRequest.approverName,
        approverSignatureDate: selectedRequest.approverSignatureDate,
        leaveBalances: selectedRequest.leaveBalances,
        roleSignatures: {
          OPERATIONS_MANAGER: operationsSignature,
          HOD_PROJECTS: hodSignature,
          GENERAL_MANAGER: gmSignature,
          ADMINISTRATOR: adminSignature,
        },
      });

      toast({
        title: "Success",
        description: `Corporate PDF generated: ${filename} ✓`,
      });
    } catch (error) {
      console.error("PDF generation error:", error);
      toast({
        variant: "destructive",
        title: "Error",
        description: "Failed to generate PDF",
      });
    }
  };

  // CSV Export Functions
  const formatDate = (dateString: string) => {
    return new Date(dateString).toLocaleDateString("en-CA"); // YYYY-MM-DD format
  };

  const formatStatus = (status: string) => {
    const statusMap: Record<string, string> = {
      PENDING_OM: "Pending OM Approval",
      PENDING_GM: "Pending General Manager Approval",
      APPROVED: "Approved",
      REJECTED_OM: "Rejected by OM",
      REJECTED_GM: "Rejected by General Manager",
    };
    return statusMap[status] || status;
  };

  const escapeCSV = (value: string | undefined | null): string => {
    if (value === undefined || value === null) return "";
    const str = String(value);
    // If the value contains comma, newline, or double quote, wrap in quotes and escape quotes
    if (str.includes(",") || str.includes("\n") || str.includes('"')) {
      return `"${str.replace(/"/g, '""')}"`;
    }
    return str;
  };

  const generateCSV = (requestsToExport: LeaveRequest[]): string => {
    const headers = [
      "Employee Name",
      "Position",
      "Leave Type",
      "Start Date",
      "End Date",
      "Is Scattered",
      "Scattered Dates",
      "Days",
      "Status",
      "Submitted Date",
      "OM Approval Date",
      "GM Approval Date",
      "Rejection Reason",
      "Reason/Description",
    ];

    const rows = requestsToExport.map((req) => [
      escapeCSV(req.employeeName),
      escapeCSV(req.employeePosition),
      escapeCSV(req.leaveType),
      formatDate(req.startDate),
      formatDate(req.endDate),
      req.isScattered ? "Yes" : "No",
      req.isScattered && req.scatteredDates
        ? escapeCSV(req.scatteredDates.join(", "))
        : "",
      String(req.days),
      formatStatus(req.status),
      formatDate(req.submittedDate),
      req.omApprovalDate ? formatDate(req.omApprovalDate) : "",
      req.gmApprovalDate ? formatDate(req.gmApprovalDate) : "",
      escapeCSV(req.rejectionReason),
      escapeCSV(req.reason),
    ]);

    return [headers.join(","), ...rows.map((row) => row.join(","))].join("\n");
  };

  const downloadCSV = (csvContent: string, filename: string) => {
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    const url = URL.createObjectURL(blob);
    link.setAttribute("href", url);
    link.setAttribute("download", filename);
    link.style.visibility = "hidden";
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  };

  const handleExportAll = () => {
    if (filteredRequests.length === 0) {
      toast({
        variant: "destructive",
        title: "No Data",
        description: "No leave requests to export",
      });
      return;
    }
    const csv = generateCSV(filteredRequests);
    const timestamp = new Date().toISOString().split("T")[0];
    downloadCSV(csv, `leave-requests-${timestamp}.csv`);
    toast({
      title: "Success",
      description: `Exported ${filteredRequests.length} leave request(s)`,
    });
  };

  const handleExportSelected = () => {
    const selectedList = filteredRequests.filter((req) =>
      selectedRequests.has(req.id),
    );
    if (selectedList.length === 0) {
      toast({
        variant: "destructive",
        title: "No Selection",
        description: "No requests selected for export",
      });
      return;
    }
    const csv = generateCSV(selectedList);
    const timestamp = new Date().toISOString().split("T")[0];
    downloadCSV(csv, `leave-requests-selected-${timestamp}.csv`);
    toast({
      title: "Success",
      description: `Exported ${selectedList.length} selected request(s)`,
    });
  };
  // Using requests directly as filtering is now done on the server
  const filteredRequests = requests;

  return (
    <DashboardLayout>
      <div className="space-y-6">
        <div className="flex flex-col gap-4">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h1 className="text-2xl sm:text-3xl font-bold">Leave Requests</h1>
              <p className="text-muted-foreground text-sm sm:text-base">
                Manage employee leave applications
              </p>
            </div>
            <div className="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
              <Button
                onClick={() => setIsReservationModalOpen(true)}
                className="gradient-primary w-full sm:w-auto"
              >
                <CalendarRange className="mr-2 h-4 w-4" /> Reserve Dates
              </Button>
              <Button
                onClick={() => {
                  setEditingRequest(null);
                  setStartDate("");
                  setEndDate("");
                  setDescription("");
                  setContactWhileOnLeave("");
                  setHandoverLineManager("");
                  setHandoverCC("");
                  setHandoverDepartment(user?.employee?.department || "");
                  setHandoverWorkStatus("");
                  setHandoverActions("");
                  setHandoverRelationships("");
                  setEmployeeSignature("");
                  setIsNewRequestOpen(true);
                }}
                className="gradient-primary w-full sm:w-auto"
              >
                <Plus className="mr-2 h-4 w-4" /> New Request
              </Button>
            </div>
          </div>
          <div className="flex flex-wrap items-center gap-2 sm:gap-3">
            <Filter className="h-5 w-5 text-muted-foreground hidden sm:block" />
            <Select value={statusFilter} onValueChange={setStatusFilter}>
              <SelectTrigger className="w-full sm:w-40 glass border-border/50">
                <SelectValue placeholder="Filter by status" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All Requests</SelectItem>
                <SelectItem value="PENDING_HOD_PROJECTS">Pending HOD</SelectItem>
                <SelectItem value="PENDING_OM">Pending OM</SelectItem>
                <SelectItem value="PENDING_GM">Pending GM</SelectItem>
                <SelectItem value="APPROVED">Approved</SelectItem>
                <SelectItem value="REJECTED_HOD">Rejected (HOD)</SelectItem>
                <SelectItem value="REJECTED_OM">Rejected (OM)</SelectItem>
                <SelectItem value="REJECTED_GM">Rejected (GM)</SelectItem>
              </SelectContent>
            </Select>
            {user?.role !== "EMPLOYEE" && (
              <Button
                onClick={handleExportAll}
                variant="outline"
                className="gap-2 border-border/50 w-full sm:w-auto"
              >
                <FileSpreadsheet className="h-4 w-4" />
                Export All
              </Button>
            )}
          </div>
        </div>

        {/* Year Leave Summary for Employees */}
        {user?.role === "EMPLOYEE" && (
          <motion.div
            initial={{ y: 20, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
          >
            <Card className="glass border-border/50 p-6">
              <h3 className="text-lg font-semibold mb-4">
                My Leave Summary - {new Date().getFullYear()}
              </h3>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {(() => {
                  const currentYear = new Date().getFullYear();
                  const yearLeaves = requests.filter((req: LeaveRequest) => {
                    const startYear = new Date(req.startDate).getFullYear();
                    return (
                      startYear === currentYear &&
                      (req.status === "APPROVED" ||
                        req.status === "PENDING_GM" ||
                        req.status === "PENDING_OM")
                    );
                  });

                  // Group by leave type
                  const leaveByType = yearLeaves.reduce(
                    (
                      acc: Record<
                        string,
                        {
                          count: number;
                          days: number;
                          requests: LeaveRequest[];
                        }
                      >,
                      req: LeaveRequest,
                    ) => {
                      if (!acc[req.leaveType]) {
                        acc[req.leaveType] = {
                          count: 0,
                          days: 0,
                          requests: [],
                        };
                      }
                      acc[req.leaveType].count += 1;
                      acc[req.leaveType].days += req.days;
                      acc[req.leaveType].requests.push(req);
                      return acc;
                    },
                    {},
                  );

                  const totalDays: number = Object.values(leaveByType).reduce(
                    (sum: number, type) => sum + type.days,
                    0,
                  );

                  return (
                    <>
                      <div className="p-4 rounded-xl bg-primary/5 border border-primary/20">
                        <p className="text-sm text-muted-foreground mb-1">
                          Total Leaves Taken
                        </p>
                        <p className="text-3xl font-bold text-primary">
                          {totalDays}
                        </p>
                        <p className="text-xs text-muted-foreground mt-1">
                          days this year
                        </p>
                      </div>

                      {Object.entries(leaveByType).map(([type, data]) => (
                        <div
                          key={type}
                          className="p-4 rounded-xl bg-background/50 border border-border/50"
                        >
                          <p className="text-sm text-muted-foreground mb-1 capitalize">
                            {type.toLowerCase().replace("_", " ")}
                          </p>
                          <p className="text-2xl font-bold">{data.days}</p>
                          <p className="text-xs text-muted-foreground mt-1">
                            {data.count} request{data.count === 1 ? "" : "s"}
                          </p>
                        </div>
                      ))}

                      {Object.keys(leaveByType).length === 0 && (
                        <div className="col-span-full text-center py-8 text-muted-foreground">
                          <p>No leaves taken in {currentYear} yet</p>
                        </div>
                      )}
                    </>
                  );
                })()}
              </div>
            </Card>
          </motion.div>
        )}

        {/* Advanced Filters Card */}
        <motion.div
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
        >
          <Card className="glass border-border/50 p-4">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
              <div className="relative">
                <Input
                  placeholder="Search by employee name..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="pl-3"
                />
              </div>

              <Select
                value={leaveTypeFilter}
                onValueChange={setLeaveTypeFilter}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Leave Type" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">All Types</SelectItem>
                  <SelectItem value="ANNUAL">Annual Leave</SelectItem>
                  <SelectItem value="SICK">Sick Leave</SelectItem>
                  <SelectItem value="MATERNITY">Maternity Leave</SelectItem>
                  <SelectItem value="PATERNITY">Paternity Leave</SelectItem>
                </SelectContent>
              </Select>

              <div className="space-y-1">
                <Label className="text-xs text-muted-foreground">
                  From Date
                </Label>
                <Input
                  type="date"
                  value={dateFrom}
                  onChange={(e) => setDateFrom(e.target.value)}
                />
              </div>

              <div className="space-y-1">
                <Label className="text-xs text-muted-foreground">To Date</Label>
                <Input
                  type="date"
                  value={dateTo}
                  onChange={(e) => setDateTo(e.target.value)}
                />
              </div>

              {user?.role !== "EMPLOYEE" && employeesData && (
                <Select
                  value={employeeFilter}
                  onValueChange={setEmployeeFilter}
                >
                  <SelectTrigger>
                    <SelectValue placeholder="All Employees" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">All Employees</SelectItem>
                    {employeesData.map(
                      (emp: {
                        id: string;
                        user?: { name: string };
                        name?: string;
                      }) => (
                        <SelectItem key={emp.id} value={emp.id}>
                          {emp.user?.name || emp.name}
                        </SelectItem>
                      ),
                    )}
                  </SelectContent>
                </Select>
              )}

              <Button
                variant="outline"
                onClick={() => {
                  setSearchQuery("");
                  setLeaveTypeFilter("all");
                  setDateFrom("");
                  setDateTo("");
                  setStatusFilter("all");
                  setEmployeeFilter("all");
                }}
                className="h-full"
              >
                Clear Filters
              </Button>
            </div>

            {/* Active Filters Display */}
            {(searchQuery ||
              leaveTypeFilter !== "all" ||
              dateFrom ||
              dateTo ||
              statusFilter !== "all" ||
              employeeFilter !== "all") && (
              <div className="mt-3 flex flex-wrap gap-2">
                <span className="text-xs text-muted-foreground">
                  Active filters:
                </span>
                {statusFilter !== "all" && (
                  <Badge variant="secondary" className="text-xs">
                    Status: {statusFilter}
                  </Badge>
                )}
                {searchQuery && (
                  <Badge variant="secondary" className="text-xs">
                    Search: {searchQuery}
                  </Badge>
                )}
                {leaveTypeFilter !== "all" && (
                  <Badge variant="secondary" className="text-xs">
                    Type: {leaveTypeFilter}
                  </Badge>
                )}
                {employeeFilter !== "all" && (
                  <Badge variant="secondary" className="text-xs">
                    Employee:{" "}
                    {employeesData?.find(
                      (e: { id: string; user?: { name: string } }) =>
                        e.id === employeeFilter,
                    )?.user?.name || "Selected"}
                  </Badge>
                )}
                {dateFrom && (
                  <Badge variant="secondary" className="text-xs">
                    From: {new Date(dateFrom).toLocaleDateString()}
                  </Badge>
                )}
                {dateTo && (
                  <Badge variant="secondary" className="text-xs">
                    To: {new Date(dateTo).toLocaleDateString()}
                  </Badge>
                )}
              </div>
            )}
          </Card>
        </motion.div>

        {/* Bulk Actions Toolbar */}
        {selectedRequests.size > 0 && (
          <motion.div
            initial={{ y: -20, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
          >
            <Card className="glass border-border/50 p-4 bg-primary/5">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-4">
                  <span className="text-sm font-medium">
                    {selectedRequests.size} request(s) selected
                  </span>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => setSelectedRequests(new Set())}
                  >
                    Clear Selection
                  </Button>
                </div>
                <div className="flex items-center gap-2">
                  {user?.role === "OPERATIONS_MANAGER" && (
                    <Button
                      size="sm"
                      className="gradient-primary text-white"
                      onClick={() =>
                        bulkApprove.mutate(Array.from(selectedRequests))
                      }
                      disabled={bulkApprove.isPending || bulkReject.isPending}
                    >
                      <CheckCircle className="h-4 w-4 mr-1" />
                      {bulkApprove.isPending
                        ? "Approving..."
                        : "Approve Selected"}
                    </Button>
                  )}
                  {(user?.role === "OPERATIONS_MANAGER" ||
                    user?.role === "GENERAL_MANAGER") && (
                    <Button
                      size="sm"
                      variant="destructive"
                      onClick={() => setIsBulkRejectOpen(true)}
                      disabled={bulkApprove.isPending || bulkReject.isPending}
                    >
                      <XCircle className="h-4 w-4 mr-1" />
                      {bulkReject.isPending
                        ? "Rejecting..."
                        : "Reject Selected"}
                    </Button>
                  )}
                  <Button
                    size="sm"
                    variant="outline"
                    onClick={handleExportSelected}
                    className="gap-1 border-border/50"
                  >
                    <FileSpreadsheet className="h-4 w-4" />
                    Export Selected
                  </Button>
                </div>
              </div>
            </Card>
          </motion.div>
        )}

        <motion.div
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
        >
          <Card className="glass border-border/50 overflow-hidden">
            {/* Desktop Table View */}
            <div className="hidden md:block overflow-x-auto">
              <table className="w-full">
                <thead className="bg-muted/30 border-b border-border/50">
                  <tr>
                    <th className="text-left p-4 font-semibold w-12">
                      <input
                        type="checkbox"
                        checked={
                          selectedRequests.size === filteredRequests.length &&
                          filteredRequests.length > 0
                        }
                        onChange={handleSelectAll}
                        className="w-4 h-4 rounded border-border"
                      />
                    </th>
                    <th className="text-left p-4 font-semibold">Employee</th>
                    <th className="text-left p-4 font-semibold">Type</th>
                    <th className="text-left p-4 font-semibold">Duration</th>
                    <th className="text-left p-4 font-semibold">Days</th>
                    <th className="text-left p-4 font-semibold">Status</th>
                    <th className="text-left p-4 font-semibold">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {isLoading ? (
                    Array.from({ length: 5 }).map((_, i) => (
                      <motion.tr
                        key={i}
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 1 }}
                        className="border-b border-border/10 h-24"
                      >
                        <td className="p-4" colSpan={7}>
                          <div className="flex items-center gap-4 animate-pulse">
                            <div className="w-12 h-12 rounded-2xl bg-muted/40" />
                            <div className="space-y-2">
                              <div className="h-4 w-32 bg-muted/40 rounded" />
                              <div className="h-3 w-24 bg-muted/40 rounded" />
                            </div>
                          </div>
                        </td>
                      </motion.tr>
                    ))
                  ) : (
                    filteredRequests.map((request: LeaveRequest, index: number) => (
                      <motion.tr
                        key={request.id}
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 1 }}
                        transition={{ delay: index * 0.05 }}
                        className="border-b border-border/30 hover:bg-accent/30 transition-colors group cursor-pointer"
                      >
                        <td className="p-4">
                          <input
                            type="checkbox"
                            checked={selectedRequests.has(request.id)}
                            onChange={() => handleSelectRequest(request.id)}
                            className="w-4 h-4 rounded border-border"
                            onClick={(e) => e.stopPropagation()}
                          />
                        </td>
                        <td className="p-4">
                          <div className="flex items-center gap-3">
                            <Avatar className="w-10 h-10 border border-primary/10">
                              <AvatarImage
                                src={request.employeeAvatar}
                                alt={request.employeeName}
                              />
                              <AvatarFallback className="bg-[#111111] text-white font-bold text-xs uppercase">
                                {getInitials(request.employeeName)}
                              </AvatarFallback>
                            </Avatar>
                            <div>
                              <p className="font-medium">
                                {request.employeeName}
                              </p>
                              <p className="text-xs text-muted-foreground">
                                {request.employeePosition}
                              </p>
                            </div>
                          </div>
                        </td>
                        <td className="p-4">
                          <Badge variant="outline" className="capitalize">
                            {request.leaveType}
                          </Badge>
                        </td>
                        <td className="p-4">
                          <p className="text-sm">
                            {new Date(request.startDate).toLocaleDateString()}
                          </p>
                          <p className="text-xs text-muted-foreground">
                            to {new Date(request.endDate).toLocaleDateString()}
                          </p>
                        </td>
                        <td className="p-4">
                          <span className="font-medium">
                            {request.days} days
                          </span>
                          {request.isScattered && (
                            <span className="ml-1 text-xs text-primary font-normal">
                              (Scattered)
                            </span>
                          )}
                        </td>
                        <td className="p-4">
                          <StatusBadge status={request.status} />
                        </td>
                        <td className="p-4">
                          <div className="flex items-center gap-2">
                            <Button
                              size="sm"
                              variant="outline"
                              className="h-9 px-3 border-border/50 hover:bg-accent/50 transition-all duration-200"
                              onClick={() => setSelectedRequest(request)}
                            >
                              <Eye className="h-4 w-4 mr-1" />
                              <span className="text-xs">View</span>
                            </Button>

                            {request.status === "PENDING_HOD_PROJECTS" &&
                              user?.role === "HOD_PROJECTS" && (
                                <button
                                  className="h-9 px-3 rounded-md bg-green-600 hover:bg-green-700 text-white shadow-md transition-all duration-200 flex items-center gap-1"
                                  onClick={() => hodApprove.mutate(request.id)}
                                  disabled={
                                    hodApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4" />
                                  <span className="text-xs font-medium">
                                    {hodApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}
                                  </span>

                                </button>
                              )}

                            {request.status === "PENDING_OM" &&
                              user?.id === request.employeeId && (
                                <Button
                                  size="sm"
                                  variant="outline"
                                  className="h-9 px-3 border-border/50 hover:bg-accent/50 transition-all duration-200"
                                  onClick={() => handleEditClick(request)}
                                >
                                  <span className="text-xs">Edit</span>
                                </Button>
                              )}

                            {request.status === "PENDING_OM" &&
                              user?.role === "OPERATIONS_MANAGER" && (
                                <Button
                                  size="sm"
                                  className="h-9 px-3 gradient-success text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                  onClick={() => omApprove.mutate(request.id)}
                                  disabled={
                                    omApprove.isPending ||
                                    gmApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4 mr-1" />
                                  <span className="text-xs font-medium">
                                    {omApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}

                                  </span>
                                </Button>
                              )}

                            {request.status === "PENDING_GM" &&
                              user?.role === "GENERAL_MANAGER" && (
                                <Button
                                  size="sm"
                                  className="h-9 px-3 gradient-success text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                  onClick={() => gmApprove.mutate(request.id)}
                                  disabled={
                                    omApprove.isPending ||
                                    gmApprove.isPending ||
                                    adminApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4 mr-1" />
                                  <span className="text-xs font-medium">
                                    {gmApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}
                                  </span>

                                </Button>
                              )}

                            {request.status === "PENDING_ADMIN" &&
                              user?.role === "ADMINISTRATOR" &&
                              user?.employee?.id !== request.employeeId && (
                                <Button
                                  size="sm"
                                  className="h-9 px-3 gradient-success text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                  onClick={() => adminApprove.mutate(request.id)}
                                  disabled={
                                    omApprove.isPending ||
                                    gmApprove.isPending ||
                                    adminApprove.isPending ||
                                    reject.isPending
                                  }
                                >
                                  <CheckCircle className="h-4 w-4 mr-1" />
                                  <span className="text-xs font-medium">
                                    {adminApprove.isPending
                                      ? "Approving..."
                                      : "Approve"}
                                  </span>

                                </Button>
                              )}

                            {((request.status === "PENDING_HOD_PROJECTS" &&
                              user?.role === "HOD_PROJECTS") ||
                              (request.status === "PENDING_OM" &&
                              user?.role === "OPERATIONS_MANAGER") ||
                              (request.status === "PENDING_GM" &&
                                user?.role === "GENERAL_MANAGER") ||
                              (request.status === "PENDING_ADMIN" &&
                                user?.role === "ADMINISTRATOR" &&
                                  user?.employee?.id !== request.employeeId)) && (
                              <Button
                                size="sm"
                                className="h-9 px-3 gradient-destructive text-white border-0 shadow-md hover:shadow-lg transition-all duration-200"
                                onClick={() =>
                                  openProcessDialog(request, "rejected")
                                }
                                disabled={
                                  omApprove.isPending ||
                                  gmApprove.isPending ||
                                  adminApprove.isPending ||
                                  reject.isPending
                                }
                              >
                                <XCircle className="h-4 w-4 mr-1" />
                                <span className="text-xs font-medium">
                                  {reject.isPending ? "Rejecting..." : "Reject"}
                                </span>
                              </Button>
                            )}
                          </div>
                        </td>
                      </motion.tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>

            {/* Mobile Card View */}
            <div className="md:hidden divide-y divide-border/30">
              {isLoading ? (
                Array.from({ length: 4 }).map((_, i) => (
                  <div key={i} className="p-4 space-y-4 animate-pulse">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-full bg-muted/40" />
                      <div className="space-y-2 flex-1">
                        <div className="h-4 w-1/2 bg-muted/40 rounded" />
                        <div className="h-3 w-1/3 bg-muted/40 rounded" />
                      </div>
                      <div className="w-16 h-6 rounded-full bg-muted/40" />
                    </div>
                    <div className="grid grid-cols-2 gap-4">
                      <div className="h-10 bg-muted/40 rounded-xl" />
                      <div className="h-10 bg-muted/40 rounded-xl" />
                    </div>
                  </div>
                ))
              ) : filteredRequests.length === 0 ? (
                <div className="p-12 text-center text-muted-foreground">
                  <p className="text-sm font-medium">No requests found</p>
                </div>
              ) : (
                filteredRequests.map((request: LeaveRequest, index: number) => (
                <motion.div
                  key={request.id}
                  initial={{ opacity: 0, x: -10 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: index * 0.05 }}
                  className="p-4 space-y-4 hover:bg-accent/10 transition-colors"
                >
                  <div className="flex items-start justify-between">
                    <div className="flex items-center gap-3">
                      <input
                        type="checkbox"
                        checked={selectedRequests.has(request.id)}
                        onChange={() => handleSelectRequest(request.id)}
                        className="w-4 h-4 rounded border-border"
                      />
                      <Avatar className="w-10 h-10 border border-primary/10">
                        <AvatarImage
                          src={request.employeeAvatar}
                          alt={request.employeeName}
                        />
                        <AvatarFallback className="bg-[#111111] text-white font-bold text-xs uppercase">
                          {getInitials(request.employeeName)}
                        </AvatarFallback>
                      </Avatar>
                      <div>
                        <p className="font-bold text-sm">{request.employeeName}</p>
                        <p className="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                          {request.employeePosition}
                        </p>
                      </div>
                    </div>
                    <StatusBadge status={request.status} />
                  </div>

                  <div className="grid grid-cols-2 gap-4 py-2">
                    <div className="space-y-1">
                      <p className="text-[10px] text-muted-foreground uppercase font-black tracking-widest">
                        Leave Type
                      </p>
                      <Badge
                        variant="outline"
                        className="capitalize text-[11px] font-bold border-primary/20 bg-primary/5"
                      >
                        {request.leaveType?.replace("_", " ")}
                      </Badge>
                    </div>
                    <div className="space-y-1">
                      <p className="text-[10px] text-muted-foreground uppercase font-black tracking-widest">
                        Duration
                      </p>
                      <p className="text-xs font-bold">
                        {request.days} Days{" "}
                        {request.isScattered && (
                          <span className="text-primary font-black">(S)</span>
                        )}
                      </p>
                    </div>
                    <div className="col-span-2 space-y-1">
                      <p className="text-[10px] text-muted-foreground uppercase font-black tracking-widest">
                        Timeline
                      </p>
                      <div className="flex items-center gap-2 text-xs font-bold">
                        <span>{new Date(request.startDate).toLocaleDateString()}</span>
                        <span className="text-muted-foreground">→</span>
                        <span>{new Date(request.endDate).toLocaleDateString()}</span>
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center gap-2 pt-2 overflow-x-auto pb-1 scrollbar-none">
                    <Button
                      size="sm"
                      variant="outline"
                      className="h-9 px-3 border-border/50 bg-background shadow-sm shrink-0"
                      onClick={() => setSelectedRequest(request)}
                    >
                      <Eye className="h-4 w-4 mr-1.5" />
                      View
                    </Button>

                    {request.status === "PENDING_HOD_PROJECTS" && user?.role === "HOD_PROJECTS" && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={hodApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        Approve
                      </Button>
                    )}

                    {request.status === "PENDING_OM" && user?.role === "OPERATIONS_MANAGER" && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={omApprove.isPending || gmApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        Approve
                      </Button>
                    )}

                    {request.status === "PENDING_GM" && 
                      (user?.role === "GENERAL_MANAGER" || (user?.role === "CTO" && gmStatus?.isAway)) && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={omApprove.isPending || gmApprove.isPending || adminApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        {user?.role === "CTO" ? "Endorse (for GM)" : "Approve"}
                      </Button>
                    )}

                    {request.status === "PENDING_ADMIN" && user?.role === "ADMINISTRATOR" && user?.employee?.id !== request.employeeId && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-success text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "approved")}
                        disabled={omApprove.isPending || gmApprove.isPending || adminApprove.isPending || reject.isPending}
                      >
                        <CheckCircle className="h-4 w-4 mr-1.5" />
                        Approve
                      </Button>
                    )}

                    {((request.status === "PENDING_OM" && user?.role === "OPERATIONS_MANAGER") ||
                      (request.status === "PENDING_GM" && (user?.role === "GENERAL_MANAGER" || (user?.role === "CTO" && gmStatus?.isAway))) ||
                      (request.status === "PENDING_ADMIN" && user?.role === "ADMINISTRATOR" && user?.employee?.id !== request.employeeId)) && (
                      <Button
                        size="sm"
                        className="h-9 px-3 gradient-destructive text-white border-0 shadow-md shrink-0"
                        onClick={() => openProcessDialog(request, "rejected")}
                        disabled={omApprove.isPending || gmApprove.isPending || adminApprove.isPending || reject.isPending}
                      >
                        <XCircle className="h-4 w-4 mr-1.5" />
                        Reject
                      </Button>
                    )}
                  </div>
                </motion.div>
              )))}

              {filteredRequests.length === 0 && (
                <div className="p-12 text-center text-muted-foreground">
                  <p className="text-sm font-medium">No requests found</p>
                </div>
              )}
            </div>
          </Card>

          {/* Pagination Controls */}
          {paginatedData && paginatedData.totalPages > 1 && (
            <div className="flex items-center justify-between mt-6">
              <div className="flex items-center gap-4">
                <p className="text-sm text-muted-foreground">
                  Showing{" "}
                  <span className="font-medium">
                    {(currentPage - 1) * itemsPerPage + 1}
                  </span>{" "}
                  to{" "}
                  <span className="font-medium">
                    {Math.min(currentPage * itemsPerPage, paginatedData.total)}
                  </span>{" "}
                  of <span className="font-medium">{paginatedData.total}</span>{" "}
                  requests
                </p>
                <Select
                  value={itemsPerPage.toString()}
                  onValueChange={(value) => {
                    setItemsPerPage(Number(value));
                    setCurrentPage(1);
                  }}
                >
                  <SelectTrigger className="w-32">
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="10">10 per page</SelectItem>
                    <SelectItem value="20">20 per page</SelectItem>
                    <SelectItem value="50">50 per page</SelectItem>
                    <SelectItem value="100">100 per page</SelectItem>
                  </SelectContent>
                </Select>
              </div>

              <div className="flex items-center gap-2">
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() =>
                    setCurrentPage((prev) => Math.max(1, prev - 1))
                  }
                  disabled={!paginatedData.hasPrevPage || isLoading}
                >
                  Previous
                </Button>
                <div className="flex items-center gap-1">
                  {Array.from(
                    { length: Math.min(5, paginatedData.totalPages) },
                    (_, i) => {
                      let pageNum;
                      if (paginatedData.totalPages <= 5) {
                        pageNum = i + 1;
                      } else if (currentPage <= 3) {
                        pageNum = i + 1;
                      } else if (currentPage >= paginatedData.totalPages - 2) {
                        pageNum = paginatedData.totalPages - 4 + i;
                      } else {
                        pageNum = currentPage - 2 + i;
                      }
                      return (
                        <Button
                          key={pageNum}
                          variant={
                            currentPage === pageNum ? "default" : "outline"
                          }
                          size="sm"
                          onClick={() => setCurrentPage(pageNum)}
                          className="w-10"
                        >
                          {pageNum}
                        </Button>
                      );
                    },
                  )}
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() =>
                    setCurrentPage((prev) =>
                      Math.min(paginatedData.totalPages, prev + 1),
                    )
                  }
                  disabled={!paginatedData.hasNextPage || isLoading}
                >
                  Next
                </Button>
              </div>
            </div>
          )}
        </motion.div>
      </div>

      {/* View Details Dialog */}
      <Dialog
        open={!!selectedRequest}
        onOpenChange={() => setSelectedRequest(null)}
      >
        <DialogContent className="glass border-border/50 max-h-[85vh] overflow-y-auto max-w-3xl">
          <DialogHeader className="flex flex-row items-center justify-between">
            <div>
              <DialogTitle>Leave Request Details</DialogTitle>
              <DialogDescription>
                Request ID: {selectedRequest?.id}
              </DialogDescription>
            </div>
            {selectedRequest && (
              <Button
                onClick={handleDownloadPDF}
                variant="outline"
                size="sm"
                className="gap-2"
              >
                <Download className="h-4 w-4" />
                Download PDF
              </Button>
            )}
          </DialogHeader>
          {selectedRequest && (
            <div
              ref={detailsRef}
              style={{
                backgroundColor: "#FFFFFF",
                fontFamily: '"Times New Roman", Times, serif',
                color: "#1a1a2e",
                width: "100%",
                padding: "0",
              }}
            >
              {/* ═══ HEADER ═══ */}
              <div
                style={{
                  padding: "32px 32px 16px 32px",
                  background: "#ffffff",
                  borderBottom: "3px solid #000000",
                  textAlign: "center"
                }}
              >
                {/* ═══ QUADRANT HEADER (Monochrome) ═══ */}
                <div style={{ display: "flex", flexDirection: "column", gap: "12px" }}>
                  {/* Top Quadrant: Logo & Title/Ref */}
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                    <div style={{ textAlign: "left" }}>
                      <img
                        src="/company-logo.jpg"
                        alt="Logo"
                        loading="lazy"
                        style={{ height: "32px", width: "auto" }}
                      />
                    </div>
                    <div style={{ textAlign: "right" }}>
                      <p style={{ color: "#000", fontSize: "22px", fontWeight: "900", margin: 0, textTransform: "uppercase", letterSpacing: "0.5px" }}>
                        LEAVE APPLICATION FORM
                      </p>
                      <p style={{ color: "#666", fontSize: "11px", fontWeight: "500", margin: "2px 0 0 0" }}>
                        {`No: ADC-LVE-${new Date(selectedRequest.submittedDate).toISOString().substring(0,7).replace('-', '')}-A${selectedRequest.requestNumber ? String(selectedRequest.requestNumber).padStart(2, '0') : '01'} | Date: ${new Date(selectedRequest.submittedDate).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}`}
                      </p>
                    </div>
                  </div>

                  {/* Bottom Quadrant: Company Details */}
                  <div style={{ textAlign: "left", marginTop: "4px" }}>
                    <p style={{ color: "#111", fontSize: "14px", fontWeight: "bold", margin: 0 }}>
                      AlanDick East Africa Ltd.
                    </p>
                    <p style={{ color: "#666", fontSize: "11px", margin: "2px 0 0 0" }}>
                      P.O Box 12907, Muthithi Rd, Nairobi, Kenya.
                    </p>
                    <p style={{ color: "#666", fontSize: "11px", margin: 0 }}>
                      Tel: 254 722 570 112 | Email: admin@alandick.co.ke
                    </p>
                  </div>

                  {/* Thick Black Separator Line */}
                  <div style={{ height: "3px", backgroundColor: "#000", width: "100%", marginTop: "4px" }} />
                </div>
              </div>

              {/* ═══ BODY CONTENT ═══ */}
              <div style={{ padding: "32px" }}>
                {/* 1. EMPLOYEE DETAILS */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>1. Employee Details</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", padding: "20px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                    <div>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "4px", fontWeight: "600" }}>Full Name of Applicant</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.employeeName?.toUpperCase()}</p>
                    </div>
                    <div>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "4px", fontWeight: "600" }}>Position / Designation</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.employeePosition?.toUpperCase()}</p>
                    </div>
                  </div>
                </div>

                {/* 2. LEAVE BALANCE SUMMARY */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>2. Leave Balance Summary</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "12px" }}>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Annual Leave Balance</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.leaveBalances?.annual ?? '-'} DAYS</p>
                    </div>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Sick Leave Balance</p>
                      <p style={{ fontSize: "18px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.leaveBalances?.sick ?? '-'} DAYS</p>
                    </div>
                  </div>
                </div>

                {/* 3. LEAVE DETAILS */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>3. Leave Details</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "1.2fr 1.5fr 0.8fr", gap: "12px" }}>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Category</p>
                      <p style={{ fontSize: "16px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.leaveType.replace(/_/g, ' ')}</p>
                    </div>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Period</p>
                      <p style={{ fontSize: "16px", fontWeight: "800", color: "#111", margin: 0 }}>{fmtDate(selectedRequest.startDate)} — {fmtDate(selectedRequest.endDate)}</p>
                    </div>
                    <div style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                      <p style={{ fontSize: "11px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Days</p>
                      <p style={{ fontSize: "16px", fontWeight: "800", color: "#111", margin: 0 }}>{selectedRequest.days} {selectedRequest.days === 1 ? 'DAY' : 'DAYS'}</p>
                    </div>
                  </div>
                </div>

                {/* 3. REASON */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>4. Declaration of Reason</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ padding: "20px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                    <p style={{ fontSize: "16px", color: "#111", fontStyle: "italic", margin: 0, lineHeight: "1.6" }}>"{selectedRequest.reason}"</p>
                  </div>
                </div>

                {/* 4. CONTACT & HANDOVER */}
                <div style={{ marginBottom: "28px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>5. Contact &amp; Handover</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: "12px" }}>
                    {[
                      { l: "Contact", v: selectedRequest.contactWhileOnLeave },
                      { l: "Line Manager", v: selectedRequest.handoverLineManager },
                      { l: "Handover To", v: selectedRequest.handoverCC },
                      { l: "Department", v: selectedRequest.handoverDepartment },
                    ].map((f, i) => (
                      <div key={i} style={{ padding: "12px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                        <p style={{ fontSize: "9px", color: "#666", textTransform: "uppercase", marginBottom: "4px", fontWeight: "600" }}>{f.l}</p>
                        <p style={{ fontSize: "13px", fontWeight: "700", color: "#111", margin: 0 }}>{f.v || "—"}</p>
                      </div>
                    ))}
                  </div>
                </div>

                {/* 5. HANDOVER REPORT DETAILS */}
                {(selectedRequest.handoverWorkStatus || selectedRequest.handoverActions || selectedRequest.handoverRelationships) && (
                  <div style={{ marginBottom: "28px" }}>
                    <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>6. Handover Report Details</p>
                    <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                    <div style={{ display: "flex", flexDirection: "column", gap: "10px" }}>
                      {[
                        { l: "Background & Work Status", v: selectedRequest.handoverWorkStatus },
                        { l: "Required Actions / Follow Up", v: selectedRequest.handoverActions },
                        { l: "Contact while on leave", v: selectedRequest.handoverRelationships },
                      ].filter(h => h.v).map((h, i) => (
                        <div key={i} style={{ padding: "16px", border: "1px solid #e5e7eb", background: "#ffffff" }}>
                          <p style={{ fontSize: "10px", fontWeight: "800", color: "#666", textTransform: "uppercase", marginBottom: "6px" }}>{h.l}</p>
                          <p style={{ fontSize: "15px", color: "#111", lineHeight: "1.6", margin: 0 }}>{h.v}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 6. AUTHORIZATION */}
                <div style={{ marginBottom: "16px" }}>
                  <p style={{ fontSize: "13px", fontWeight: "800", color: "#111", textTransform: "uppercase", letterSpacing: "1.5px", margin: "0 0 6px 0" }}>7. Authorization Signatures</p>
                  <div style={{ height: "1.5px", backgroundColor: "#111", marginBottom: "12px" }} />
                  
                  <div style={{ border: "1px solid #e5e7eb" }}>
                    {[
                      { role: selectedRequest.employeeDepartment?.toUpperCase() === 'PROJECTS' ? '1. HOD PROJECTS' : '1. OM', name: selectedRequest.omApprover?.name || (selectedRequest.employeeDepartment?.toUpperCase() === 'PROJECTS' ? 'HOD Projects' : 'Operations Manager'), date: selectedRequest.omApprovalDate, sig: selectedRequest.omApprover?.signature },
                      { role: "2. GM", name: selectedRequest.gmApprover?.name || "General Manager", date: selectedRequest.gmApprovalDate, sig: selectedRequest.gmApprover?.signature },
                      { role: "3. Admin", name: selectedRequest.approverName || "Administrator", date: selectedRequest.approverSignatureDate, sig: selectedRequest.approverSignature }
                    ].map((row, i, arr) => (
                      <div key={i} style={{ display: "flex", borderBottom: i < arr.length - 1 ? "1px solid #e5e7eb" : "none" }}>
                        <div style={{ width: "100px", padding: "16px", backgroundColor: "#fcfcfc", fontWeight: "900", fontSize: "13px", borderRight: "1px solid #e5e7eb", display: "flex", alignItems: "center", justifyContent: "center" }}>
                          {row.role}
                        </div>
                        <div style={{ flex: 1, padding: "16px", borderRight: "1px solid #e5e7eb" }}>
                          <p style={{ fontSize: "9px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Signature / Approval</p>
                          <div style={{ minHeight: "36px", display: "flex", alignItems: "center" }}>
                            {(() => {
                              const signatureSrc = row.sig || (row.date ? (() => {
                                if (row.role.includes('HOD PROJECTS')) return '/joshua_HODProjectssignature.png';
                                if (row.role.includes('OM')) return '/joram_OMsignature.png';
                                if (row.role.includes('GM')) return '/willis_GMsignature.png';
                                if (row.role.includes('Admin')) return '/mercy_signature.png';
                                return null;
                              })() : null);

                              if (signatureSrc) {
                                return <img src={signatureSrc} alt="Sig" style={{ maxHeight: "36px", width: "auto" }} />;
                              }
                              return (
                                <p style={{ fontSize: "16px", fontWeight: "800", color: row.date ? "#111" : "#ccc", fontStyle: "italic", margin: 0 }}>
                                  {row.date ? row.name : "—"}
                                </p>
                              );
                            })()}
                          </div>
                        </div>
                        <div style={{ width: "160px", padding: "16px" }}>
                          <p style={{ fontSize: "9px", color: "#666", textTransform: "uppercase", marginBottom: "6px", fontWeight: "600" }}>Date</p>
                          <p style={{ fontSize: "15px", fontWeight: "800", color: row.date ? "#111" : "#ccc", margin: 0 }}>{row.date ? fmtDate(row.date) : "—"}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* ═══ FOOTER ═══ */}
              <div
                style={{
                  padding: "20px 32px",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  borderTop: "3px solid #000000",
                  marginTop: "auto"
                }}
              >
                <p style={{ fontSize: "10px", fontWeight: "700", color: "#111", margin: 0, letterSpacing: "1px", textTransform: "uppercase" }}>Official Document</p>
                <p style={{ fontSize: "10px", color: "#111", fontWeight: "600", margin: 0 }}>AlanDick &amp; Company (EA) Ltd • Leave Management System</p>
                <p style={{ fontSize: "10px", color: "#111", fontWeight: "700", margin: 0 }}>{new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}</p>
              </div>
            </div>
          )}
        </DialogContent>
      </Dialog>

      {/* Process Request Dialog */}
      <Dialog open={isProcessDialogOpen} onOpenChange={setIsProcessDialogOpen}>
        <DialogContent className="glass border-border/50">
          <DialogHeader>
            <DialogTitle>Process Leave Request</DialogTitle>
            <DialogDescription>
              {processAction === "approved" ? "Approve" : "Reject"} request for{" "}
              {processingRequest?.employeeName}
            </DialogDescription>
          </DialogHeader>

          <form onSubmit={handleProcessRequest} className="space-y-4">
            <div className="space-y-2">
              <Label>{processAction === "approved" ? "Comments" : "Reason for Refusal"}</Label>
              <Textarea
                value={rejectionReason}
                onChange={(e) => setRejectionReason(e.target.value)}
                placeholder={processAction === "approved" ? "Add any approval comments..." : "Please state the reason for refusal..."}
                required={processAction === "rejected"}
              />
            </div>

            <DialogFooter>
              <Button
                type="button"
                variant="ghost"
                onClick={() => setIsProcessDialogOpen(false)}
              >
                Cancel
              </Button>
              <Button
                type="submit"
                className={
                  processAction === "approved"
                    ? "bg-green-600 hover:bg-green-700"
                    : "bg-red-600 hover:bg-red-700"
                }
                disabled={reject.isPending}
              >
                {(() => {
                  if (reject.isPending) return "Processing...";
                  return `Confirm ${processAction === "approved" ? "Approval" : "Rejection"}`;
                })()}
              </Button>
            </DialogFooter>
          </form>
        </DialogContent>
      </Dialog>

      {/* New Request Dialog */}
      <Dialog open={isNewRequestOpen} onOpenChange={setIsNewRequestOpen}>
        <DialogContent className="glass border-border/50 max-h-[90vh] p-0 overflow-hidden flex flex-col w-[95vw] sm:max-w-2xl">
          <div className="p-6 pb-2">
            <DialogHeader>
              <DialogTitle>
                {editingRequest ? "Edit Leave Request" : "New Leave Request"}
              </DialogTitle>
              <DialogDescription>
                {editingRequest
                  ? "Update your leave request details"
                  : "Submit a new leave request for approval"}
              </DialogDescription>
            </DialogHeader>
          </div>

          {reservationId && !editingRequest && (
            <div className="mx-6 mt-2 p-3 bg-green-500/10 border border-green-500/20 rounded-lg flex items-center gap-3 text-green-600">
              <div className="bg-green-500 text-white rounded-full p-1">
                <CheckCircle className="h-3 w-3" />
              </div>
              <div className="text-xs">
                <p className="font-bold">Pre-Approved Period</p>
                <p className="opacity-80">This slot was already cleared by Management via Reservation. Finalizing now...</p>
              </div>
            </div>
          )}

          <form onSubmit={handleCreateRequest} className="flex flex-col flex-1 overflow-hidden">
            <div className="flex-1 overflow-y-auto p-6 pt-2 space-y-6">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className="space-y-2 flex flex-col">
                  <Label>Start Date</Label>
                  <Popover>
                    <PopoverTrigger asChild>
                      <Button
                        variant={"outline"}
                        className={cn(
                          "w-full justify-start text-left font-normal border-border/50",
                          !startDate && "text-muted-foreground"
                        )}
                      >
                        <CalendarIcon className="mr-2 h-4 w-4" />
                        {startDate ? format(new Date(startDate + "T00:00:00"), "PPP") : <span>Pick a date</span>}
                      </Button>
                    </PopoverTrigger>
                    <PopoverContent className="w-auto p-0" align="start">
                      <Calendar
                        mode="single"
                        selected={startDate ? new Date(startDate + "T00:00:00") : undefined}
                        onSelect={(d) => {
                          if (d) {
                            const dateStr = format(d, "yyyy-MM-dd");
                            setStartDate(dateStr);
                            if (endDate && new Date(dateStr + "T00:00:00") > new Date(endDate + "T00:00:00")) {
                              setEndDate(dateStr);
                            }
                          } else {
                            setStartDate("");
                          }
                        }}
                        workSchedule={user?.employee?.workSchedule || "MON_FRI"}
                        initialFocus
                        disabled={[{ before: new Date(new Date().setHours(0,0,0,0)) }]}
                      />
                    </PopoverContent>
                  </Popover>
                </div>
                <div className="space-y-2 flex flex-col">
                  <Label>End Date</Label>
                  <Popover>
                    <PopoverTrigger asChild>
                      <Button
                        variant={"outline"}
                        className={cn(
                          "w-full justify-start text-left font-normal border-border/50",
                          !endDate && "text-muted-foreground"
                        )}
                        disabled={!startDate}
                      >
                        <CalendarIcon className="mr-2 h-4 w-4" />
                        {endDate ? format(new Date(endDate + "T00:00:00"), "PPP") : <span>Pick a date</span>}
                      </Button>
                    </PopoverTrigger>
                    <PopoverContent className="w-auto p-0" align="start">
                      <Calendar
                        mode="single"
                        selected={endDate ? new Date(endDate + "T00:00:00") : undefined}
                        onSelect={(d) => {
                          if (d) {
                            setEndDate(format(d, "yyyy-MM-dd"));
                          } else {
                            setEndDate("");
                          }
                        }}
                        workSchedule={user?.employee?.workSchedule || "MON_FRI"}
                        initialFocus
                        disabled={[
                          { before: startDate ? new Date(startDate + "T00:00:00") : new Date(new Date().setHours(0,0,0,0)) }
                        ]}
                      />
                    </PopoverContent>
                  </Popover>
                </div>
              </div>

              {startDate && endDate && (
                <div className="bg-muted/30 p-3 rounded-md text-sm">
                  <span className="font-semibold">Duration: </span>
                  {(() => {
                    const ws = user?.employee?.workSchedule || "MON_FRI";
                    const days = isScattered && scatteredDates.length > 0
                        ? calculateLeaveDays(startDate, endDate, ws, scatteredDates)
                        : calculateLeaveDays(startDate, endDate, ws);
                    return `${days} day${days === 1 ? "" : "s"}`;
                  })()}
                  {user?.employee?.workSchedule === "MON_SAT" && (
                    <span className="text-xs text-muted-foreground ml-2">
                      (Saturdays count as ½ day)
                    </span>
                  )}
                </div>
              )}

              {/* Scattered Date Picker */}
              {isScattered && startDate && endDate && (
                <div className="space-y-3 p-4 border border-border/50 rounded-lg bg-muted/10">
                  <Label className="text-sm font-medium">Select Scattered Leave Dates</Label>
                  <p className="text-xs text-muted-foreground mb-4">Click dates within your selected range to toggle them.</p>
                  
                  <div className="flex justify-center bg-background rounded-xl p-4 shadow-sm border border-border/50">
                    <Calendar
                      mode="multiple"
                      selected={scatteredDates.map(d => new Date(d + "T00:00:00"))}
                      onSelect={(dates) => {
                        if (!dates) setScatteredDates([]);
                        else setScatteredDates(dates.map(d => format(d, "yyyy-MM-dd")));
                      }}
                      workSchedule={user?.employee?.workSchedule || "MON_FRI"}
                      className="rounded-md"
                      disabled={[
                        { before: new Date(startDate + "T00:00:00") },
                        { after: new Date(endDate + "T00:00:00") }
                      ]}
                      defaultMonth={new Date(startDate + "T00:00:00")}
                    />
                  </div>
                </div>
              )}

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
                <div className="space-y-2">
                  <Label>Leave Type</Label>
                  <Select value={leaveType} onValueChange={(value) => setLeaveType(value as LeaveType)}>
                    <SelectTrigger className="bg-background/50"><SelectValue /></SelectTrigger>
                    <SelectContent>
                      <SelectItem value="ANNUAL">Annual Leave</SelectItem>
                      <SelectItem value="SICK">Sick Leave</SelectItem>
                      <SelectItem value="MATERNITY">Maternity Leave</SelectItem>
                      <SelectItem value="PATERNITY">Paternity Leave</SelectItem>
                    </SelectContent>
                  </Select>
                  {user?.employee?.leaveBalances && (leaveType === "ANNUAL" || leaveType === "SICK") && (
                    <div className="text-xs text-muted-foreground mt-1 px-1">
                      Available: <span className="font-semibold text-foreground">{user.employee.leaveBalances[leaveType.toLowerCase() as keyof typeof user.employee.leaveBalances]} days</span>
                    </div>
                  )}
                  {leaveType === "MATERNITY" && user?.employee?.gender !== "FEMALE" && (
                    <div className="text-[10px] text-red-500 font-medium mt-1 flex items-center gap-1 px-1">
                      <XCircle className="h-3 w-3" />
                      Maternity leave is only for female employees
                    </div>
                  )}
                  {leaveType === "PATERNITY" && user?.employee?.gender !== "MALE" && (
                    <div className="text-[10px] text-red-500 font-medium mt-1 flex items-center gap-1 px-1">
                      <XCircle className="h-3 w-3" />
                      Paternity leave is only for male employees
                    </div>
                  )}
                </div>
                <div className="space-y-2">
                  <Label>Contact Address (While on leave)</Label>
                  <Input value={contactWhileOnLeave} onChange={(e) => setContactWhileOnLeave(e.target.value)} placeholder="Telephone / Address" className="bg-background/50" />
                </div>
              </div>

              <div className="flex items-center justify-between p-4 rounded-xl border border-primary/10 bg-primary/5">
                <div className="space-y-0.5">
                  <Label className="text-sm font-semibold">Scattered Leave Days</Label>
                  <p className="text-xs text-muted-foreground">Select non-contiguous dates</p>
                </div>
                <button type="button" role="switch" aria-checked={isScattered} onClick={() => { setIsScattered(!isScattered); if (!isScattered) setScatteredDates([]); }}
                  className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${isScattered ? "bg-primary" : "bg-muted"}`}>
                  <span className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${isScattered ? "translate-x-6" : "translate-x-1"}`} />
                </button>
              </div>

              <div className="space-y-4 pt-4 border-t border-border/50">
                <div className="flex items-center gap-2">
                  <div className="h-8 w-1 bg-primary rounded-full" />
                  <h4 className="font-bold text-sm tracking-tight uppercase text-muted-foreground">Handover Process</h4>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div className="space-y-2">
                    <Label>Line Manager</Label>
                    <Select value={handoverLineManager} onValueChange={setHandoverLineManager}>
                      <SelectTrigger className="bg-background/50"><SelectValue placeholder="Select manager" /></SelectTrigger>
                      <SelectContent>
                        {lineManagerOptions.map((option) => (
                          <SelectItem key={option.value} value={option.value}>{option.label}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </div>
                  <div className="space-y-2">
                    <Label>CC (Handed over to)</Label>
                    <Select value={handoverCC} onValueChange={setHandoverCC}>
                      <SelectTrigger className="bg-background/50"><SelectValue placeholder="Colleague" /></SelectTrigger>
                      <SelectContent>
                        {handoverOptions.map((emp: DeptEmployee) => (
                          <SelectItem key={emp.id} value={emp.user?.name || emp.name || emp.id}>{emp.user?.name || emp.name}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </div>
                  <div className="space-y-2">
                    <Label>Department</Label>
                    <Input value={handoverDepartment} readOnly className="bg-muted/50" />
                  </div>
                </div>
                <div className="grid grid-cols-1 gap-4">
                  <Textarea value={handoverWorkStatus} onChange={(e) => setHandoverWorkStatus(e.target.value)} placeholder="Work status..." className="h-20 bg-background/50 resize-none" />
                  <Textarea value={handoverActions} onChange={(e) => setHandoverActions(e.target.value)} placeholder="Required actions..." className="h-20 bg-background/50 resize-none" />
                  <Textarea value={handoverRelationships} onChange={(e) => setHandoverRelationships(e.target.value)} placeholder="Key contacts..." className="h-20 bg-background/50 resize-none" />
                </div>
              </div>

              <div className="space-y-2 pt-4 border-t border-border/50">
                <Label className="font-semibold">Description / Reason</Label>
                <Textarea value={description} onChange={(e) => setDescription(e.target.value)} placeholder="Reason for leave..." className="h-24 bg-background/50" required />
              </div>
            </div>

            <div className="p-4 sm:p-6 border-t border-border/50 bg-muted/30 flex items-center justify-between gap-4">
              <div className="hidden sm:block">
                {(() => {
                  if (!startDate || !endDate) return null;
                  const ws = user?.employee?.workSchedule || "MON_FRI";
                  const days = isScattered ? calculateLeaveDays(startDate, endDate, ws, scatteredDates) : calculateLeaveDays(startDate, endDate, ws);
                  if (days <= 0) return null;
                  const balanceKey = leaveType.toLowerCase() as keyof typeof user.employee.leaveBalances;
                  const balance = user?.employee?.leaveBalances?.[balanceKey] || 0;
                  const isOver = (leaveType === "ANNUAL" || leaveType === "SICK") && days > balance;
                  return (
                    <div className={cn("text-xs font-medium px-3 py-1.5 rounded-full border", 
                      isOver ? "bg-destructive/10 text-destructive border-destructive/20" : "bg-primary/10 text-primary border-primary/20")}>
                      {isOver ? <span className="flex items-center gap-1.5"><XCircle className="h-3.5 w-3.5" />Balance exceeded</span> : <span>Total: {days} days</span>}
                    </div>
                  );
                })()}
              </div>
              <DialogFooter className="flex-1 sm:flex-initial">
                <Button type="button" variant="ghost" onClick={() => setIsNewRequestOpen(false)}>Cancel</Button>
                <Button type="submit" className="gradient-primary min-w-[140px]" disabled={isSubmitting || (() => {
                  if (!startDate || !endDate) return true;
                  const ws = user?.employee?.workSchedule || "MON_FRI";
                  const days = isScattered ? calculateLeaveDays(startDate, endDate, ws, scatteredDates) : calculateLeaveDays(startDate, endDate, ws);
                  if (days <= 0) return true;
                  if (leaveType === "MATERNITY" && user?.employee?.gender !== "FEMALE") return true;
                  if (leaveType === "PATERNITY" && user?.employee?.gender !== "MALE") return true;
                  if (leaveType !== "ANNUAL" && leaveType !== "SICK") return false;
                  if (!user?.employee?.leaveBalances) return true;
                  const balanceKey = leaveType.toLowerCase() as keyof typeof user.employee.leaveBalances;
                  return days > (user.employee.leaveBalances[balanceKey] || 0);
                })()}>
                  {isSubmitting ? "Submitting..." : (editingRequest ? "Update Request" : "Submit Request")}
                </Button>
              </DialogFooter>
            </div>
          </form>
        </DialogContent>
      </Dialog>

      {/* Bulk Reject Confirmation Dialog */}
      <AlertDialog open={isBulkRejectOpen} onOpenChange={setIsBulkRejectOpen}>
        <AlertDialogContent className="glass border-border/50">
          <AlertDialogHeader>
            <AlertDialogTitle>Reject Selected Requests</AlertDialogTitle>
            <AlertDialogDescription>
              Are you sure you want to reject {selectedRequests.size} selected
              request(s)? This action cannot be undone.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <div className="py-4">
            <Label htmlFor="bulkRejectReason">Rejection Reason</Label>
            <Textarea
              id="bulkRejectReason"
              placeholder="Enter reason for rejection..."
              value={bulkRejectReason}
              onChange={(e) => setBulkRejectReason(e.target.value)}
              className="mt-2"
            />
          </div>
          <AlertDialogFooter>
            <AlertDialogCancel onClick={() => setBulkRejectReason("")}>
              Cancel
            </AlertDialogCancel>
            <AlertDialogAction
              className="bg-destructive text-destructive-foreground hover:bg-destructive/90"
              onClick={() => {
                if (bulkRejectReason.trim()) {
                  bulkReject.mutate({
                    ids: Array.from(selectedRequests),
                    reason: bulkRejectReason,
                  });
                  setBulkRejectReason("");
                  setIsBulkRejectOpen(false);
                } else {
                  toast({
                    variant: "destructive",
                    title: "Error",
                    description: "Please provide a rejection reason",
                  });
                }
              }}
              disabled={bulkReject.isPending}
            >
              {bulkReject.isPending ? "Rejecting..." : "Reject All"}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      <ReservationModal
        isOpen={isReservationModalOpen}
        onClose={() => setIsReservationModalOpen(false)}
      />
    </DashboardLayout>
  );
};

export default Requests;
```

**1. Line Manager dropdown for admins (line ~728)**

- Added comment clarifying administrators follow the same flow
- No code logic change needed — the existing `LINE_MANAGER_ROLES` filter already covers admins since they weren't matching the `OPERATIONS_MANAGER`/`HOD_PROJECTS` special case

**2. Self-approval guard on UI buttons (lines ~1732, ~1762, ~1935, ~1949)**

- All 4 PENDING_ADMIN button blocks (approve + reject in both card and table views) now include `user?.employee?.id !== request.employeeId`
- An admin sees approve/reject buttons only for **other employees'** requests, not their own

## What Was Tested

- ✅ Frontend TypeScript compilation — clean (0 new errors)
- ✅ Backend TypeScript compilation — clean (only pre-existing errors unrelated to these changes)
- ✅ Backend self-approval guard in controller prevents API-level self-approval
- ✅ Frontend button guards prevent UI-level self-approval

## How the Flow Works Now

| Step | Who Approves | Status Transition |
|------|-------------|------------------|
| 1. Admin submits request | — | → `PENDING_OM` |
| 2. Operations Manager | OM verifies | → `PENDING_GM` |
| 3. General Manager (or CTO if GM absent) | GM endorses | → `PENDING_ADMIN` |
| 4. **Other** Administrator | Downloads PDF for CEO signature, then confirms | → `APPROVED` |
