# Walkthrough: Administrator Leave Approval Flow

## What Changed

Administrators previously auto-approved their own leave requests (status went straight to `APPROVED`). Now they follow the exact same approval chain as every other employee:

```
OM → GM (or CTO if GM absent) → Other Administrator
```

## Changes Made

### Backend — [leave.controller.ts](file:///c:/Apps/Leave%20Tracker/server/src/controllers/leave.controller.ts)

**1. Removed admin auto-approve bypass (line ~374)**

```diff:leave.controller.ts
import { Request, Response, NextFunction } from 'express';
import { z } from 'zod';
import prisma, { Prisma } from '../prisma/client';
import { AppError } from '../middleware/error';
import { AuthRequest } from '../middleware/auth';
import { logAction } from '../utils/logger';
import { sendEmail, emailTemplates } from '../services/email.service';
import { sanitizeString } from '../utils/sanitize';
import { calculateLeaveDays, isSunday, isKenyanPublicHoliday, getDatesInRange } from '../utils/holidays';
import { isGeneralManagerAway, getRoleApprovalStatus, isCEOAway } from '../utils/approvalUtils';
import { APP_CONSTANTS } from '../utils/constants';

// Typed interfaces for JSON fields
interface LeaveBalances {
    [key: string]: number | undefined;
    annual?: number;
    sick?: number;
}

interface LeaveRequestWithScattered {
    isScattered?: boolean;
    scatteredDates?: string[];
    [key: string]: unknown;
}

/** Safely cast a Prisma leave request to access its JSON  scattered fields */
function asScattered(req: Record<string, unknown>): LeaveRequestWithScattered {
    return req as LeaveRequestWithScattered;
}

/**
 * Check if a user is authorized to approve a leave request based on the selected line manager
 */
async function checkLineManagerAuthorization(userId: string, leaveRequest: any): Promise<boolean> {
    const user = await prisma.user.findUnique({ where: { id: userId } });
    if (!user) return false;

    // --- Delegation / Substitute Check ---
    // If the status is PENDING_OM, check if the current user is the substitute for the Operations Manager
    if (leaveRequest.status === 'PENDING_OM') {
        const { isAway, substituteId } = await getRoleApprovalStatus(APP_CONSTANTS.ROLES.OPERATIONS_MANAGER);
        if (isAway && substituteId === userId) return true;
        
        // GM and CTO can always approve OM level requests as per management hierarchy
        if (user.role === APP_CONSTANTS.ROLES.GENERAL_MANAGER || user.role === APP_CONSTANTS.ROLES.CTO) return true;
    }

    // If the status is PENDING_HOD_PROJECTS, check if the current user is the substitute for the HOD Projects
    if (leaveRequest.status === 'PENDING_HOD_PROJECTS') {
        const { isAway, substituteId } = await getRoleApprovalStatus(APP_CONSTANTS.ROLES.HOD_PROJECTS);
        if (isAway && substituteId === userId) return true;

        // GM and CTO can always approve HOD level requests as per management hierarchy
        if (user.role === APP_CONSTANTS.ROLES.GENERAL_MANAGER || user.role === APP_CONSTANTS.ROLES.CTO) return true;
    }
    // ------------------------------------

    // If no handoverLineManager is specified, fall back to role-based authorization
    if (!leaveRequest.handoverLineManager) {
        // Allow OM to approve PENDING_OM requests
        if (leaveRequest.status === 'PENDING_OM' && user.role === 'OPERATIONS_MANAGER') {
            return true;
        }
        // Allow HOD_PROJECTS to approve PENDING_HOD_PROJECTS requests
        if (leaveRequest.status === 'PENDING_HOD_PROJECTS' && user.role === 'HOD_PROJECTS') {
            return true;
        }
        return false;
    }

    // Check if the current user is the selected line manager
    const lineManager = await prisma.employee.findFirst({
        where: {
            user: {
                isActive: true,
                name: leaveRequest.handoverLineManager,
            },
        },
        include: { user: true },
    });

    // Also check if the current user is a substitute for the selected line manager
    if (lineManager?.user) {
        if (lineManager.user.id === userId) return true;
        
        // Check if the current user is the designated substitute for the line manager's role
        const { isAway, substituteId } = await getRoleApprovalStatus(lineManager.user.role);
        if (isAway && substituteId === userId) return true;
    }

    return false;
}

const createLeaveSchema = z.object({
    startDate: z.string(),
    endDate: z.string(),
    leaveType: z.enum(['ANNUAL', 'SICK', 'MATERNITY', 'PATERNITY']),
    description: z.string().optional(),

    // Scattered leave support
    isScattered: z.boolean().optional().default(false),
    scatteredDates: z.array(z.string()).optional(), // Array of ISO date strings

    // Contact and handover information
    contactWhileOnLeave: z.string().optional(),
    handoverLineManager: z.string().optional(),
    handoverCC: z.string().optional(),
    handoverDepartment: z.string().optional(),
    handoverNotes: z.string().optional(),

    // Handover Report Table
    handoverWorkStatus: z.string().optional(),
    handoverActions: z.string().optional(),
    handoverRelationships: z.string().optional(),

    // Employee signature
    employeeSignature: z.string().optional(),
    
    // Reservation linking
    reservationId: z.string().optional(),
});

const omApprovalSchema = z.object({
    comments: z.string().optional(),
});

const adminApprovalSchema = z.object({
    comments: z.string().optional(),
});

const gmApprovalSchema = z.object({
    comments: z.string().optional(),
});

const rejectionSchema = z.object({
    reason: z.string().min(1, 'Rejection reason is required'),
});

export const createLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { startDate, endDate, leaveType, description, isScattered, scatteredDates, contactWhileOnLeave, handoverLineManager, handoverCC, handoverDepartment, handoverWorkStatus, handoverActions, handoverRelationships, employeeSignature, reservationId } = createLeaveSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        // Employee can only create request for themselves
        const employee = await prisma.employee.findUnique({
            where: { userId },
            include: { user: true },
        });
        if (!employee) {
            throw new AppError('Employee profile not found', 404);
        }

        // Gender-based leave validation
        if (leaveType === 'MATERNITY' && employee.gender !== 'FEMALE') {
            throw new AppError('Maternity leave is only available for female employees', 400);
        }
        if (leaveType === 'PATERNITY' && employee.gender !== 'MALE') {
            throw new AppError('Paternity leave is only available for male employees', 400);
        }

        // Basic validation: End date on or after start date
        if (new Date(endDate) < new Date(startDate)) {
            throw new AppError('End date must be on or after start date', 400);
        }

        // Prevent requesting leave on past dates
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const requestStart = new Date(startDate);
        requestStart.setHours(0, 0, 0, 0);
        if (requestStart < today) {
            throw new AppError('Cannot request leave for dates that have already passed', 400);
        }

        // Validate selected line manager name against the allowed approval roles
        if (handoverLineManager) {
            const manager = await prisma.employee.findFirst({
                where: {
                    user: {
                        isActive: true,
                        name: handoverLineManager,
                        role: { in: ['OPERATIONS_MANAGER', 'HOD_PROJECTS', 'GENERAL_MANAGER', 'CTO'] },
                    },
                },
                include: { user: true },
            });

            if (!manager) {
                throw new AppError('Invalid line manager selection', 400);
            }
        }

        // Validate scattered dates if provided
        if (isScattered && scatteredDates) {
            if (scatteredDates.length === 0) {
                throw new AppError('At least one date must be selected for scattered leave', 400);
            }
            // Ensure all scattered dates fall within the range and are not in the past
            const start = new Date(startDate);
            const end = new Date(endDate);
            for (const dateStr of scatteredDates) {
                const d = new Date(dateStr);
                if (d < start || d > end) {
                    throw new AppError('All scattered dates must fall within the start and end date range', 400);
                }
                const scatteredDay = new Date(dateStr);
                scatteredDay.setHours(0, 0, 0, 0);
                if (scatteredDay < today) {
                    throw new AppError(`Cannot request leave for a past date: ${scatteredDay.toLocaleDateString()}`, 400);
                }
            }
        }

        // For scattered leaves, explicitly validate the user didn't bypass the UI to pick invalid days
        if (isScattered && scatteredDates) {
            for (const dateStr of scatteredDates) {
                const normalizedDate = dateStr.split('T')[0];
                if (isSunday(normalizedDate)) {
                    throw new AppError(`Cannot select a Sunday for scattered leave: ${new Date(normalizedDate + 'T00:00:00').toLocaleDateString()}`, 400);
                }
                if (isKenyanPublicHoliday(normalizedDate)) {
                    throw new AppError(`Cannot select a public holiday for scattered leave: ${new Date(normalizedDate + 'T00:00:00').toLocaleDateString()}`, 400);
                }
            }
        }

        // Calculate days requested (accounting for half-day Saturdays for MON_SAT employees)
        const employeeWorkSchedule = (employee.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
        const daysRequested = calculateLeaveDays(
            startDate.split('T')[0],
            endDate.split('T')[0],
            employeeWorkSchedule,
            isScattered && scatteredDates ? scatteredDates.map(d => d.split('T')[0]) : undefined,
        );

        if (daysRequested <= 0) {
            throw new AppError('No valid working days in the selected date range', 400);
        }

        // Check balance based on leave type (only ANNUAL and SICK have tracked balances)
        const leaveBalances = JSON.parse(employee.leaveBalances as string) as LeaveBalances;
        const leaveTypeKey = leaveType.toLowerCase();

        if ((leaveType === 'ANNUAL' || leaveType === 'SICK') && leaveBalances[leaveTypeKey] !== undefined) {
            const availableBalance = leaveBalances[leaveTypeKey];
            if (availableBalance < daysRequested) {
                throw new AppError(`Insufficient ${leaveType.toLowerCase()} leave balance. You have ${availableBalance} days remaining.`, 400);
            }
        }

        // Check for overlapping leave requests (covers both regular and scattered)
        const existingRequests = await prisma.leaveRequest.findMany({
            where: {
                employeeId: employee.id,
                status: { in: ['PENDING_OM', 'PENDING_GM', 'PENDING_ADMIN', 'APPROVED'] },
            },
        });

        if (isScattered && scatteredDates) {
            // For scattered leave, check each individual date against existing requests
            for (const dateStr of scatteredDates) {
                const scatteredDay = new Date(dateStr);
                scatteredDay.setHours(0, 0, 0, 0);

                for (const existing of existingRequests) {
                    const existingScattered = asScattered(existing as unknown as Record<string, unknown>);
                    if (existingScattered.isScattered && existingScattered.scatteredDates) {
                        // Check against other scattered dates
                        for (const existingDateStr of existingScattered.scatteredDates) {
                            const existingDay = new Date(existingDateStr);
                            existingDay.setHours(0, 0, 0, 0);
                            if (scatteredDay.getTime() === existingDay.getTime()) {
                                throw new AppError(`You already have a leave request on ${scatteredDay.toLocaleDateString()}`, 400);
                            }
                        }
                    } else {
                        // Check against regular date ranges
                        const existStart = new Date(existing.startDate);
                        existStart.setHours(0, 0, 0, 0);
                        const existEnd = new Date(existing.endDate);
                        existEnd.setHours(0, 0, 0, 0);
                        if (scatteredDay >= existStart && scatteredDay <= existEnd) {
                            throw new AppError(`You already have a leave request covering ${scatteredDay.toLocaleDateString()}`, 400);
                        }
                    }
                }
            }
        } else {
            // For regular date ranges, check for overlapping ranges
            const reqStart = new Date(startDate);
            reqStart.setHours(0, 0, 0, 0);
            const reqEnd = new Date(endDate);
            reqEnd.setHours(0, 0, 0, 0);

            for (const existing of existingRequests) {
                const existingScattered = asScattered(existing as unknown as Record<string, unknown>);
                if (existingScattered.isScattered && existingScattered.scatteredDates) {
                    // Check if any existing scattered date falls within the new range
                    for (const existingDateStr of existingScattered.scatteredDates) {
                        const existingDay = new Date(existingDateStr);
                        existingDay.setHours(0, 0, 0, 0);
                        if (existingDay >= reqStart && existingDay <= reqEnd) {
                            throw new AppError(`You already have a scattered leave on ${existingDay.toLocaleDateString()} which falls within this period`, 400);
                        }
                    }
                } else {
                    // Check range-vs-range overlap
                    const existStart = new Date(existing.startDate);
                    existStart.setHours(0, 0, 0, 0);
                    const existEnd = new Date(existing.endDate);
                    existEnd.setHours(0, 0, 0, 0);
                    if (reqStart <= existEnd && reqEnd >= existStart) {
                        throw new AppError('You already have a leave request overlapping with this period.', 400);
                    }
                }
            }
        }

        // Determine initial status based on selected line manager
        let initialStatus: string = 'PENDING_OM';
        const userRole = (req as AuthRequest).user!.role.toUpperCase().replace(/\s+/g, '_');
        const userDept = (employee.department || '').toUpperCase();

        let omApproverRef = null;
        let omDateRef = null;
        let gmApproverRef = null;
        let gmDateRef = null;
        let adminNameRef = null;
        let adminDateRef = null;

        // Check if this is a conversion from a fully approved reservation
        if (reservationId) {
            const reservation = await prisma.reservation.findUnique({
                where: { id: reservationId },
                include: {
                    omApprover: { select: { name: true } },
                    gmApprover: { select: { name: true } },
                    adminApprover: { select: { name: true } }
                }
            });

            if (reservation?.status === 'RESERVED' && reservation.employeeId === employee.id) {
                initialStatus = 'APPROVED';
                omApproverRef = reservation.omApproverId;
                omDateRef = reservation.omApprovalDate;
                gmApproverRef = reservation.gmApproverId;
                gmDateRef = reservation.gmApprovalDate;
                adminNameRef = reservation.adminApprover?.name || 'Administrator (Approved via Reservation)';
                adminDateRef = reservation.adminApprovalDate;
            }
        }

        if (initialStatus !== 'APPROVED') {
            // Route based on selected line manager
            if (handoverLineManager) {
                const lineManager = await prisma.employee.findFirst({
                    where: {
                        user: {
                            isActive: true,
                            name: handoverLineManager,
                        },
                    },
                    include: { user: true },
                });

                if (lineManager?.user?.role === 'OPERATIONS_MANAGER') {
                    initialStatus = 'PENDING_OM';
                } else if (lineManager?.user?.role === 'HOD_PROJECTS') {
                    initialStatus = 'PENDING_HOD_PROJECTS';
                } else {
                    // Fallback to default logic if line manager role is not recognized
                    initialStatus = 'PENDING_OM';
                }
            } else {
                // Fallback to original logic if no line manager selected
                if (userRole === 'ADMINISTRATOR') {
                    initialStatus = 'APPROVED';
                    adminNameRef = employee.user.name;
                    adminDateRef = new Date();
                } else if (userRole === 'GENERAL_MANAGER' || userRole === 'CTO') {
                    initialStatus = 'PENDING_ADMIN';
                } else if (userRole === 'OPERATIONS_MANAGER') {
                    initialStatus = 'PENDING_GM';
                } else if (userRole === 'HOD_PROJECTS') {
                    initialStatus = 'PENDING_GM'; // HOD Projects skips their own approval
                } else if (userDept === 'PROJECTS') {
                    initialStatus = 'PENDING_HOD_PROJECTS'; // Projects employees go to HOD first
                } else {
                    initialStatus = 'PENDING_OM'; // All other departments go to OM first
                }
            }
        }

        const leaveRequest = await prisma.leaveRequest.create({
            data: {
                employeeId: employee.id,
                startDate: new Date(startDate),
                endDate: new Date(endDate),
                leaveType,
                description: sanitizeString(description),
                isScattered: isScattered || false,
                scatteredDates: isScattered && scatteredDates ? JSON.stringify(scatteredDates) : undefined,
                contactWhileOnLeave: sanitizeString(contactWhileOnLeave),
                handoverLineManager: sanitizeString(handoverLineManager),
                handoverCC: sanitizeString(handoverCC),
                handoverDepartment: sanitizeString(handoverDepartment),
                handoverNotes: "", // Deprecated field
                handoverWorkStatus: sanitizeString(handoverWorkStatus),
                handoverActions: sanitizeString(handoverActions),
                handoverRelationships: sanitizeString(handoverRelationships),
                employeeSignature: sanitizeString(employeeSignature),
                employeeSignatureDate: employeeSignature ? new Date() : null,
                // Inherited or new approval details
                status: initialStatus,
                omApproverId: omApproverRef,
                omApprovalDate: omDateRef,
                gmApproverId: gmApproverRef,
                gmApprovalDate: gmDateRef,
                approverName: adminNameRef,
                approverSignatureDate: adminDateRef,
            },
        });

        // Deduct balance immediately if auto-approved (Administrator)
        if (initialStatus === 'APPROVED' && (leaveType === 'ANNUAL' || leaveType === 'SICK')) {
            const leaveBalances = JSON.parse(employee.leaveBalances as string) as LeaveBalances;
            const leaveTypeKey = leaveType.toLowerCase();
            if (leaveBalances[leaveTypeKey] !== undefined) {
                leaveBalances[leaveTypeKey] = Math.max(0, leaveBalances[leaveTypeKey]! - daysRequested);
                await prisma.employee.update({
                    where: { id: employee.id },
                    data: { leaveBalances: JSON.stringify(leaveBalances) }
                });
            }
        }

        // Log the action
        await logAction({
            userId,
            action: 'CREATE_LEAVE_REQUEST',
            entityType: 'LeaveRequest',
            entityId: leaveRequest.id,
            details: { leaveType, startDate, endDate, status: initialStatus },
            ipAddress: req.ip
        });

        // Notifications logic based on initial status
        if (initialStatus !== 'APPROVED') {
            let approvers: { id: string; name: string; email: string }[] = [];
            let notificationLink = '';
            let approvalLevel = '';

            if (handoverLineManager) {
                // Send notification to the specific selected line manager
                const lineManager = await prisma.employee.findFirst({
                    where: {
                        user: {
                            isActive: true,
                            name: handoverLineManager,
                        },
                    },
                    include: { user: true },
                });

                if (lineManager?.user) {
                    approvers = [{
                        id: lineManager.user.id,
                        name: lineManager.user.name,
                        email: lineManager.user.email,
                    }];

                    if (lineManager.user.role === 'OPERATIONS_MANAGER') {
                        notificationLink = '/requests?status=PENDING_OM';
                        approvalLevel = 'Operations Manager';
                    } else if (lineManager.user.role === 'HOD_PROJECTS') {
                        notificationLink = '/requests?status=PENDING_HOD_PROJECTS';
                        approvalLevel = 'Projects HOD';
                    }
                }
            } else {
                // Fallback to original notification logic
                if (initialStatus === 'PENDING_HOD_PROJECTS') {
                    approvers = await prisma.user.findMany({ where: { role: 'HOD_PROJECTS' } });
                    notificationLink = '/requests?status=PENDING_HOD_PROJECTS';
                    approvalLevel = 'Projects HOD';
                } else if (initialStatus === 'PENDING_OM') {
                    approvers = await prisma.user.findMany({ where: { role: 'OPERATIONS_MANAGER' } });
                    notificationLink = '/requests?status=PENDING_OM';
                    approvalLevel = 'Operations Manager';
                } else if (initialStatus === 'PENDING_GM') {
                    approvers = await prisma.user.findMany({ where: { role: 'GENERAL_MANAGER' } });
                    notificationLink = '/requests?status=PENDING_GM';
                    approvalLevel = 'General Manager';
                } else if (initialStatus === 'PENDING_ADMIN') {
                    approvers = await prisma.user.findMany({ where: { role: 'ADMINISTRATOR' } });
                    notificationLink = '/requests?status=PENDING_ADMIN';
                    approvalLevel = 'ADMINISTRATOR';
                }
            }

            if (approvers.length > 0) {
                const emailTemplate = emailTemplates.newLeaveRequest(
                    employee.user.name,
                    leaveType,
                    new Date(startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
                    new Date(endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
                    daysRequested,
                    description,
                    employee.department,
                    isScattered,
                    scatteredDates,
                    approvalLevel
                );

                await Promise.all(
                    approvers.map(async (approver) => {
                        await prisma.notification.create({
                            data: {
                                userId: approver.id,
                                title: 'New Leave Request',
                                message: `${employee.user.name} has submitted a ${leaveType.toLowerCase()} leave request requiring your approval`,
                                type: 'LEAVE_REQUEST',
                                link: notificationLink,
                            },
                        });

                        await sendEmail({
                            to: approver.email,
                            subject: `[${approvalLevel} Approval Required] ${emailTemplate.subject}`,
                            html: emailTemplate.html,
                        });
                    })
                );
            }
        }

        res.status(201).json({
            status: 'success',
            data: { leaveRequest },
        });
    } catch (error) {
        next(error);
    }
};

export const updateLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const userId = (req as AuthRequest).user!.id;

        // Validate request body
        const {
            startDate,
            endDate,
            leaveType,
            description,
            isScattered,
            scatteredDates,
            contactWhileOnLeave,
            handoverLineManager,
            handoverCC,
            handoverDepartment,
            handoverNotes,
            handoverWorkStatus,
            handoverActions,
            handoverRelationships,
            employeeSignature
        } = createLeaveSchema.parse(req.body);

        // Find existing request
        const existingRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });

        if (!existingRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check ownership
        if (existingRequest.employee.userId !== userId) {
            throw new AppError('You can only edit your own requests', 403);
        }

        // Check status
        if (existingRequest.status !== 'PENDING_OM') {
            throw new AppError('Can only edit requests pending OM approval', 400);
        }

        if (handoverLineManager) {
            const manager = await prisma.employee.findFirst({
                where: {
                    user: {
                        isActive: true,
                        name: handoverLineManager,
                        role: { in: ['OPERATIONS_MANAGER', 'HOD_PROJECTS', 'GENERAL_MANAGER', 'CTO'] },
                    },
                },
                include: { user: true },
            });

            if (!manager) {
                throw new AppError('Invalid line manager selection', 400);
            }
        }

        // Gender-based leave validation
        if (leaveType === 'MATERNITY' && existingRequest.employee.gender !== 'FEMALE') {
            throw new AppError('Maternity leave is only available for female employees', 400);
        }
        if (leaveType === 'PATERNITY' && existingRequest.employee.gender !== 'MALE') {
            throw new AppError('Paternity leave is only available for male employees', 400);
        }

        // Basic validation: End date on or after start date
        if (new Date(endDate) < new Date(startDate)) {
            throw new AppError('End date must be on or after start date', 400);
        }

        // Calculate days requested (accounting for half-day Saturdays)
        const employeeWorkSchedule = (existingRequest.employee.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
        const daysRequested = calculateLeaveDays(
            startDate.split('T')[0],
            endDate.split('T')[0],
            employeeWorkSchedule,
            isScattered && scatteredDates ? scatteredDates.map(d => d.split('T')[0]) : undefined,
        );

        // Check balance based on leave type
        // Note: We need to account for the fact that we might be changing the duration
        // Ideally we should "refund" the previous duration and deduct the new one, 
        // but currently balance is only deducted on APPROVAL (GM phase).
        // So we just need to check if they have enough balance for the NEW duration.
        // Since it's PENDING_OM, no balance has been deducted yet.

        const leaveBalances = JSON.parse(existingRequest.employee.leaveBalances as string) as LeaveBalances;
        const leaveTypeKey = leaveType.toLowerCase();

        if ((leaveType === 'ANNUAL' || leaveType === 'SICK') && leaveBalances[leaveTypeKey] !== undefined) {
            const availableBalance = leaveBalances[leaveTypeKey];
            if (availableBalance < daysRequested) {
                throw new AppError(`Insufficient ${leaveType.toLowerCase()} leave balance. You have ${availableBalance} days remaining.`, 400);
            }
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                startDate: new Date(startDate),
                endDate: new Date(endDate),
                leaveType,
                description: sanitizeString(description),
                isScattered: isScattered || false,
                scatteredDates: isScattered && scatteredDates ? JSON.stringify(scatteredDates) : undefined,
                contactWhileOnLeave: sanitizeString(contactWhileOnLeave),
                handoverLineManager: sanitizeString(handoverLineManager),
                handoverCC: sanitizeString(handoverCC),
                handoverDepartment: sanitizeString(handoverDepartment),
                handoverNotes: sanitizeString(handoverNotes),
                handoverWorkStatus: sanitizeString(handoverWorkStatus),
                handoverActions: sanitizeString(handoverActions),
                handoverRelationships: sanitizeString(handoverRelationships),
                employeeSignature: sanitizeString(employeeSignature),
                employeeSignatureDate: employeeSignature ? new Date() : null,
            },
        });

        // Log the action
        await logAction({
            userId,
            action: 'UPDATE_LEAVE_REQUEST',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { leaveType, startDate, endDate },
            ipAddress: req.ip
        });

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

// Operations Manager Approval (Phase 1)


// Projects HOD Approval (Phase 1)
export const hodApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = omApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check if user is authorized to approve this request
        const isAuthorized = await checkLineManagerAuthorization(userId, leaveRequest);
        if (!isAuthorized) {
            throw new AppError('You are not authorized to approve this leave request', 403);
        }

        if (!['PENDING_HOD_PROJECTS', 'PENDING_OM'].includes(leaveRequest.status)) {
            throw new AppError('Leave request is not pending approval', 400);
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: 'PENDING_GM',
                omApproverId: userId, // Reuse omApproverId for record keeping but rename in UI
                omApprovalDate: new Date(),
                omApprovalComments: sanitizeString(comments),
            },
        });

        // Notifications logic
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        const hodApprover = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (employee && hodApprover) {
            // Format dates
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const hodApprovalDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Create in-app notification for employee
            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request HOD Approved',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by the Projects HOD and is now pending GM endorsement.`,
                    type: 'APPROVAL',
                    link: '/my-history',
                },
            });

            // Send notification to employee
            const employeeEmail = emailTemplates.hodApprovedToEmployee(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                hodApprover.name,
                hodApprovalDateFormatted,
                asScattered(leaveRequest as any).isScattered
            );

            await sendEmail({
                to: employee.user.email,
                subject: employeeEmail.subject,
                html: employeeEmail.html,
            });

            // Notify all GMs
            const gms = await prisma.user.findMany({ where: { role: 'GENERAL_MANAGER' } });
            
            // Calculate days requested
            const workSchedule = employee.workSchedule as 'MON_FRI' | 'MON_SAT' || 'MON_FRI';
            const startDateStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
            const endDateStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
            const reqScattered = asScattered(leaveRequest as any);
            let parsedScatteredDates: string[] | undefined;
            if (reqScattered.isScattered && reqScattered.scatteredDates) {
                try {
                    parsedScatteredDates = typeof reqScattered.scatteredDates === 'string' 
                        ? JSON.parse(reqScattered.scatteredDates as any) 
                        : reqScattered.scatteredDates;
                } catch { /* ignore */ }
            }
            const scatteredArr = parsedScatteredDates ? parsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
            const daysCount = calculateLeaveDays(startDateStr, endDateStr, workSchedule, scatteredArr);

            const gmEmail = emailTemplates.hodApprovedToGM(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                daysCount,
                hodApprover.name,
                hodApprovalDateFormatted,
                leaveRequest.description || undefined,
                reqScattered.isScattered,
                parsedScatteredDates
            );

            await Promise.all(gms.map(async (gm) => {
                // In-app notification for GM
                await prisma.notification.create({
                    data: {
                        userId: gm.id,
                        title: 'Leave Request Pending GM Endorsement',
                        message: `${employee.user.name}'s Projects leave request has been approved by HOD and requires your endorsement.`,
                        type: 'APPROVAL',
                        link: '/requests?status=PENDING_GM',
                    },
                });

                // Email for GM
                await sendEmail({
                    to: gm.email,
                    subject: gmEmail.subject,
                    html: gmEmail.html,
                });
            }));
        }

        // Success response
        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};
export const omApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = omApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check if user is authorized to approve this request
        const isAuthorized = await checkLineManagerAuthorization(userId, leaveRequest);
        if (!isAuthorized) {
            throw new AppError('You are not authorized to approve this leave request', 403);
        }

        if (!['PENDING_HOD_PROJECTS', 'PENDING_OM'].includes(leaveRequest.status)) {
            throw new AppError('Leave request is not pending approval', 400);
        }

        // Determine if this is a substitute action
        const userRole = (req as AuthRequest).user!.role;
        const isGMAction = userRole === APP_CONSTANTS.ROLES.GENERAL_MANAGER || userRole === APP_CONSTANTS.ROLES.CTO;
        
        // --- Double-Jump Logic ---
        // If a GM (or CTO acting for GM) is approving for OM/HOD, they bypass the PENDING_GM stage
        const isCEOAbsent = await isCEOAway();
        let nextStatus = 'PENDING_GM';
        if (isGMAction) {
            nextStatus = isCEOAbsent ? 'APPROVED' : 'PENDING_ADMIN';
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: nextStatus,
                omApproverId: userId,
                omApprovalDate: new Date(),
                omApprovalComments: sanitizeString(comments),
                omSubstituteId: !isGMAction ? userId : null, // Record if someone else acted as substitute
                ...(isGMAction && {
                    gmApproverId: userId,
                    gmApprovalDate: new Date(),
                    gmApprovalComments: 'Auto-endorsed via Double-Jump logic (Acting on behalf of OM/HOD)',
                }),
                ...(isGMAction && isCEOAbsent && {
                    approverName: 'System (CEO Absent)',
                    approverSignatureDate: new Date()
                })
            } as any,
        });

        // Log the action
        await logAction({
            userId,
            action: 'OM_APPROVE_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { comments },
            ipAddress: req.ip
        });

        // Get employee and OM details
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        const omApprover = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (!employee || !omApprover) {
            throw new AppError('Employee or approver not found', 404);
        }

        // Calculate days
        // Calculate with half-day Saturday support
        const omEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
        const omWorkSchedule = (omEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
        const startDateStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
        const endDateStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
        const reqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);

        // Parse scatteredDates from JSON string if needed
        let parsedScatteredDates: string[] | undefined;
        if (reqScattered.isScattered && reqScattered.scatteredDates) {
            if (typeof reqScattered.scatteredDates === 'string') {
                try { parsedScatteredDates = JSON.parse(reqScattered.scatteredDates as unknown as string); } catch { parsedScatteredDates = undefined; }
            } else {
                parsedScatteredDates = reqScattered.scatteredDates;
            }
        }

        const scatteredArr = parsedScatteredDates ? parsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
        const daysRequested = calculateLeaveDays(startDateStr, endDateStr, omWorkSchedule, scatteredArr);
        const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        const omApprovalDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

        // Send email to employee notifying OM approval
        const employeeEmailTemplate = emailTemplates.omApprovedToEmployee(
            employee.user.name,
            leaveRequest.leaveType,
            formattedStartDate,
            formattedEndDate,
            omApprover.name,
            omApprovalDateFormatted,
            reqScattered.isScattered
        );

        await sendEmail({
            to: employee.user.email,
            subject: employeeEmailTemplate.subject,
            html: employeeEmailTemplate.html,
        });

        // Notify all GMs
        const gms = await prisma.user.findMany({
            where: { role: 'GENERAL_MANAGER' },
        });

        const gmEmailTemplate = emailTemplates.omApprovedToGM(
            employee.user.name,
            leaveRequest.leaveType,
            formattedStartDate,
            formattedEndDate,
            daysRequested,
            omApprover.name,
            omApprovalDateFormatted,
            leaveRequest.description || undefined,
            reqScattered.isScattered,
            parsedScatteredDates
        );

        await Promise.all(
            gms.map(async (gm) => {
                // Create in-app notification
                await prisma.notification.create({
                    data: {
                        userId: gm.id,
                        title: 'Leave Request Pending General Manager Approval',
                        message: `${employee.user.name}'s ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by OM and requires your approval`,
                        type: 'APPROVAL',
                        link: '/requests?status=PENDING_GM',
                    },
                });

                // Send email notification
                await sendEmail({
                    to: gm.email,
                    subject: gmEmailTemplate.subject,
                    html: gmEmailTemplate.html,
                });
            })
        );

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

// General Manager Approval (Phase 2)
export const gmApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = gmApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({ where: { id } });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        if (leaveRequest.status !== 'PENDING_GM') {
            throw new AppError('Leave request must be OM approved first', 400);
        }

        // --- CTO Delegation Logic ---
        const userRole = (req as AuthRequest).user!.role;
        let isGMSubstituteAction = false;
        if (userRole === APP_CONSTANTS.ROLES.CTO) {
            const { isAway } = await isGeneralManagerAway();
            if (!isAway) {
                throw new AppError('The CTO can only approve leave requests when the General Manager is away.', 403);
            }
            isGMSubstituteAction = true;
        }
        // ---------------------------

        // Check if CEO is away for automatic final approval
        const isCEOAbsent = await isCEOAway();
        const nextStatus = isCEOAbsent ? 'APPROVED' : 'PENDING_ADMIN';

        // Update status to PENDING_ADMIN (or APPROVED if CEO is away)
        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: nextStatus,
                gmApproverId: userId,
                gmApprovalDate: new Date(),
                gmApprovalComments: sanitizeString(comments),
                gmSubstituteId: isGMSubstituteAction ? userId : null,
                ...(isCEOAbsent && {
                    approverName: 'System (CEO Absent)',
                    approverSignatureDate: new Date()
                })
            },
        });

        // Log the action
        await logAction({
            userId,
            action: 'GM_APPROVE_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { comments },
            ipAddress: req.ip
        });

        // Notify the employee
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        // Get OM and General Manager approver details
        const omApprover = await prisma.user.findUnique({
            where: { id: leaveRequest.omApproverId! },
        });

        const gmApprover = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (employee && omApprover && gmApprover) {
            // Calculate days and remaining balance
            // Calculate with half-day Saturday support
            const gmEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
            const gmWorkSchedule = (gmEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
            const gmStartStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
            const gmEndStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
            const gmReqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);
            let gmParsedScatteredDates: string[] | undefined;
            if (gmReqScattered.isScattered && gmReqScattered.scatteredDates) {
                if (typeof gmReqScattered.scatteredDates === 'string') {
                    try { gmParsedScatteredDates = JSON.parse(gmReqScattered.scatteredDates as unknown as string); } catch { gmParsedScatteredDates = undefined; }
                } else {
                    gmParsedScatteredDates = gmReqScattered.scatteredDates;
                }
            }
            const gmScattered = gmParsedScatteredDates ? gmParsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
            const daysRequested = calculateLeaveDays(gmStartStr, gmEndStr, gmWorkSchedule, gmScattered);
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const omApprovalDateFormatted = new Date(leaveRequest.omApprovalDate!).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const gmApprovalDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Create in-app notification for employee
            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request GM Approved',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by the General Manager and is pending final Admin approval.`,
                    type: 'APPROVAL',
                    link: '/my-history',
                },
            });

            // Send email to employee notifying GM approval
            await sendEmail({
                to: employee.user.email,
                subject: `✅ Your${gmReqScattered.isScattered ? ' Scattered' : ''} Leave Request Has Been Endorsed by General Manager`,
                html: `
                <!DOCTYPE html>
                <html lang="en">
                <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Leave Request Progress</title></head>
                <body style="margin:0;padding:0;background-color:#F6F6F5;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;">
                    <div style="max-width:600px;margin:40px auto;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e2e8f0;border-top:8px solid #08033F;">
                        <div style="padding:30px;text-align:center;border-bottom:1px solid #F6F6F5;">
                            <img src="cid:company-logo" alt="Company Logo" style="height:50px;display:block;margin:0 auto;">
                            <h1 style="margin:20px 0 0;color:#08033F;font-size:24px;font-weight:800;text-transform:uppercase;letter-spacing:2px;">${gmApprover.role.replace('_', ' ')} Endorsed</h1>
                            <p style="margin:10px 0 0;color:#64748b;font-size:14px;text-transform:uppercase;font-weight:600;">Status: Pending Admin Final Confirmation</p>
                        </div>
                        <div style="padding:40px 30px;">
                            <p style="margin:0 0 20px;color:#1e293b;font-size:16px;">Hi <strong style="color:#08033F;">${employee.user.name}</strong>,</p>
                            <p style="margin:0 0 30px;color:#475569;font-size:16px;line-height:1.6;">
                                Your${gmReqScattered.isScattered ? ' <strong>scattered</strong>' : ''} leave request has been <strong>endorsed by the ${gmApprover.role === 'CTO' ? 'CTO (on behalf of GM)' : 'General Manager'}</strong> and is now advancing to the final stage — Admin confirmation.
                            </p>
                            <div style="background-color:#F6F6F5;padding:25px;border-radius:4px;margin-bottom:30px;">
                                <div style="margin-bottom:20px;padding-bottom:15px;border-bottom:1px solid #e2e8f0;">
                                    <p style="margin:0 0 5px;color:#64748b;font-size:11px;font-weight:800;text-transform:uppercase;">Operations Manager</p>
                                    <p style="margin:0;color:#08033F;font-weight:700;font-size:14px;">✅ Verified by ${omApprover.name} on ${omApprovalDateFormatted}</p>
                                </div>
                                <div style="margin-bottom:20px;padding-bottom:15px;border-bottom:1px solid #e2e8f0;">
                                    <p style="margin:0 0 5px;color:#64748b;font-size:11px;font-weight:800;text-transform:uppercase;">General Manager</p>
                                    <p style="margin:0;color:#08033F;font-weight:700;font-size:14px;">✅ Endorsed by ${gmApprover.name} on ${gmApprovalDateFormatted}</p>
                                </div>
                                <div>
                                    <p style="margin:0 0 5px;color:#64748b;font-size:11px;font-weight:800;text-transform:uppercase;">Administrator</p>
                                    <p style="margin:0;color:#94a3b8;font-weight:700;font-size:14px;">⏳ Pending Final Authorization</p>
                                </div>
                            </div>
                            <p style="margin:0;color:#64748b;font-size:14px;line-height:1.6;text-align:center;">You will receive a final confirmation email once the Administrator completes the authorization.</p>
                        </div>
                        <div style="background-color:#F6F6F5;padding:25px;text-align:center;">
                            <p style="margin:0;color:#08033F;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;">Leave Management System</p>
                            <p style="margin:5px 0 0;color:#94a3b8;font-size:10px;">&copy; ${new Date().getFullYear()} Official Internal Notice</p>
                        </div>
                    </div>
                </body>
                </html>
                `,
            });


            // Get all Administrators
            const adminUsers = await prisma.user.findMany({
                where: { role: 'ADMINISTRATOR' },
            });

            const adminEmailTemplate = emailTemplates.gmApprovedToAdmin({
                employeeName: employee.user.name,
                leaveType: leaveRequest.leaveType,
                startDate: formattedStartDate,
                endDate: formattedEndDate,
                days: daysRequested,
                omName: omApprover.name,
                omApprovalDate: omApprovalDateFormatted,
                gmName: gmApprover.name,
                gmApprovalDate: gmApprovalDateFormatted,
                reason: leaveRequest.description || undefined,
                isScattered: gmReqScattered.isScattered,
                scatteredDates: gmParsedScatteredDates
            });

            await Promise.all(
                adminUsers.map(async (admin) => {
                    // Create in-app notification for Admin
                    await prisma.notification.create({
                        data: {
                            userId: admin.id,
                            title: 'Leave Request Pending Final Approval',
                            message: `${employee.user.name}'s ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by GM and requires your final approval.`,
                            type: 'APPROVAL',
                            link: `/requests?status=PENDING_ADMIN`,
                        },
                    });

                    // Send email notification to Admin
                    await sendEmail({
                        to: admin.email,
                        subject: adminEmailTemplate.subject,
                        html: adminEmailTemplate.html,
                    });
                })
            );
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

// Admin Final Approval (Phase 3 - After Manual Signature)
export const adminApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = adminApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({ where: { id } });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        if (leaveRequest.status !== 'PENDING_ADMIN') {
            throw new AppError('Leave request must be GM approved and pending Admin confirmation (after manual signature) first', 400);
        }

        const user = await prisma.user.findUnique({ where: { id: userId } });
        if (!user) {
            throw new AppError('User not found', 404);
        }

        // Transaction to update status to APPROVED and deduct balance
        const result = await prisma.$transaction(async (tx: Prisma.TransactionClient) => {
            const updatedRequest = await tx.leaveRequest.update({
                where: { id },
                data: {
                    status: 'APPROVED',
                    approverName: user.name,
                    approverSignatureDate: new Date(),
                    approverComments: sanitizeString(comments),
                } as any,
            });

            // Deduct leave balance based on leave type
            if (leaveRequest.leaveType === 'ANNUAL' || leaveRequest.leaveType === 'SICK') {
                // Calculate with half-day Saturday support
                const adminEmployee = await tx.employee.findUnique({ where: { id: leaveRequest.employeeId } });
                const adminWorkSchedule = (adminEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
                const adminStartStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
                const adminEndStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
                const adminReqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);
                let adminParsedScatteredDates: string[] | undefined;
                if (adminReqScattered.isScattered && adminReqScattered.scatteredDates) {
                    if (typeof adminReqScattered.scatteredDates === 'string') {
                        try { adminParsedScatteredDates = JSON.parse(adminReqScattered.scatteredDates as unknown as string); } catch { adminParsedScatteredDates = undefined; }
                    } else {
                        adminParsedScatteredDates = adminReqScattered.scatteredDates;
                    }
                }
                const adminScattered = adminParsedScatteredDates ? adminParsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
                const daysRequested = calculateLeaveDays(adminStartStr, adminEndStr, adminWorkSchedule, adminScattered);

                const employee = await tx.employee.findUnique({ where: { id: leaveRequest.employeeId } });
                if (employee) {
                    const leaveBalances = JSON.parse(employee.leaveBalances as string) as LeaveBalances;
                    const leaveTypeKey = leaveRequest.leaveType.toLowerCase();

                    if (leaveBalances[leaveTypeKey] !== undefined) {
                        leaveBalances[leaveTypeKey] = Math.max(0, leaveBalances[leaveTypeKey]! - daysRequested);

                        await tx.employee.update({
                            where: { id: leaveRequest.employeeId },
                            data: { leaveBalances: JSON.stringify(leaveBalances) }
                        });
                    }
                }
            }

            return updatedRequest;
        });

        // Log the action
        await logAction({
            userId,
            action: 'ADMIN_FINAL_APPROVE_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { finalApprover: 'ADMINISTRATOR' },
            ipAddress: req.ip
        });

        // Notify the employee
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        if (employee) {
            // Send final approval email
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Calculate with half-day Saturday support for email
            const emailEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
            const emailWorkSchedule = (emailEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
            const emailStartStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
            const emailEndStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
            const emailReqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);
            // Parse scatteredDates safely
            let emailParsedScatteredDates: string[] | undefined;
            if (emailReqScattered.isScattered && emailReqScattered.scatteredDates) {
                if (typeof emailReqScattered.scatteredDates === 'string') {
                    try { emailParsedScatteredDates = JSON.parse(emailReqScattered.scatteredDates as unknown as string); } catch { emailParsedScatteredDates = undefined; }
                } else {
                    emailParsedScatteredDates = emailReqScattered.scatteredDates;
                }
            }
            const emailScattered = emailParsedScatteredDates ? emailParsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
            const daysRequested = calculateLeaveDays(emailStartStr, emailEndStr, emailWorkSchedule, emailScattered);

            // Safe lookups — omApproverId or gmApproverId can be null if steps were skipped
            const omApprover = leaveRequest.omApproverId
                ? await prisma.user.findUnique({ where: { id: leaveRequest.omApproverId } })
                : null;
            const gmApprover = leaveRequest.gmApproverId
                ? await prisma.user.findUnique({ where: { id: leaveRequest.gmApproverId } })
                : null;

            const omApprovalDateFormatted = leaveRequest.omApprovalDate
                ? new Date(leaveRequest.omApprovalDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                : 'N/A';
            const gmApprovalDateFormatted = leaveRequest.gmApprovalDate
                ? new Date(leaveRequest.gmApprovalDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                : 'N/A';

            const updatedEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
            const leaveBalances = updatedEmployee?.leaveBalances ? JSON.parse(updatedEmployee.leaveBalances as string) as LeaveBalances : undefined;
            const remainingBalance = leaveBalances?.[leaveRequest.leaveType.toLowerCase()];

            const emailTemplate = emailTemplates.leaveApproved(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                daysRequested,
                omApprover?.name || 'Operations Manager',
                omApprovalDateFormatted,
                gmApprover?.name || 'General Manager',
                gmApprovalDateFormatted,
                remainingBalance,
                emailReqScattered.isScattered
            );

            await sendEmail({
                to: employee.user.email,
                subject: emailTemplate.subject,
                html: emailTemplate.html,
            });

            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request Finally Approved',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been finally approved`,
                    type: 'APPROVAL',
                    link: '/my-history',
                },
            });
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: result },
        });
    } catch (error) {
        next(error);
    }
};

// Reject Leave Request (Can be done by HR/Admin or General Manager)
export const rejectLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { reason } = rejectionSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;
        const userRole = (req as AuthRequest).user!.role;
        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check if user is authorized to reject this request
        const isAuthorized = await checkLineManagerAuthorization(userId, leaveRequest);
        if (!isAuthorized) {
            // Also allow GMs and Admins to reject at any stage
            const user = await prisma.user.findUnique({ where: { id: userId } });
            if (!user || !['GENERAL_MANAGER', 'ADMINISTRATOR'].includes(user.role)) {
                throw new AppError('You are not authorized to reject this leave request', 403);
            }
        }

        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });


        if (leaveRequest.status === 'REJECTED_OM' || leaveRequest.status === 'REJECTED_GM' || leaveRequest.status === 'REJECTED_ADMIN' || leaveRequest.status === 'APPROVED') {
            throw new AppError('Leave request is already processed', 400);
        }

        // Determine rejection status based on current status
        let rejectionStatus: 'REJECTED_OM' | 'REJECTED_GM' | 'REJECTED_ADMIN';
        if (leaveRequest.status === 'PENDING_OM' || leaveRequest.status === 'PENDING_HOD_PROJECTS') {
            rejectionStatus = 'REJECTED_OM';
        } else if (leaveRequest.status === 'PENDING_GM') {
            rejectionStatus = 'REJECTED_GM';
        } else if (leaveRequest.status === 'PENDING_ADMIN') {
            rejectionStatus = 'REJECTED_ADMIN';
        } else {
            throw new AppError('Invalid leave request status for rejection', 400);
        }

        const rejector = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (!rejector) {
            throw new AppError('Rejector not found', 404);
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: rejectionStatus,
                rejectedBy: rejector.name,
                rejectedAt: new Date(),
                rejectionReason: sanitizeString(reason),
            },
        });

        // Log the action
        await logAction({
            userId,
            action: 'REJECT_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { reason, rejectedBy: userRole },
            ipAddress: req.ip
        });

        // employee is already fetched above

        // Check if employee and rejector exist (redundant check but good for safety)
        if (employee && rejector) {
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const rejectionDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            let rejectedByRole = 'Approver';
            if (rejectionStatus === 'REJECTED_OM') rejectedByRole = 'Operations Manager';
            else if (rejectionStatus === 'REJECTED_GM') rejectedByRole = 'General Manager';
            else if (rejectionStatus === 'REJECTED_ADMIN') rejectedByRole = 'Administrator';

            const emailTemplate = emailTemplates.leaveRejected(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                rejectedByRole,
                rejector.name,
                rejectionDateFormatted,
                reason
            );

            // Create in-app notification
            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request Rejected',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been rejected. Reason: ${reason}`,
                    type: 'REJECTION',
                    link: '/profile',
                },
            });

            // Send email notification
            await sendEmail({
                to: employee.user.email,
                subject: emailTemplate.subject,
                html: emailTemplate.html,
            });
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

export const getMyLeaveRequests = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const userId = (req as AuthRequest).user!.id;
        const { page = '1', limit = '10', status, search, type, startDate, endDate } = req.query;

        // Parse and validate pagination parameters
        const pageNumber = Math.max(1, Number.parseInt(page as string, 10));
        const limitNumber = Math.min(100, Math.max(1, Number.parseInt(limit as string, 10)));
        const skip = (pageNumber - 1) * limitNumber;

        const employee = await prisma.employee.findUnique({ where: { userId } });

        if (!employee) {
            return res.status(200).json({ status: 'success', results: 0, data: { leaveRequests: [] } });
        }

        const where: Prisma.LeaveRequestWhereInput = {
            employeeId: employee.id
        };

        // Apply filters
        if (status && status !== 'all') {
            where.status = status as string;
        }

        if (type && type !== 'all') {
            where.leaveType = type as string;
        }

        if (startDate || endDate) {
            where.startDate = {};
            if (startDate) (where.startDate as Prisma.DateTimeFilter).gte = new Date(startDate as string);
            if (endDate) (where.startDate as Prisma.DateTimeFilter).lte = new Date(endDate as string);
        }

        if (search) {
            where.reason = { contains: search as string };
        }

        const [leaveRequests, total] = await Promise.all([
            prisma.leaveRequest.findMany({
                where,
                skip,
                take: limitNumber,
                include: {
                    employee: {
                        include: {
                            user: { select: { name: true, email: true } }
                        }
                    },
                    omApprover: { select: { name: true, email: true, signature: true } },
                    gmApprover: { select: { name: true, email: true, signature: true } },
                },
                orderBy: { createdAt: 'desc' },
            }),
            prisma.leaveRequest.count({ where })
        ]);

        const totalPages = Math.ceil(total / limitNumber);

        res.status(200).json({
            status: 'success',
            results: leaveRequests.length,
            total,
            page: pageNumber,
            limit: limitNumber,
            totalPages,
            data: { leaveRequests },
        });
    } catch (error) {
        next(error);
    }
};

// Get all leave requests for the same department as the requesting user
export const getDepartmentLeaves = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const userId = (req as AuthRequest).user!.id;
        const { page = '1', limit = '10', status, search, type, startDate, endDate, employeeId } = req.query;

        // Parse and validate pagination parameters
        const pageNumber = Math.max(1, Number.parseInt(page as string, 10));
        const limitNumber = Math.min(100, Math.max(1, Number.parseInt(limit as string, 10)));
        const skip = (pageNumber - 1) * limitNumber;

        const employee = await prisma.employee.findUnique({ where: { userId } });
        if (!employee) throw new AppError('Employee profile not found', 404);

        const where: Prisma.LeaveRequestWhereInput = {
            employee: {
                department: employee.department,
                user: {
                    isActive: true,
                    name: search ? { contains: search as string } : undefined
                },
                id: employeeId && employeeId !== 'all' ? employeeId as string : undefined
            },
            status: status && status !== 'all' ? status as string : undefined,
            leaveType: type && type !== 'all' ? type as string : undefined,
            startDate: (startDate || endDate) ? {
                gte: startDate ? new Date(startDate as string) : undefined,
                lte: endDate ? new Date(endDate as string) : undefined
            } : undefined
        };

        const [leaveRequests, total] = await Promise.all([
            prisma.leaveRequest.findMany({
                where,
                skip,
                take: limitNumber,
                include: {
                    employee: {
                        include: {
                            user: { select: { name: true, email: true } }
                        }
                    },
                    omApprover: { select: { name: true, email: true, signature: true } },
                    gmApprover: { select: { name: true, email: true, signature: true } },
                },
                orderBy: { createdAt: 'desc' },
            }),
            prisma.leaveRequest.count({ where })
        ]);

        const totalPages = Math.ceil(total / limitNumber);

        res.status(200).json({
            status: 'success',
            results: leaveRequests.length,
            total,
            page: pageNumber,
            limit: limitNumber,
            totalPages,
            data: { leaveRequests },
        });
    } catch (error) {
        next(error);
    }
};

export const getAllLeaveRequests = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { status, page = '1', limit = '20', search, type, startDate, endDate, employeeId } = req.query;

        // Parse and validate pagination parameters
        const pageNumber = Math.max(1, Number.parseInt(page as string, 10));
        const limitNumber = Math.min(100, Math.max(1, Number.parseInt(limit as string, 10))); // Max 100 items per page
        const skip = (pageNumber - 1) * limitNumber;

        const where: Prisma.LeaveRequestWhereInput = {
            employee: {
                user: {
                    isActive: true,
                    name: search ? { contains: search as string } : undefined
                },
                id: employeeId && employeeId !== 'all' ? employeeId as string : undefined
            },
            status: status ? (status as string).includes(',') ? { in: (status as string).split(',') } : status as string : undefined,
            leaveType: type && type !== 'all' ? type as string : undefined,
            startDate: (startDate || endDate) ? {
                gte: startDate ? new Date(startDate as string) : undefined,
                lte: endDate ? new Date(endDate as string) : undefined
            } : undefined
        };

        // Execute count and fetch in parallel for better performance
        const [leaveRequests, total] = await Promise.all([
            prisma.leaveRequest.findMany({
                where,
                skip,
                take: limitNumber,
                include: {
                    employee: {
                        include: {
                            user: {
                                select: { name: true, email: true },
                            },
                        },
                    },
                    omApprover: { select: { name: true, email: true, signature: true } },
                    gmApprover: { select: { name: true, email: true, signature: true } },
                },
                orderBy: { createdAt: 'desc' },
            }),
            prisma.leaveRequest.count({ where })
        ]);

        const totalPages = Math.ceil(total / limitNumber);

        res.status(200).json({
            status: 'success',
            results: leaveRequests.length,
            total,
            page: pageNumber,
            limit: limitNumber,
            totalPages,
            hasNextPage: pageNumber < totalPages,
            hasPrevPage: pageNumber > 1,
            data: { leaveRequests },
        });
    } catch (error) {
        next(error);
    }
};

export const getLeaveRequestById = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: {
                employee: {
                    include: {
                        user: {
                            select: { name: true, email: true },
                        },
                    },
                },
                omApprover: { select: { name: true, email: true, role: true, signature: true } },
                gmApprover: { select: { name: true, email: true, role: true, signature: true } },
            },
        });

        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest },
        });
    } catch (error) {
        next(error);
    }
};

===
import { Request, Response, NextFunction } from 'express';
import { z } from 'zod';
import prisma, { Prisma } from '../prisma/client';
import { AppError } from '../middleware/error';
import { AuthRequest } from '../middleware/auth';
import { logAction } from '../utils/logger';
import { sendEmail, emailTemplates } from '../services/email.service';
import { sanitizeString } from '../utils/sanitize';
import { calculateLeaveDays, isSunday, isKenyanPublicHoliday, getDatesInRange } from '../utils/holidays';
import { isGeneralManagerAway, getRoleApprovalStatus, isCEOAway } from '../utils/approvalUtils';
import { APP_CONSTANTS } from '../utils/constants';

// Typed interfaces for JSON fields
interface LeaveBalances {
    [key: string]: number | undefined;
    annual?: number;
    sick?: number;
}

interface LeaveRequestWithScattered {
    isScattered?: boolean;
    scatteredDates?: string[];
    [key: string]: unknown;
}

/** Safely cast a Prisma leave request to access its JSON  scattered fields */
function asScattered(req: Record<string, unknown>): LeaveRequestWithScattered {
    return req as LeaveRequestWithScattered;
}

/**
 * Check if a user is authorized to approve a leave request based on the selected line manager
 */
async function checkLineManagerAuthorization(userId: string, leaveRequest: any): Promise<boolean> {
    const user = await prisma.user.findUnique({ where: { id: userId } });
    if (!user) return false;

    // --- Delegation / Substitute Check ---
    // If the status is PENDING_OM, check if the current user is the substitute for the Operations Manager
    if (leaveRequest.status === 'PENDING_OM') {
        const { isAway, substituteId } = await getRoleApprovalStatus(APP_CONSTANTS.ROLES.OPERATIONS_MANAGER);
        if (isAway && substituteId === userId) return true;
        
        // GM and CTO can always approve OM level requests as per management hierarchy
        if (user.role === APP_CONSTANTS.ROLES.GENERAL_MANAGER || user.role === APP_CONSTANTS.ROLES.CTO) return true;
    }

    // If the status is PENDING_HOD_PROJECTS, check if the current user is the substitute for the HOD Projects
    if (leaveRequest.status === 'PENDING_HOD_PROJECTS') {
        const { isAway, substituteId } = await getRoleApprovalStatus(APP_CONSTANTS.ROLES.HOD_PROJECTS);
        if (isAway && substituteId === userId) return true;

        // GM and CTO can always approve HOD level requests as per management hierarchy
        if (user.role === APP_CONSTANTS.ROLES.GENERAL_MANAGER || user.role === APP_CONSTANTS.ROLES.CTO) return true;
    }
    // ------------------------------------

    // If no handoverLineManager is specified, fall back to role-based authorization
    if (!leaveRequest.handoverLineManager) {
        // Allow OM to approve PENDING_OM requests
        if (leaveRequest.status === 'PENDING_OM' && user.role === 'OPERATIONS_MANAGER') {
            return true;
        }
        // Allow HOD_PROJECTS to approve PENDING_HOD_PROJECTS requests
        if (leaveRequest.status === 'PENDING_HOD_PROJECTS' && user.role === 'HOD_PROJECTS') {
            return true;
        }
        return false;
    }

    // Check if the current user is the selected line manager
    const lineManager = await prisma.employee.findFirst({
        where: {
            user: {
                isActive: true,
                name: leaveRequest.handoverLineManager,
            },
        },
        include: { user: true },
    });

    // Also check if the current user is a substitute for the selected line manager
    if (lineManager?.user) {
        if (lineManager.user.id === userId) return true;
        
        // Check if the current user is the designated substitute for the line manager's role
        const { isAway, substituteId } = await getRoleApprovalStatus(lineManager.user.role);
        if (isAway && substituteId === userId) return true;
    }

    return false;
}

const createLeaveSchema = z.object({
    startDate: z.string(),
    endDate: z.string(),
    leaveType: z.enum(['ANNUAL', 'SICK', 'MATERNITY', 'PATERNITY']),
    description: z.string().optional(),

    // Scattered leave support
    isScattered: z.boolean().optional().default(false),
    scatteredDates: z.array(z.string()).optional(), // Array of ISO date strings

    // Contact and handover information
    contactWhileOnLeave: z.string().optional(),
    handoverLineManager: z.string().optional(),
    handoverCC: z.string().optional(),
    handoverDepartment: z.string().optional(),
    handoverNotes: z.string().optional(),

    // Handover Report Table
    handoverWorkStatus: z.string().optional(),
    handoverActions: z.string().optional(),
    handoverRelationships: z.string().optional(),

    // Employee signature
    employeeSignature: z.string().optional(),
    
    // Reservation linking
    reservationId: z.string().optional(),
});

const omApprovalSchema = z.object({
    comments: z.string().optional(),
});

const adminApprovalSchema = z.object({
    comments: z.string().optional(),
});

const gmApprovalSchema = z.object({
    comments: z.string().optional(),
});

const rejectionSchema = z.object({
    reason: z.string().min(1, 'Rejection reason is required'),
});

export const createLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { startDate, endDate, leaveType, description, isScattered, scatteredDates, contactWhileOnLeave, handoverLineManager, handoverCC, handoverDepartment, handoverWorkStatus, handoverActions, handoverRelationships, employeeSignature, reservationId } = createLeaveSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        // Employee can only create request for themselves
        const employee = await prisma.employee.findUnique({
            where: { userId },
            include: { user: true },
        });
        if (!employee) {
            throw new AppError('Employee profile not found', 404);
        }

        // Gender-based leave validation
        if (leaveType === 'MATERNITY' && employee.gender !== 'FEMALE') {
            throw new AppError('Maternity leave is only available for female employees', 400);
        }
        if (leaveType === 'PATERNITY' && employee.gender !== 'MALE') {
            throw new AppError('Paternity leave is only available for male employees', 400);
        }

        // Basic validation: End date on or after start date
        if (new Date(endDate) < new Date(startDate)) {
            throw new AppError('End date must be on or after start date', 400);
        }

        // Prevent requesting leave on past dates
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const requestStart = new Date(startDate);
        requestStart.setHours(0, 0, 0, 0);
        if (requestStart < today) {
            throw new AppError('Cannot request leave for dates that have already passed', 400);
        }

        // Validate selected line manager name against the allowed approval roles
        if (handoverLineManager) {
            const manager = await prisma.employee.findFirst({
                where: {
                    user: {
                        isActive: true,
                        name: handoverLineManager,
                        role: { in: ['OPERATIONS_MANAGER', 'HOD_PROJECTS', 'GENERAL_MANAGER', 'CTO'] },
                    },
                },
                include: { user: true },
            });

            if (!manager) {
                throw new AppError('Invalid line manager selection', 400);
            }
        }

        // Validate scattered dates if provided
        if (isScattered && scatteredDates) {
            if (scatteredDates.length === 0) {
                throw new AppError('At least one date must be selected for scattered leave', 400);
            }
            // Ensure all scattered dates fall within the range and are not in the past
            const start = new Date(startDate);
            const end = new Date(endDate);
            for (const dateStr of scatteredDates) {
                const d = new Date(dateStr);
                if (d < start || d > end) {
                    throw new AppError('All scattered dates must fall within the start and end date range', 400);
                }
                const scatteredDay = new Date(dateStr);
                scatteredDay.setHours(0, 0, 0, 0);
                if (scatteredDay < today) {
                    throw new AppError(`Cannot request leave for a past date: ${scatteredDay.toLocaleDateString()}`, 400);
                }
            }
        }

        // For scattered leaves, explicitly validate the user didn't bypass the UI to pick invalid days
        if (isScattered && scatteredDates) {
            for (const dateStr of scatteredDates) {
                const normalizedDate = dateStr.split('T')[0];
                if (isSunday(normalizedDate)) {
                    throw new AppError(`Cannot select a Sunday for scattered leave: ${new Date(normalizedDate + 'T00:00:00').toLocaleDateString()}`, 400);
                }
                if (isKenyanPublicHoliday(normalizedDate)) {
                    throw new AppError(`Cannot select a public holiday for scattered leave: ${new Date(normalizedDate + 'T00:00:00').toLocaleDateString()}`, 400);
                }
            }
        }

        // Calculate days requested (accounting for half-day Saturdays for MON_SAT employees)
        const employeeWorkSchedule = (employee.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
        const daysRequested = calculateLeaveDays(
            startDate.split('T')[0],
            endDate.split('T')[0],
            employeeWorkSchedule,
            isScattered && scatteredDates ? scatteredDates.map(d => d.split('T')[0]) : undefined,
        );

        if (daysRequested <= 0) {
            throw new AppError('No valid working days in the selected date range', 400);
        }

        // Check balance based on leave type (only ANNUAL and SICK have tracked balances)
        const leaveBalances = JSON.parse(employee.leaveBalances as string) as LeaveBalances;
        const leaveTypeKey = leaveType.toLowerCase();

        if ((leaveType === 'ANNUAL' || leaveType === 'SICK') && leaveBalances[leaveTypeKey] !== undefined) {
            const availableBalance = leaveBalances[leaveTypeKey];
            if (availableBalance < daysRequested) {
                throw new AppError(`Insufficient ${leaveType.toLowerCase()} leave balance. You have ${availableBalance} days remaining.`, 400);
            }
        }

        // Check for overlapping leave requests (covers both regular and scattered)
        const existingRequests = await prisma.leaveRequest.findMany({
            where: {
                employeeId: employee.id,
                status: { in: ['PENDING_OM', 'PENDING_GM', 'PENDING_ADMIN', 'APPROVED'] },
            },
        });

        if (isScattered && scatteredDates) {
            // For scattered leave, check each individual date against existing requests
            for (const dateStr of scatteredDates) {
                const scatteredDay = new Date(dateStr);
                scatteredDay.setHours(0, 0, 0, 0);

                for (const existing of existingRequests) {
                    const existingScattered = asScattered(existing as unknown as Record<string, unknown>);
                    if (existingScattered.isScattered && existingScattered.scatteredDates) {
                        // Check against other scattered dates
                        for (const existingDateStr of existingScattered.scatteredDates) {
                            const existingDay = new Date(existingDateStr);
                            existingDay.setHours(0, 0, 0, 0);
                            if (scatteredDay.getTime() === existingDay.getTime()) {
                                throw new AppError(`You already have a leave request on ${scatteredDay.toLocaleDateString()}`, 400);
                            }
                        }
                    } else {
                        // Check against regular date ranges
                        const existStart = new Date(existing.startDate);
                        existStart.setHours(0, 0, 0, 0);
                        const existEnd = new Date(existing.endDate);
                        existEnd.setHours(0, 0, 0, 0);
                        if (scatteredDay >= existStart && scatteredDay <= existEnd) {
                            throw new AppError(`You already have a leave request covering ${scatteredDay.toLocaleDateString()}`, 400);
                        }
                    }
                }
            }
        } else {
            // For regular date ranges, check for overlapping ranges
            const reqStart = new Date(startDate);
            reqStart.setHours(0, 0, 0, 0);
            const reqEnd = new Date(endDate);
            reqEnd.setHours(0, 0, 0, 0);

            for (const existing of existingRequests) {
                const existingScattered = asScattered(existing as unknown as Record<string, unknown>);
                if (existingScattered.isScattered && existingScattered.scatteredDates) {
                    // Check if any existing scattered date falls within the new range
                    for (const existingDateStr of existingScattered.scatteredDates) {
                        const existingDay = new Date(existingDateStr);
                        existingDay.setHours(0, 0, 0, 0);
                        if (existingDay >= reqStart && existingDay <= reqEnd) {
                            throw new AppError(`You already have a scattered leave on ${existingDay.toLocaleDateString()} which falls within this period`, 400);
                        }
                    }
                } else {
                    // Check range-vs-range overlap
                    const existStart = new Date(existing.startDate);
                    existStart.setHours(0, 0, 0, 0);
                    const existEnd = new Date(existing.endDate);
                    existEnd.setHours(0, 0, 0, 0);
                    if (reqStart <= existEnd && reqEnd >= existStart) {
                        throw new AppError('You already have a leave request overlapping with this period.', 400);
                    }
                }
            }
        }

        // Determine initial status based on selected line manager
        let initialStatus: string = 'PENDING_OM';
        const userRole = (req as AuthRequest).user!.role.toUpperCase().replace(/\s+/g, '_');
        const userDept = (employee.department || '').toUpperCase();

        let omApproverRef = null;
        let omDateRef = null;
        let gmApproverRef = null;
        let gmDateRef = null;
        let adminNameRef = null;
        let adminDateRef = null;

        // Check if this is a conversion from a fully approved reservation
        if (reservationId) {
            const reservation = await prisma.reservation.findUnique({
                where: { id: reservationId },
                include: {
                    omApprover: { select: { name: true } },
                    gmApprover: { select: { name: true } },
                    adminApprover: { select: { name: true } }
                }
            });

            if (reservation?.status === 'RESERVED' && reservation.employeeId === employee.id) {
                initialStatus = 'APPROVED';
                omApproverRef = reservation.omApproverId;
                omDateRef = reservation.omApprovalDate;
                gmApproverRef = reservation.gmApproverId;
                gmDateRef = reservation.gmApprovalDate;
                adminNameRef = reservation.adminApprover?.name || 'Administrator (Approved via Reservation)';
                adminDateRef = reservation.adminApprovalDate;
            }
        }

        if (initialStatus !== 'APPROVED') {
            // Route based on selected line manager
            if (handoverLineManager) {
                const lineManager = await prisma.employee.findFirst({
                    where: {
                        user: {
                            isActive: true,
                            name: handoverLineManager,
                        },
                    },
                    include: { user: true },
                });

                if (lineManager?.user?.role === 'OPERATIONS_MANAGER') {
                    initialStatus = 'PENDING_OM';
                } else if (lineManager?.user?.role === 'HOD_PROJECTS') {
                    initialStatus = 'PENDING_HOD_PROJECTS';
                } else {
                    // Fallback to default logic if line manager role is not recognized
                    initialStatus = 'PENDING_OM';
                }
            } else {
                // Fallback to original logic if no line manager selected
                if (userRole === 'GENERAL_MANAGER' || userRole === 'CTO') {
                    initialStatus = 'PENDING_ADMIN';
                } else if (userRole === 'OPERATIONS_MANAGER') {
                    initialStatus = 'PENDING_GM';
                } else if (userRole === 'HOD_PROJECTS') {
                    initialStatus = 'PENDING_GM'; // HOD Projects skips their own approval
                } else if (userDept === 'PROJECTS') {
                    initialStatus = 'PENDING_HOD_PROJECTS'; // Projects employees go to HOD first
                } else {
                    // Administrators and all other employees go to OM first
                    initialStatus = 'PENDING_OM';
                }
            }
        }

        const leaveRequest = await prisma.leaveRequest.create({
            data: {
                employeeId: employee.id,
                startDate: new Date(startDate),
                endDate: new Date(endDate),
                leaveType,
                description: sanitizeString(description),
                isScattered: isScattered || false,
                scatteredDates: isScattered && scatteredDates ? JSON.stringify(scatteredDates) : undefined,
                contactWhileOnLeave: sanitizeString(contactWhileOnLeave),
                handoverLineManager: sanitizeString(handoverLineManager),
                handoverCC: sanitizeString(handoverCC),
                handoverDepartment: sanitizeString(handoverDepartment),
                handoverNotes: "", // Deprecated field
                handoverWorkStatus: sanitizeString(handoverWorkStatus),
                handoverActions: sanitizeString(handoverActions),
                handoverRelationships: sanitizeString(handoverRelationships),
                employeeSignature: sanitizeString(employeeSignature),
                employeeSignatureDate: employeeSignature ? new Date() : null,
                // Inherited or new approval details
                status: initialStatus,
                omApproverId: omApproverRef,
                omApprovalDate: omDateRef,
                gmApproverId: gmApproverRef,
                gmApprovalDate: gmDateRef,
                approverName: adminNameRef,
                approverSignatureDate: adminDateRef,
            },
        });

        // Deduct balance immediately if auto-approved (Administrator)
        if (initialStatus === 'APPROVED' && (leaveType === 'ANNUAL' || leaveType === 'SICK')) {
            const leaveBalances = JSON.parse(employee.leaveBalances as string) as LeaveBalances;
            const leaveTypeKey = leaveType.toLowerCase();
            if (leaveBalances[leaveTypeKey] !== undefined) {
                leaveBalances[leaveTypeKey] = Math.max(0, leaveBalances[leaveTypeKey]! - daysRequested);
                await prisma.employee.update({
                    where: { id: employee.id },
                    data: { leaveBalances: JSON.stringify(leaveBalances) }
                });
            }
        }

        // Log the action
        await logAction({
            userId,
            action: 'CREATE_LEAVE_REQUEST',
            entityType: 'LeaveRequest',
            entityId: leaveRequest.id,
            details: { leaveType, startDate, endDate, status: initialStatus },
            ipAddress: req.ip
        });

        // Notifications logic based on initial status
        if (initialStatus !== 'APPROVED') {
            let approvers: { id: string; name: string; email: string }[] = [];
            let notificationLink = '';
            let approvalLevel = '';

            if (handoverLineManager) {
                // Send notification to the specific selected line manager
                const lineManager = await prisma.employee.findFirst({
                    where: {
                        user: {
                            isActive: true,
                            name: handoverLineManager,
                        },
                    },
                    include: { user: true },
                });

                if (lineManager?.user) {
                    approvers = [{
                        id: lineManager.user.id,
                        name: lineManager.user.name,
                        email: lineManager.user.email,
                    }];

                    if (lineManager.user.role === 'OPERATIONS_MANAGER') {
                        notificationLink = '/requests?status=PENDING_OM';
                        approvalLevel = 'Operations Manager';
                    } else if (lineManager.user.role === 'HOD_PROJECTS') {
                        notificationLink = '/requests?status=PENDING_HOD_PROJECTS';
                        approvalLevel = 'Projects HOD';
                    }
                }
            } else {
                // Fallback to original notification logic
                if (initialStatus === 'PENDING_HOD_PROJECTS') {
                    approvers = await prisma.user.findMany({ where: { role: 'HOD_PROJECTS' } });
                    notificationLink = '/requests?status=PENDING_HOD_PROJECTS';
                    approvalLevel = 'Projects HOD';
                } else if (initialStatus === 'PENDING_OM') {
                    approvers = await prisma.user.findMany({ where: { role: 'OPERATIONS_MANAGER' } });
                    notificationLink = '/requests?status=PENDING_OM';
                    approvalLevel = 'Operations Manager';
                } else if (initialStatus === 'PENDING_GM') {
                    approvers = await prisma.user.findMany({ where: { role: 'GENERAL_MANAGER' } });
                    notificationLink = '/requests?status=PENDING_GM';
                    approvalLevel = 'General Manager';
                } else if (initialStatus === 'PENDING_ADMIN') {
                    approvers = await prisma.user.findMany({ where: { role: 'ADMINISTRATOR' } });
                    notificationLink = '/requests?status=PENDING_ADMIN';
                    approvalLevel = 'ADMINISTRATOR';
                }
            }

            if (approvers.length > 0) {
                const emailTemplate = emailTemplates.newLeaveRequest(
                    employee.user.name,
                    leaveType,
                    new Date(startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
                    new Date(endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
                    daysRequested,
                    description,
                    employee.department,
                    isScattered,
                    scatteredDates,
                    approvalLevel
                );

                await Promise.all(
                    approvers.map(async (approver) => {
                        await prisma.notification.create({
                            data: {
                                userId: approver.id,
                                title: 'New Leave Request',
                                message: `${employee.user.name} has submitted a ${leaveType.toLowerCase()} leave request requiring your approval`,
                                type: 'LEAVE_REQUEST',
                                link: notificationLink,
                            },
                        });

                        await sendEmail({
                            to: approver.email,
                            subject: `[${approvalLevel} Approval Required] ${emailTemplate.subject}`,
                            html: emailTemplate.html,
                        });
                    })
                );
            }
        }

        res.status(201).json({
            status: 'success',
            data: { leaveRequest },
        });
    } catch (error) {
        next(error);
    }
};

export const updateLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const userId = (req as AuthRequest).user!.id;

        // Validate request body
        const {
            startDate,
            endDate,
            leaveType,
            description,
            isScattered,
            scatteredDates,
            contactWhileOnLeave,
            handoverLineManager,
            handoverCC,
            handoverDepartment,
            handoverNotes,
            handoverWorkStatus,
            handoverActions,
            handoverRelationships,
            employeeSignature
        } = createLeaveSchema.parse(req.body);

        // Find existing request
        const existingRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });

        if (!existingRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check ownership
        if (existingRequest.employee.userId !== userId) {
            throw new AppError('You can only edit your own requests', 403);
        }

        // Check status
        if (existingRequest.status !== 'PENDING_OM') {
            throw new AppError('Can only edit requests pending OM approval', 400);
        }

        if (handoverLineManager) {
            const manager = await prisma.employee.findFirst({
                where: {
                    user: {
                        isActive: true,
                        name: handoverLineManager,
                        role: { in: ['OPERATIONS_MANAGER', 'HOD_PROJECTS', 'GENERAL_MANAGER', 'CTO'] },
                    },
                },
                include: { user: true },
            });

            if (!manager) {
                throw new AppError('Invalid line manager selection', 400);
            }
        }

        // Gender-based leave validation
        if (leaveType === 'MATERNITY' && existingRequest.employee.gender !== 'FEMALE') {
            throw new AppError('Maternity leave is only available for female employees', 400);
        }
        if (leaveType === 'PATERNITY' && existingRequest.employee.gender !== 'MALE') {
            throw new AppError('Paternity leave is only available for male employees', 400);
        }

        // Basic validation: End date on or after start date
        if (new Date(endDate) < new Date(startDate)) {
            throw new AppError('End date must be on or after start date', 400);
        }

        // Calculate days requested (accounting for half-day Saturdays)
        const employeeWorkSchedule = (existingRequest.employee.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
        const daysRequested = calculateLeaveDays(
            startDate.split('T')[0],
            endDate.split('T')[0],
            employeeWorkSchedule,
            isScattered && scatteredDates ? scatteredDates.map(d => d.split('T')[0]) : undefined,
        );

        // Check balance based on leave type
        // Note: We need to account for the fact that we might be changing the duration
        // Ideally we should "refund" the previous duration and deduct the new one, 
        // but currently balance is only deducted on APPROVAL (GM phase).
        // So we just need to check if they have enough balance for the NEW duration.
        // Since it's PENDING_OM, no balance has been deducted yet.

        const leaveBalances = JSON.parse(existingRequest.employee.leaveBalances as string) as LeaveBalances;
        const leaveTypeKey = leaveType.toLowerCase();

        if ((leaveType === 'ANNUAL' || leaveType === 'SICK') && leaveBalances[leaveTypeKey] !== undefined) {
            const availableBalance = leaveBalances[leaveTypeKey];
            if (availableBalance < daysRequested) {
                throw new AppError(`Insufficient ${leaveType.toLowerCase()} leave balance. You have ${availableBalance} days remaining.`, 400);
            }
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                startDate: new Date(startDate),
                endDate: new Date(endDate),
                leaveType,
                description: sanitizeString(description),
                isScattered: isScattered || false,
                scatteredDates: isScattered && scatteredDates ? JSON.stringify(scatteredDates) : undefined,
                contactWhileOnLeave: sanitizeString(contactWhileOnLeave),
                handoverLineManager: sanitizeString(handoverLineManager),
                handoverCC: sanitizeString(handoverCC),
                handoverDepartment: sanitizeString(handoverDepartment),
                handoverNotes: sanitizeString(handoverNotes),
                handoverWorkStatus: sanitizeString(handoverWorkStatus),
                handoverActions: sanitizeString(handoverActions),
                handoverRelationships: sanitizeString(handoverRelationships),
                employeeSignature: sanitizeString(employeeSignature),
                employeeSignatureDate: employeeSignature ? new Date() : null,
            },
        });

        // Log the action
        await logAction({
            userId,
            action: 'UPDATE_LEAVE_REQUEST',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { leaveType, startDate, endDate },
            ipAddress: req.ip
        });

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

// Operations Manager Approval (Phase 1)


// Projects HOD Approval (Phase 1)
export const hodApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = omApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check if user is authorized to approve this request
        const isAuthorized = await checkLineManagerAuthorization(userId, leaveRequest);
        if (!isAuthorized) {
            throw new AppError('You are not authorized to approve this leave request', 403);
        }

        if (!['PENDING_HOD_PROJECTS', 'PENDING_OM'].includes(leaveRequest.status)) {
            throw new AppError('Leave request is not pending approval', 400);
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: 'PENDING_GM',
                omApproverId: userId, // Reuse omApproverId for record keeping but rename in UI
                omApprovalDate: new Date(),
                omApprovalComments: sanitizeString(comments),
            },
        });

        // Notifications logic
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        const hodApprover = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (employee && hodApprover) {
            // Format dates
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const hodApprovalDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Create in-app notification for employee
            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request HOD Approved',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by the Projects HOD and is now pending GM endorsement.`,
                    type: 'APPROVAL',
                    link: '/my-history',
                },
            });

            // Send notification to employee
            const employeeEmail = emailTemplates.hodApprovedToEmployee(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                hodApprover.name,
                hodApprovalDateFormatted,
                asScattered(leaveRequest as any).isScattered
            );

            await sendEmail({
                to: employee.user.email,
                subject: employeeEmail.subject,
                html: employeeEmail.html,
            });

            // Notify all GMs
            const gms = await prisma.user.findMany({ where: { role: 'GENERAL_MANAGER' } });
            
            // Calculate days requested
            const workSchedule = employee.workSchedule as 'MON_FRI' | 'MON_SAT' || 'MON_FRI';
            const startDateStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
            const endDateStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
            const reqScattered = asScattered(leaveRequest as any);
            let parsedScatteredDates: string[] | undefined;
            if (reqScattered.isScattered && reqScattered.scatteredDates) {
                try {
                    parsedScatteredDates = typeof reqScattered.scatteredDates === 'string' 
                        ? JSON.parse(reqScattered.scatteredDates as any) 
                        : reqScattered.scatteredDates;
                } catch { /* ignore */ }
            }
            const scatteredArr = parsedScatteredDates ? parsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
            const daysCount = calculateLeaveDays(startDateStr, endDateStr, workSchedule, scatteredArr);

            const gmEmail = emailTemplates.hodApprovedToGM(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                daysCount,
                hodApprover.name,
                hodApprovalDateFormatted,
                leaveRequest.description || undefined,
                reqScattered.isScattered,
                parsedScatteredDates
            );

            await Promise.all(gms.map(async (gm) => {
                // In-app notification for GM
                await prisma.notification.create({
                    data: {
                        userId: gm.id,
                        title: 'Leave Request Pending GM Endorsement',
                        message: `${employee.user.name}'s Projects leave request has been approved by HOD and requires your endorsement.`,
                        type: 'APPROVAL',
                        link: '/requests?status=PENDING_GM',
                    },
                });

                // Email for GM
                await sendEmail({
                    to: gm.email,
                    subject: gmEmail.subject,
                    html: gmEmail.html,
                });
            }));
        }

        // Success response
        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};
export const omApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = omApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check if user is authorized to approve this request
        const isAuthorized = await checkLineManagerAuthorization(userId, leaveRequest);
        if (!isAuthorized) {
            throw new AppError('You are not authorized to approve this leave request', 403);
        }

        if (!['PENDING_HOD_PROJECTS', 'PENDING_OM'].includes(leaveRequest.status)) {
            throw new AppError('Leave request is not pending approval', 400);
        }

        // Determine if this is a substitute action
        const userRole = (req as AuthRequest).user!.role;
        const isGMAction = userRole === APP_CONSTANTS.ROLES.GENERAL_MANAGER || userRole === APP_CONSTANTS.ROLES.CTO;
        
        // --- Double-Jump Logic ---
        // If a GM (or CTO acting for GM) is approving for OM/HOD, they bypass the PENDING_GM stage
        const isCEOAbsent = await isCEOAway();
        let nextStatus = 'PENDING_GM';
        if (isGMAction) {
            nextStatus = isCEOAbsent ? 'APPROVED' : 'PENDING_ADMIN';
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: nextStatus,
                omApproverId: userId,
                omApprovalDate: new Date(),
                omApprovalComments: sanitizeString(comments),
                omSubstituteId: !isGMAction ? userId : null, // Record if someone else acted as substitute
                ...(isGMAction && {
                    gmApproverId: userId,
                    gmApprovalDate: new Date(),
                    gmApprovalComments: 'Auto-endorsed via Double-Jump logic (Acting on behalf of OM/HOD)',
                }),
                ...(isGMAction && isCEOAbsent && {
                    approverName: 'System (CEO Absent)',
                    approverSignatureDate: new Date()
                })
            } as any,
        });

        // Log the action
        await logAction({
            userId,
            action: 'OM_APPROVE_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { comments },
            ipAddress: req.ip
        });

        // Get employee and OM details
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        const omApprover = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (!employee || !omApprover) {
            throw new AppError('Employee or approver not found', 404);
        }

        // Calculate days
        // Calculate with half-day Saturday support
        const omEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
        const omWorkSchedule = (omEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
        const startDateStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
        const endDateStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
        const reqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);

        // Parse scatteredDates from JSON string if needed
        let parsedScatteredDates: string[] | undefined;
        if (reqScattered.isScattered && reqScattered.scatteredDates) {
            if (typeof reqScattered.scatteredDates === 'string') {
                try { parsedScatteredDates = JSON.parse(reqScattered.scatteredDates as unknown as string); } catch { parsedScatteredDates = undefined; }
            } else {
                parsedScatteredDates = reqScattered.scatteredDates;
            }
        }

        const scatteredArr = parsedScatteredDates ? parsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
        const daysRequested = calculateLeaveDays(startDateStr, endDateStr, omWorkSchedule, scatteredArr);
        const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        const omApprovalDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

        // Send email to employee notifying OM approval
        const employeeEmailTemplate = emailTemplates.omApprovedToEmployee(
            employee.user.name,
            leaveRequest.leaveType,
            formattedStartDate,
            formattedEndDate,
            omApprover.name,
            omApprovalDateFormatted,
            reqScattered.isScattered
        );

        await sendEmail({
            to: employee.user.email,
            subject: employeeEmailTemplate.subject,
            html: employeeEmailTemplate.html,
        });

        // Notify all GMs
        const gms = await prisma.user.findMany({
            where: { role: 'GENERAL_MANAGER' },
        });

        const gmEmailTemplate = emailTemplates.omApprovedToGM(
            employee.user.name,
            leaveRequest.leaveType,
            formattedStartDate,
            formattedEndDate,
            daysRequested,
            omApprover.name,
            omApprovalDateFormatted,
            leaveRequest.description || undefined,
            reqScattered.isScattered,
            parsedScatteredDates
        );

        await Promise.all(
            gms.map(async (gm) => {
                // Create in-app notification
                await prisma.notification.create({
                    data: {
                        userId: gm.id,
                        title: 'Leave Request Pending General Manager Approval',
                        message: `${employee.user.name}'s ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by OM and requires your approval`,
                        type: 'APPROVAL',
                        link: '/requests?status=PENDING_GM',
                    },
                });

                // Send email notification
                await sendEmail({
                    to: gm.email,
                    subject: gmEmailTemplate.subject,
                    html: gmEmailTemplate.html,
                });
            })
        );

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

// General Manager Approval (Phase 2)
export const gmApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = gmApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({ where: { id } });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        if (leaveRequest.status !== 'PENDING_GM') {
            throw new AppError('Leave request must be OM approved first', 400);
        }

        // --- CTO Delegation Logic ---
        const userRole = (req as AuthRequest).user!.role;
        let isGMSubstituteAction = false;
        if (userRole === APP_CONSTANTS.ROLES.CTO) {
            const { isAway } = await isGeneralManagerAway();
            if (!isAway) {
                throw new AppError('The CTO can only approve leave requests when the General Manager is away.', 403);
            }
            isGMSubstituteAction = true;
        }
        // ---------------------------

        // Check if CEO is away for automatic final approval
        const isCEOAbsent = await isCEOAway();
        const nextStatus = isCEOAbsent ? 'APPROVED' : 'PENDING_ADMIN';

        // Update status to PENDING_ADMIN (or APPROVED if CEO is away)
        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: nextStatus,
                gmApproverId: userId,
                gmApprovalDate: new Date(),
                gmApprovalComments: sanitizeString(comments),
                gmSubstituteId: isGMSubstituteAction ? userId : null,
                ...(isCEOAbsent && {
                    approverName: 'System (CEO Absent)',
                    approverSignatureDate: new Date()
                })
            },
        });

        // Log the action
        await logAction({
            userId,
            action: 'GM_APPROVE_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { comments },
            ipAddress: req.ip
        });

        // Notify the employee
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        // Get OM and General Manager approver details
        const omApprover = await prisma.user.findUnique({
            where: { id: leaveRequest.omApproverId! },
        });

        const gmApprover = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (employee && omApprover && gmApprover) {
            // Calculate days and remaining balance
            // Calculate with half-day Saturday support
            const gmEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
            const gmWorkSchedule = (gmEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
            const gmStartStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
            const gmEndStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
            const gmReqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);
            let gmParsedScatteredDates: string[] | undefined;
            if (gmReqScattered.isScattered && gmReqScattered.scatteredDates) {
                if (typeof gmReqScattered.scatteredDates === 'string') {
                    try { gmParsedScatteredDates = JSON.parse(gmReqScattered.scatteredDates as unknown as string); } catch { gmParsedScatteredDates = undefined; }
                } else {
                    gmParsedScatteredDates = gmReqScattered.scatteredDates;
                }
            }
            const gmScattered = gmParsedScatteredDates ? gmParsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
            const daysRequested = calculateLeaveDays(gmStartStr, gmEndStr, gmWorkSchedule, gmScattered);
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const omApprovalDateFormatted = new Date(leaveRequest.omApprovalDate!).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const gmApprovalDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Create in-app notification for employee
            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request GM Approved',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by the General Manager and is pending final Admin approval.`,
                    type: 'APPROVAL',
                    link: '/my-history',
                },
            });

            // Send email to employee notifying GM approval
            await sendEmail({
                to: employee.user.email,
                subject: `✅ Your${gmReqScattered.isScattered ? ' Scattered' : ''} Leave Request Has Been Endorsed by General Manager`,
                html: `
                <!DOCTYPE html>
                <html lang="en">
                <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Leave Request Progress</title></head>
                <body style="margin:0;padding:0;background-color:#F6F6F5;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;">
                    <div style="max-width:600px;margin:40px auto;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e2e8f0;border-top:8px solid #08033F;">
                        <div style="padding:30px;text-align:center;border-bottom:1px solid #F6F6F5;">
                            <img src="cid:company-logo" alt="Company Logo" style="height:50px;display:block;margin:0 auto;">
                            <h1 style="margin:20px 0 0;color:#08033F;font-size:24px;font-weight:800;text-transform:uppercase;letter-spacing:2px;">${gmApprover.role.replace('_', ' ')} Endorsed</h1>
                            <p style="margin:10px 0 0;color:#64748b;font-size:14px;text-transform:uppercase;font-weight:600;">Status: Pending Admin Final Confirmation</p>
                        </div>
                        <div style="padding:40px 30px;">
                            <p style="margin:0 0 20px;color:#1e293b;font-size:16px;">Hi <strong style="color:#08033F;">${employee.user.name}</strong>,</p>
                            <p style="margin:0 0 30px;color:#475569;font-size:16px;line-height:1.6;">
                                Your${gmReqScattered.isScattered ? ' <strong>scattered</strong>' : ''} leave request has been <strong>endorsed by the ${gmApprover.role === 'CTO' ? 'CTO (on behalf of GM)' : 'General Manager'}</strong> and is now advancing to the final stage — Admin confirmation.
                            </p>
                            <div style="background-color:#F6F6F5;padding:25px;border-radius:4px;margin-bottom:30px;">
                                <div style="margin-bottom:20px;padding-bottom:15px;border-bottom:1px solid #e2e8f0;">
                                    <p style="margin:0 0 5px;color:#64748b;font-size:11px;font-weight:800;text-transform:uppercase;">Operations Manager</p>
                                    <p style="margin:0;color:#08033F;font-weight:700;font-size:14px;">✅ Verified by ${omApprover.name} on ${omApprovalDateFormatted}</p>
                                </div>
                                <div style="margin-bottom:20px;padding-bottom:15px;border-bottom:1px solid #e2e8f0;">
                                    <p style="margin:0 0 5px;color:#64748b;font-size:11px;font-weight:800;text-transform:uppercase;">General Manager</p>
                                    <p style="margin:0;color:#08033F;font-weight:700;font-size:14px;">✅ Endorsed by ${gmApprover.name} on ${gmApprovalDateFormatted}</p>
                                </div>
                                <div>
                                    <p style="margin:0 0 5px;color:#64748b;font-size:11px;font-weight:800;text-transform:uppercase;">Administrator</p>
                                    <p style="margin:0;color:#94a3b8;font-weight:700;font-size:14px;">⏳ Pending Final Authorization</p>
                                </div>
                            </div>
                            <p style="margin:0;color:#64748b;font-size:14px;line-height:1.6;text-align:center;">You will receive a final confirmation email once the Administrator completes the authorization.</p>
                        </div>
                        <div style="background-color:#F6F6F5;padding:25px;text-align:center;">
                            <p style="margin:0;color:#08033F;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;">Leave Management System</p>
                            <p style="margin:5px 0 0;color:#94a3b8;font-size:10px;">&copy; ${new Date().getFullYear()} Official Internal Notice</p>
                        </div>
                    </div>
                </body>
                </html>
                `,
            });


            // Get all Administrators
            const adminUsers = await prisma.user.findMany({
                where: { role: 'ADMINISTRATOR' },
            });

            const adminEmailTemplate = emailTemplates.gmApprovedToAdmin({
                employeeName: employee.user.name,
                leaveType: leaveRequest.leaveType,
                startDate: formattedStartDate,
                endDate: formattedEndDate,
                days: daysRequested,
                omName: omApprover.name,
                omApprovalDate: omApprovalDateFormatted,
                gmName: gmApprover.name,
                gmApprovalDate: gmApprovalDateFormatted,
                reason: leaveRequest.description || undefined,
                isScattered: gmReqScattered.isScattered,
                scatteredDates: gmParsedScatteredDates
            });

            await Promise.all(
                adminUsers.map(async (admin) => {
                    // Create in-app notification for Admin
                    await prisma.notification.create({
                        data: {
                            userId: admin.id,
                            title: 'Leave Request Pending Final Approval',
                            message: `${employee.user.name}'s ${leaveRequest.leaveType.toLowerCase()} leave request has been approved by GM and requires your final approval.`,
                            type: 'APPROVAL',
                            link: `/requests?status=PENDING_ADMIN`,
                        },
                    });

                    // Send email notification to Admin
                    await sendEmail({
                        to: admin.email,
                        subject: adminEmailTemplate.subject,
                        html: adminEmailTemplate.html,
                    });
                })
            );
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

// Admin Final Approval (Phase 3 - After Manual Signature)
export const adminApproveLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { comments } = adminApprovalSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;

        const leaveRequest = await prisma.leaveRequest.findUnique({ where: { id } });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        if (leaveRequest.status !== 'PENDING_ADMIN') {
            throw new AppError('Leave request must be GM approved and pending Admin confirmation (after manual signature) first', 400);
        }

        const user = await prisma.user.findUnique({ where: { id: userId } });
        if (!user) {
            throw new AppError('User not found', 404);
        }

        // Prevent admin from approving their own leave request
        const requestEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
        if (requestEmployee?.userId === userId) {
            throw new AppError('You cannot approve your own leave request. The other Administrator must approve it.', 403);
        }

        // Transaction to update status to APPROVED and deduct balance
        const result = await prisma.$transaction(async (tx: Prisma.TransactionClient) => {
            const updatedRequest = await tx.leaveRequest.update({
                where: { id },
                data: {
                    status: 'APPROVED',
                    approverName: user.name,
                    approverSignatureDate: new Date(),
                    approverComments: sanitizeString(comments),
                } as any,
            });

            // Deduct leave balance based on leave type
            if (leaveRequest.leaveType === 'ANNUAL' || leaveRequest.leaveType === 'SICK') {
                // Calculate with half-day Saturday support
                const adminEmployee = await tx.employee.findUnique({ where: { id: leaveRequest.employeeId } });
                const adminWorkSchedule = (adminEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
                const adminStartStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
                const adminEndStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
                const adminReqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);
                let adminParsedScatteredDates: string[] | undefined;
                if (adminReqScattered.isScattered && adminReqScattered.scatteredDates) {
                    if (typeof adminReqScattered.scatteredDates === 'string') {
                        try { adminParsedScatteredDates = JSON.parse(adminReqScattered.scatteredDates as unknown as string); } catch { adminParsedScatteredDates = undefined; }
                    } else {
                        adminParsedScatteredDates = adminReqScattered.scatteredDates;
                    }
                }
                const adminScattered = adminParsedScatteredDates ? adminParsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
                const daysRequested = calculateLeaveDays(adminStartStr, adminEndStr, adminWorkSchedule, adminScattered);

                const employee = await tx.employee.findUnique({ where: { id: leaveRequest.employeeId } });
                if (employee) {
                    const leaveBalances = JSON.parse(employee.leaveBalances as string) as LeaveBalances;
                    const leaveTypeKey = leaveRequest.leaveType.toLowerCase();

                    if (leaveBalances[leaveTypeKey] !== undefined) {
                        leaveBalances[leaveTypeKey] = Math.max(0, leaveBalances[leaveTypeKey]! - daysRequested);

                        await tx.employee.update({
                            where: { id: leaveRequest.employeeId },
                            data: { leaveBalances: JSON.stringify(leaveBalances) }
                        });
                    }
                }
            }

            return updatedRequest;
        });

        // Log the action
        await logAction({
            userId,
            action: 'ADMIN_FINAL_APPROVE_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { finalApprover: 'ADMINISTRATOR' },
            ipAddress: req.ip
        });

        // Notify the employee
        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });

        if (employee) {
            // Send final approval email
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Calculate with half-day Saturday support for email
            const emailEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
            const emailWorkSchedule = (emailEmployee?.workSchedule as 'MON_FRI' | 'MON_SAT') || 'MON_FRI';
            const emailStartStr = new Date(leaveRequest.startDate).toISOString().split('T')[0];
            const emailEndStr = new Date(leaveRequest.endDate).toISOString().split('T')[0];
            const emailReqScattered = asScattered(leaveRequest as unknown as Record<string, unknown>);
            // Parse scatteredDates safely
            let emailParsedScatteredDates: string[] | undefined;
            if (emailReqScattered.isScattered && emailReqScattered.scatteredDates) {
                if (typeof emailReqScattered.scatteredDates === 'string') {
                    try { emailParsedScatteredDates = JSON.parse(emailReqScattered.scatteredDates as unknown as string); } catch { emailParsedScatteredDates = undefined; }
                } else {
                    emailParsedScatteredDates = emailReqScattered.scatteredDates;
                }
            }
            const emailScattered = emailParsedScatteredDates ? emailParsedScatteredDates.map((d: string) => d.split('T')[0]) : undefined;
            const daysRequested = calculateLeaveDays(emailStartStr, emailEndStr, emailWorkSchedule, emailScattered);

            // Safe lookups — omApproverId or gmApproverId can be null if steps were skipped
            const omApprover = leaveRequest.omApproverId
                ? await prisma.user.findUnique({ where: { id: leaveRequest.omApproverId } })
                : null;
            const gmApprover = leaveRequest.gmApproverId
                ? await prisma.user.findUnique({ where: { id: leaveRequest.gmApproverId } })
                : null;

            const omApprovalDateFormatted = leaveRequest.omApprovalDate
                ? new Date(leaveRequest.omApprovalDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                : 'N/A';
            const gmApprovalDateFormatted = leaveRequest.gmApprovalDate
                ? new Date(leaveRequest.gmApprovalDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                : 'N/A';

            const updatedEmployee = await prisma.employee.findUnique({ where: { id: leaveRequest.employeeId } });
            const leaveBalances = updatedEmployee?.leaveBalances ? JSON.parse(updatedEmployee.leaveBalances as string) as LeaveBalances : undefined;
            const remainingBalance = leaveBalances?.[leaveRequest.leaveType.toLowerCase()];

            const emailTemplate = emailTemplates.leaveApproved(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                daysRequested,
                omApprover?.name || 'Operations Manager',
                omApprovalDateFormatted,
                gmApprover?.name || 'General Manager',
                gmApprovalDateFormatted,
                remainingBalance,
                emailReqScattered.isScattered
            );

            await sendEmail({
                to: employee.user.email,
                subject: emailTemplate.subject,
                html: emailTemplate.html,
            });

            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request Finally Approved',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been finally approved`,
                    type: 'APPROVAL',
                    link: '/my-history',
                },
            });
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: result },
        });
    } catch (error) {
        next(error);
    }
};

// Reject Leave Request (Can be done by HR/Admin or General Manager)
export const rejectLeaveRequest = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const { reason } = rejectionSchema.parse(req.body);
        const userId = (req as AuthRequest).user!.id;
        const userRole = (req as AuthRequest).user!.role;
        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: { employee: true }
        });
        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        // Check if user is authorized to reject this request
        const isAuthorized = await checkLineManagerAuthorization(userId, leaveRequest);
        if (!isAuthorized) {
            // Also allow GMs and Admins to reject at any stage
            const user = await prisma.user.findUnique({ where: { id: userId } });
            if (!user || !['GENERAL_MANAGER', 'ADMINISTRATOR'].includes(user.role)) {
                throw new AppError('You are not authorized to reject this leave request', 403);
            }
        }

        const employee = await prisma.employee.findUnique({
            where: { id: leaveRequest.employeeId },
            include: { user: true },
        });


        if (leaveRequest.status === 'REJECTED_OM' || leaveRequest.status === 'REJECTED_GM' || leaveRequest.status === 'REJECTED_ADMIN' || leaveRequest.status === 'APPROVED') {
            throw new AppError('Leave request is already processed', 400);
        }

        // Determine rejection status based on current status
        let rejectionStatus: 'REJECTED_OM' | 'REJECTED_GM' | 'REJECTED_ADMIN';
        if (leaveRequest.status === 'PENDING_OM' || leaveRequest.status === 'PENDING_HOD_PROJECTS') {
            rejectionStatus = 'REJECTED_OM';
        } else if (leaveRequest.status === 'PENDING_GM') {
            rejectionStatus = 'REJECTED_GM';
        } else if (leaveRequest.status === 'PENDING_ADMIN') {
            rejectionStatus = 'REJECTED_ADMIN';
        } else {
            throw new AppError('Invalid leave request status for rejection', 400);
        }

        const rejector = await prisma.user.findUnique({
            where: { id: userId },
        });

        if (!rejector) {
            throw new AppError('Rejector not found', 404);
        }

        const updatedRequest = await prisma.leaveRequest.update({
            where: { id },
            data: {
                status: rejectionStatus,
                rejectedBy: rejector.name,
                rejectedAt: new Date(),
                rejectionReason: sanitizeString(reason),
            },
        });

        // Log the action
        await logAction({
            userId,
            action: 'REJECT_LEAVE',
            entityType: 'LeaveRequest',
            entityId: id,
            details: { reason, rejectedBy: userRole },
            ipAddress: req.ip
        });

        // employee is already fetched above

        // Check if employee and rejector exist (redundant check but good for safety)
        if (employee && rejector) {
            const formattedStartDate = new Date(leaveRequest.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const formattedEndDate = new Date(leaveRequest.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const rejectionDateFormatted = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            let rejectedByRole = 'Approver';
            if (rejectionStatus === 'REJECTED_OM') rejectedByRole = 'Operations Manager';
            else if (rejectionStatus === 'REJECTED_GM') rejectedByRole = 'General Manager';
            else if (rejectionStatus === 'REJECTED_ADMIN') rejectedByRole = 'Administrator';

            const emailTemplate = emailTemplates.leaveRejected(
                employee.user.name,
                leaveRequest.leaveType,
                formattedStartDate,
                formattedEndDate,
                rejectedByRole,
                rejector.name,
                rejectionDateFormatted,
                reason
            );

            // Create in-app notification
            await prisma.notification.create({
                data: {
                    userId: employee.userId,
                    title: 'Leave Request Rejected',
                    message: `Your ${leaveRequest.leaveType.toLowerCase()} leave request has been rejected. Reason: ${reason}`,
                    type: 'REJECTION',
                    link: '/profile',
                },
            });

            // Send email notification
            await sendEmail({
                to: employee.user.email,
                subject: emailTemplate.subject,
                html: emailTemplate.html,
            });
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest: updatedRequest },
        });
    } catch (error) {
        next(error);
    }
};

export const getMyLeaveRequests = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const userId = (req as AuthRequest).user!.id;
        const { page = '1', limit = '10', status, search, type, startDate, endDate } = req.query;

        // Parse and validate pagination parameters
        const pageNumber = Math.max(1, Number.parseInt(page as string, 10));
        const limitNumber = Math.min(100, Math.max(1, Number.parseInt(limit as string, 10)));
        const skip = (pageNumber - 1) * limitNumber;

        const employee = await prisma.employee.findUnique({ where: { userId } });

        if (!employee) {
            return res.status(200).json({ status: 'success', results: 0, data: { leaveRequests: [] } });
        }

        const where: Prisma.LeaveRequestWhereInput = {
            employeeId: employee.id
        };

        // Apply filters
        if (status && status !== 'all') {
            where.status = status as string;
        }

        if (type && type !== 'all') {
            where.leaveType = type as string;
        }

        if (startDate || endDate) {
            where.startDate = {};
            if (startDate) (where.startDate as Prisma.DateTimeFilter).gte = new Date(startDate as string);
            if (endDate) (where.startDate as Prisma.DateTimeFilter).lte = new Date(endDate as string);
        }

        if (search) {
            where.reason = { contains: search as string };
        }

        const [leaveRequests, total] = await Promise.all([
            prisma.leaveRequest.findMany({
                where,
                skip,
                take: limitNumber,
                include: {
                    employee: {
                        include: {
                            user: { select: { name: true, email: true } }
                        }
                    },
                    omApprover: { select: { name: true, email: true, signature: true } },
                    gmApprover: { select: { name: true, email: true, signature: true } },
                },
                orderBy: { createdAt: 'desc' },
            }),
            prisma.leaveRequest.count({ where })
        ]);

        const totalPages = Math.ceil(total / limitNumber);

        res.status(200).json({
            status: 'success',
            results: leaveRequests.length,
            total,
            page: pageNumber,
            limit: limitNumber,
            totalPages,
            data: { leaveRequests },
        });
    } catch (error) {
        next(error);
    }
};

// Get all leave requests for the same department as the requesting user
export const getDepartmentLeaves = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const userId = (req as AuthRequest).user!.id;
        const { page = '1', limit = '10', status, search, type, startDate, endDate, employeeId } = req.query;

        // Parse and validate pagination parameters
        const pageNumber = Math.max(1, Number.parseInt(page as string, 10));
        const limitNumber = Math.min(100, Math.max(1, Number.parseInt(limit as string, 10)));
        const skip = (pageNumber - 1) * limitNumber;

        const employee = await prisma.employee.findUnique({ where: { userId } });
        if (!employee) throw new AppError('Employee profile not found', 404);

        const where: Prisma.LeaveRequestWhereInput = {
            employee: {
                department: employee.department,
                user: {
                    isActive: true,
                    name: search ? { contains: search as string } : undefined
                },
                id: employeeId && employeeId !== 'all' ? employeeId as string : undefined
            },
            status: status && status !== 'all' ? status as string : undefined,
            leaveType: type && type !== 'all' ? type as string : undefined,
            startDate: (startDate || endDate) ? {
                gte: startDate ? new Date(startDate as string) : undefined,
                lte: endDate ? new Date(endDate as string) : undefined
            } : undefined
        };

        const [leaveRequests, total] = await Promise.all([
            prisma.leaveRequest.findMany({
                where,
                skip,
                take: limitNumber,
                include: {
                    employee: {
                        include: {
                            user: { select: { name: true, email: true } }
                        }
                    },
                    omApprover: { select: { name: true, email: true, signature: true } },
                    gmApprover: { select: { name: true, email: true, signature: true } },
                },
                orderBy: { createdAt: 'desc' },
            }),
            prisma.leaveRequest.count({ where })
        ]);

        const totalPages = Math.ceil(total / limitNumber);

        res.status(200).json({
            status: 'success',
            results: leaveRequests.length,
            total,
            page: pageNumber,
            limit: limitNumber,
            totalPages,
            data: { leaveRequests },
        });
    } catch (error) {
        next(error);
    }
};

export const getAllLeaveRequests = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { status, page = '1', limit = '20', search, type, startDate, endDate, employeeId } = req.query;

        // Parse and validate pagination parameters
        const pageNumber = Math.max(1, Number.parseInt(page as string, 10));
        const limitNumber = Math.min(100, Math.max(1, Number.parseInt(limit as string, 10))); // Max 100 items per page
        const skip = (pageNumber - 1) * limitNumber;

        const where: Prisma.LeaveRequestWhereInput = {
            employee: {
                user: {
                    isActive: true,
                    name: search ? { contains: search as string } : undefined
                },
                id: employeeId && employeeId !== 'all' ? employeeId as string : undefined
            },
            status: status ? (status as string).includes(',') ? { in: (status as string).split(',') } : status as string : undefined,
            leaveType: type && type !== 'all' ? type as string : undefined,
            startDate: (startDate || endDate) ? {
                gte: startDate ? new Date(startDate as string) : undefined,
                lte: endDate ? new Date(endDate as string) : undefined
            } : undefined
        };

        // Execute count and fetch in parallel for better performance
        const [leaveRequests, total] = await Promise.all([
            prisma.leaveRequest.findMany({
                where,
                skip,
                take: limitNumber,
                include: {
                    employee: {
                        include: {
                            user: {
                                select: { name: true, email: true },
                            },
                        },
                    },
                    omApprover: { select: { name: true, email: true, signature: true } },
                    gmApprover: { select: { name: true, email: true, signature: true } },
                },
                orderBy: { createdAt: 'desc' },
            }),
            prisma.leaveRequest.count({ where })
        ]);

        const totalPages = Math.ceil(total / limitNumber);

        res.status(200).json({
            status: 'success',
            results: leaveRequests.length,
            total,
            page: pageNumber,
            limit: limitNumber,
            totalPages,
            hasNextPage: pageNumber < totalPages,
            hasPrevPage: pageNumber > 1,
            data: { leaveRequests },
        });
    } catch (error) {
        next(error);
    }
};

export const getLeaveRequestById = async (req: Request, res: Response, next: NextFunction) => {
    try {
        const { id } = req.params;
        const leaveRequest = await prisma.leaveRequest.findUnique({
            where: { id },
            include: {
                employee: {
                    include: {
                        user: {
                            select: { name: true, email: true },
                        },
                    },
                },
                omApprover: { select: { name: true, email: true, role: true, signature: true } },
                gmApprover: { select: { name: true, email: true, role: true, signature: true } },
            },
        });

        if (!leaveRequest) {
            throw new AppError('Leave request not found', 404);
        }

        res.status(200).json({
            status: 'success',
            data: { leaveRequest },
        });
    } catch (error) {
        next(error);
    }
};

```

- Previously: `if (userRole === 'ADMINISTRATOR') { initialStatus = 'APPROVED'; ... }`
- Now: Administrators fall through to `initialStatus = 'PENDING_OM'` like regular employees
- The immediate balance deduction on creation no longer fires (balance is deducted at final admin approval instead)

**2. Added self-approval guard (line ~1228)**

- New check in `adminApproveLeaveRequest`: if the employee who submitted the request is the same user trying to approve it, the request is rejected with HTTP 403
- Error message: *"You cannot approve your own leave request. The other Administrator must approve it."*

